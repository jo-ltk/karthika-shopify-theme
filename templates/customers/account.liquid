<div class="karthika-account-page">
  <header class="karthika-account-page__header">
    <a class="karthika-account-page__back" href="{{ routes.root_url }}" aria-label="Back to home">&larr;</a>
    <div><p>My account</p><h1>Karthika Account</h1></div>
  </header>

  <section class="karthika-profile-card" aria-labelledby="KarthikaProfileTitle">
    <span class="karthika-profile-card__avatar" aria-hidden="true">{{ customer.first_name | default: customer.email | slice: 0 }}</span>
    <div class="karthika-profile-card__details">
      <h2 id="KarthikaProfileTitle">{{ customer.name | default: customer.email }}</h2>
      <p>{{ customer.email }}</p>
      {% if customer.phone != blank %}<p>{{ customer.phone }}</p>{% endif %}
    </div>
    <span class="karthika-profile-card__edit" aria-disabled="true" title="Profile editing is not available in this Shopify storefront">Edit profile</span>
  </section>

  <section class="karthika-account-section" aria-labelledby="KarthikaOrdersTitle">
    <div class="karthika-account-section__heading"><h2 id="KarthikaOrdersTitle">My Orders</h2>{% if customer.orders_count > 0 %}<a href="#KarthikaOrderList">View all</a>{% endif %}</div>
    {% paginate customer.orders by 5 %}
      <div id="KarthikaOrderList" class="karthika-order-list">
        {% for order in customer.orders %}
          <article class="karthika-order-card">
            <div><strong>{{ order.name }}</strong><span>{{ order.created_at | date: '%d %b %Y' }}</span></div>
            <div>
              <span>{{ order.total_price | money }}</span>
              <span class="karthika-order-card__status">{{ order.fulfillment_status_label | default: order.financial_status }}</span>
              {%- for attribute in order.note_attributes -%}
                {%- if attribute.first == 'Delivery type' and attribute.last == 'Gift' -%}
                  <span class="karthika-order-card__status">{{ 'customer.order.delivery_gift' | t }}</span>
                {%- endif -%}
              {%- endfor -%}
            </div>
            <a href="{{ order.customer_url }}">View order <span aria-hidden="true">&rarr;</span></a>
          </article>
        {% else %}
          <p class="karthika-empty-state">Your completed orders will appear here.</p>
        {% endfor %}
      </div>
      {% if paginate.pages > 1 %}<div class="karthika-account-pagination">{{ paginate | default_pagination }}</div>{% endif %}
    {% endpaginate %}
  </section>

  <section class="karthika-account-section" aria-labelledby="KarthikaAccountToolsTitle">
    <div class="karthika-account-section__heading"><h2 id="KarthikaAccountToolsTitle">Account</h2></div>
    <div class="karthika-account-menu">
      <a href="{{ routes.account_addresses_url }}" class="karthika-account-menu__row"><span class="karthika-account-menu__icon"><img src="{{ 'icon-map-pin.svg' | asset_url }}" alt="" width="17" height="17"></span><span><strong>Saved Addresses</strong><small>Manage delivery addresses</small></span><b aria-hidden="true">&rsaquo;</b></a>
      <a href="{{ routes.all_products_collection_url }}" class="karthika-account-menu__row"><span class="karthika-account-menu__icon"><img src="{{ 'icon-price-tag.svg' | asset_url }}" alt="" width="17" height="17"></span><span><strong>Offers &amp; Coupons</strong><small>Browse current store offers</small></span><b aria-hidden="true">&rsaquo;</b></a>
      <a href="/pages/contact" class="karthika-account-menu__row"><span class="karthika-account-menu__icon"><img src="{{ 'icon-chat-bubble.svg' | asset_url }}" alt="" width="17" height="17"></span><span><strong>Help &amp; Support</strong><small>Contact the Karthika team</small></span><b aria-hidden="true">&rsaquo;</b></a>
      <a href="/policies/privacy-policy" class="karthika-account-menu__row"><span class="karthika-account-menu__icon"><img src="{{ 'icon-lock.svg' | asset_url }}" alt="" width="17" height="17"></span><span><strong>Privacy &amp; Security</strong><small>Read our privacy policy</small></span><b aria-hidden="true">&rsaquo;</b></a>
      <div class="karthika-account-menu__row is-unavailable" aria-disabled="true"><span class="karthika-account-menu__icon"><img src="{{ 'icon-heart.svg' | asset_url }}" alt="" width="17" height="17"></span><span><strong>Wishlist</strong><small>Not available yet</small></span></div>
      <div class="karthika-account-menu__row is-unavailable" aria-disabled="true"><span class="karthika-account-menu__icon"><img src="{{ 'icon-cart.svg' | asset_url }}" alt="" width="17" height="17"></span><span><strong>Payment Methods</strong><small>Managed securely at checkout</small></span></div>
      <div class="karthika-account-menu__row is-unavailable" aria-disabled="true"><span class="karthika-account-menu__icon"><img src="{{ 'icon-star.svg' | asset_url }}" alt="" width="17" height="17"></span><span><strong>Karthika Rewards</strong><small>Not available yet</small></span></div>
      <a href="{{ routes.account_logout_url }}" class="karthika-account-menu__row karthika-account-menu__row--logout"><span class="karthika-account-menu__icon"><img src="{{ 'icon-return.svg' | asset_url }}" alt="" width="17" height="17"></span><span><strong>Logout</strong><small>Sign out of this device</small></span><b aria-hidden="true">&rsaquo;</b></a>
    </div>
  </section>
</div>
