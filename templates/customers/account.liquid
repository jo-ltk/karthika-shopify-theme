{%- unless customer -%}
  <div class="karthika-auth-page">
    <section class="karthika-auth-panel" aria-labelledby="KarthikaAccountGuestTitle">
      <h1 id="KarthikaAccountGuestTitle">{{ 'customer.account.title' | t }}</h1>
      <p>Sign in to view orders and addresses.</p>
      <a class="karthika-primary-button" href="{% render 'karthika-login-home', destination: 'account' %}">{{ 'customer.log_in' | t }}</a>
    </section>
  </div>
{%- else -%}

{%- liquid
  assign has_orders = false
  if customer.orders_count > 0
    assign has_orders = true
  endif

  assign avatar_initial = customer.first_name | default: customer.email | slice: 0
  assign display_name = customer.name | default: customer.email
  assign default_address = customer.default_address

  assign storefront_login = routes.storefront_login_url | default: ''
  assign new_customer_accounts = false
  if storefront_login contains 'customer_authentication'
    assign new_customer_accounts = true
  endif

  assign privacy_url = shop.privacy_policy.url | default: '/policies/privacy-policy'
  assign contact_url = pages.contact.url | default: '/pages/contact'

  assign offers_url = routes.all_products_collection_url
  if pages['offers'] != blank
    assign offers_url = pages['offers'].url
  elsif collections['offers'] != blank
    assign offers_url = collections['offers'].url
  endif
-%}

<div class="kap" data-kap>
  <header class="kap-header">
    <div class="kap-header__text">
      <h1 class="kap-header__title">{{ shop.name | escape }}</h1>
      <p class="kap-header__subtitle">{{ 'customer.account.title' | t }}</p>
    </div>
    <span class="kap-avatar kap-avatar--sm" aria-hidden="true">{{ avatar_initial | escape }}</span>
  </header>

    <div class="kap-tabs" role="tablist" aria-label="{{ 'customer.account.title' | t }}">
      <button
        type="button"
        class="kap-tab"
        role="tab"
        id="kap-tab-orders"
        data-kap-tab="orders"
        aria-controls="kap-panel-orders"
        aria-selected="false"
        tabindex="-1"
      >
        {{ 'karthika.account.orders' | t }}
      </button>
      <button
        type="button"
        class="kap-tab is-active"
        role="tab"
        id="kap-tab-profile"
        data-kap-tab="profile"
        aria-controls="kap-panel-profile"
        aria-selected="true"
        tabindex="0"
      >
        {{ 'karthika.account.profile' | t }}
      </button>
    </div>

  <div class="kap-panel" id="kap-panel-profile" role="tabpanel" aria-labelledby="kap-tab-profile" data-kap-panel="profile">
    <section class="kap-card kap-profile" aria-labelledby="kap-profile-name">
      <span class="kap-avatar" aria-hidden="true">{{ avatar_initial | escape }}</span>
      <div class="kap-profile__details">
        <h2 class="kap-profile__name" id="kap-profile-name">{{ display_name | escape }}</h2>
        {%- if customer.email != blank -%}<p>{{ customer.email | escape }}</p>{%- endif -%}
        {%- if customer.phone != blank -%}
          <p>{{ customer.phone | escape }}</p>
        {%- elsif default_address.phone != blank -%}
          <p>{{ default_address.phone | escape }}</p>
        {%- endif -%}
        {%- if new_customer_accounts -%}
          <p class="kap-profile__note">Profile details are managed in your Shopify account.</p>
        {%- endif -%}
      </div>
      {%- unless new_customer_accounts -%}
        <a class="kap-btn kap-btn--soft kap-profile__edit" href="{{ routes.account_addresses_url }}">
          {%- render 'karthika-account-icon', icon: 'pencil' -%}
          <span>{{ 'customer.account.view_addresses' | t }}</span>
        </a>
      {%- endunless -%}
    </section>

    <section class="kap-section" aria-labelledby="kap-recent-orders-title">
      <div class="kap-section__head">
        <h2 class="kap-section__title" id="kap-recent-orders-title">{{ 'customer.orders.title' | t }}</h2>
        {%- if has_orders -%}
          <button type="button" class="kap-section__link" data-kap-tab="orders">
            View all orders <span aria-hidden="true">&rsaquo;</span>
          </button>
        {%- endif -%}
      </div>
      {%- if has_orders -%}
        <div class="kap-order-list">
          {%- for order in customer.orders limit: 2 -%}
            {%- render 'karthika-account-order-card', order: order -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="kap-empty" role="status">
          <p>{{ 'customer.orders.none' | t }}</p>
          <p>{{ 'karthika.account.empty_orders_hint' | t }}</p>
          <a class="kap-btn kap-btn--primary" href="{{ routes.all_products_collection_url }}">{{ 'karthika.account.shop_now' | t }}</a>
        </div>
      {%- endif -%}
    </section>

    <section class="kap-section" aria-labelledby="kap-quick-actions-title">
      <div class="kap-section__head">
        <h2 class="kap-section__title" id="kap-quick-actions-title">Quick Actions</h2>
      </div>
      <div class="kap-actions">
        <button type="button" class="kap-action" data-kap-tab="orders">
          {%- render 'karthika-account-icon', icon: 'bag' -%}
          <span>{{ 'karthika.account.orders' | t }}</span>
        </button>

        <a class="kap-action" href="{{ routes.account_addresses_url }}">
          {%- render 'karthika-account-icon', icon: 'pin' -%}
          <span>{{ 'customer.addresses.title' | t }}</span>
        </a>

        <a class="kap-action" href="{% if pages.wishlist.url != blank %}{{ pages.wishlist.url }}{% else %}{{ routes.root_url }}pages/wishlist{% endif %}">
          {%- render 'karthika-account-icon', icon: 'heart' -%}
          <span>{{ 'general.wishlist.title' | t }}</span>
        </a>

        <button type="button" class="kap-action" data-kap-sheet-open="kap-sheet-settings">
          {%- render 'karthika-account-icon', icon: 'gear' -%}
          <span>Account<br>Settings</span>
        </button>
      </div>
    </section>

    {%- if default_address != blank -%}
      <section class="kap-card kap-address" aria-labelledby="kap-address-title">
        <span class="kap-address__icon" aria-hidden="true">
          {%- render 'karthika-account-icon', icon: 'home' -%}
        </span>
        <div class="kap-address__details">
          <h2 class="kap-address__title" id="kap-address-title">{{ 'customer.addresses.default' | t }}</h2>
          {{ default_address | format_address }}
        </div>
        <a class="kap-btn kap-btn--outline kap-address__manage" href="{{ routes.account_addresses_url }}">{{ 'customer.addresses.edit' | t }}</a>
      </section>
    {%- else -%}
      <section class="kap-card kap-address" aria-labelledby="kap-address-title">
        <span class="kap-address__icon" aria-hidden="true">
          {%- render 'karthika-account-icon', icon: 'home' -%}
        </span>
        <div class="kap-address__details">
          <h2 class="kap-address__title" id="kap-address-title">{{ 'customer.addresses.title' | t }}</h2>
          <p>{{ 'customer.addresses.add_new' | t }}</p>
        </div>
        <a class="kap-btn kap-btn--outline kap-address__manage" href="{{ routes.account_addresses_url }}">{{ 'customer.addresses.add' | t }}</a>
      </section>
    {%- endif -%}

    <a class="kap-card kap-privacy" href="{{ privacy_url }}">
      <span class="kap-privacy__icon" aria-hidden="true">
        {%- render 'karthika-account-icon', icon: 'shield' -%}
      </span>
      <span class="kap-privacy__text">
        <strong>Your privacy is important to us</strong>
        <small>We'll never share your details with anyone.</small>
      </span>
      <span class="kap-privacy__chevron" aria-hidden="true">
        {%- render 'karthika-account-icon', icon: 'chevron' -%}
      </span>
    </a>

    <p class="kap-footer-link">
      <a href="{{ routes.account_logout_url }}">{{ 'customer.log_out' | t }}</a>
    </p>
    <p class="kap-footer-link"><a href="{{ privacy_url }}">Privacy policy</a></p>
  </div>

  <div
    class="kap-panel"
    id="kap-panel-orders"
    role="tabpanel"
    aria-labelledby="kap-tab-orders"
    data-kap-panel="orders"
    hidden
  >
    <section class="kap-section" aria-labelledby="kap-all-orders-title">
      <div class="kap-section__head">
        <h2 class="kap-section__title" id="kap-all-orders-title">{{ 'customer.orders.title' | t }}</h2>
        <span class="kap-section__count">{{ customer.orders_count }}</span>
      </div>
      {%- if has_orders -%}
        {%- paginate customer.orders by 5 -%}
          <div class="kap-order-list">
            {%- for order in customer.orders -%}
              {%- render 'karthika-account-order-card', order: order -%}
            {%- endfor -%}
          </div>
          {%- if paginate.pages > 1 -%}
            <div class="kap-pagination">{{ paginate | default_pagination }}</div>
          {%- endif -%}
        {%- endpaginate -%}
      {%- else -%}
        <div class="kap-empty" role="status">
          <p>{{ 'customer.orders.none' | t }}</p>
          <p>{{ 'karthika.account.empty_orders_hint' | t }}</p>
          <a class="kap-btn kap-btn--primary" href="{{ routes.all_products_collection_url }}">{{ 'karthika.account.shop_now' | t }}</a>
        </div>
      {%- endif -%}
    </section>

    <p class="kap-footer-link">
      <a href="{{ routes.account_logout_url }}">{{ 'customer.log_out' | t }}</a>
    </p>
    <p class="kap-footer-link"><a href="{{ privacy_url }}">Privacy policy</a></p>
  </div>
</div>

<div class="kap-sheet" id="kap-sheet-settings" data-kap-sheet hidden>
  <div class="kap-sheet__backdrop" data-kap-sheet-close></div>
  <div class="kap-sheet__panel" role="dialog" aria-modal="true" aria-labelledby="kap-sheet-settings-title">
    <div class="kap-sheet__head">
      <h2 id="kap-sheet-settings-title">Account Settings</h2>
      <button type="button" class="kap-sheet__close" data-kap-sheet-close aria-label="Close">&times;</button>
    </div>
    <div class="kap-sheet__body">
      <div class="kap-menu">
        <a href="{{ offers_url }}" class="kap-menu__row">
          <span class="kap-menu__icon">{%- render 'karthika-account-icon', icon: 'tag' -%}</span>
          <span><strong>Offers</strong><small>Browse current store offers</small></span>
          <b aria-hidden="true">&rsaquo;</b>
        </a>
        <a href="{{ contact_url }}" class="kap-menu__row">
          <span class="kap-menu__icon">{%- render 'karthika-account-icon', icon: 'chat' -%}</span>
          <span><strong>Help &amp; Support</strong><small>Contact the store</small></span>
          <b aria-hidden="true">&rsaquo;</b>
        </a>
        <a href="{{ privacy_url }}" class="kap-menu__row">
          <span class="kap-menu__icon">{%- render 'karthika-account-icon', icon: 'lock' -%}</span>
          <span><strong>Privacy &amp; Security</strong><small>Read our privacy policy</small></span>
          <b aria-hidden="true">&rsaquo;</b>
        </a>
        <div class="kap-menu__row is-unavailable" aria-disabled="true">
          <span class="kap-menu__icon">{%- render 'karthika-account-icon', icon: 'card' -%}</span>
          <span><strong>Payment Methods</strong><small>Managed securely at checkout</small></span>
        </div>
        <div class="kap-menu__row is-unavailable" aria-disabled="true">
          <span class="kap-menu__icon">{%- render 'karthika-account-icon', icon: 'star' -%}</span>
          <span><strong>Karthika Rewards</strong><small>Not available yet</small></span>
        </div>
        <a href="{{ routes.account_logout_url }}" class="kap-menu__row kap-menu__row--logout">
          <span class="kap-menu__icon">{%- render 'karthika-account-icon', icon: 'logout' -%}</span>
          <span><strong>{{ 'customer.log_out' | t }}</strong><small>Sign out of this device</small></span>
          <b aria-hidden="true">&rsaquo;</b>
        </a>
      </div>
    </div>
  </div>
</div>
{%- endunless -%}
