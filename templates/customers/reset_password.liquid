<div class="karthika-auth-page">
  <div class="karthika-auth-hero karthika-auth-hero--compact">
    <a class="karthika-auth-back" href="{{ routes.account_login_url }}" aria-label="{{ 'customer.login_page.title' | t }}">&larr;</a>
    <div class="karthika-auth-brand">{% render 'karthika-logo', class: 'karthika-logo--auth', loading: 'eager' %}</div>
  </div>
  <section class="karthika-auth-panel" aria-labelledby="KarthikaResetTitle">
    <h1 id="KarthikaResetTitle">{{ 'customer.reset_password.title' | t }}</h1>
    <p>{{ 'customer.reset_password.subtext' | t }}{% if email != blank %} {{ email | escape }}{% endif %}</p>
    {% form 'reset_customer_password', class: 'karthika-auth-form' %}
      {% if form.errors %}
        <div id="ResetErrors" class="karthika-form-message" role="alert">{{ form.errors | default_errors }}</div>
      {% endif %}
      <label for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
      <input
        id="ResetPassword"
        type="password"
        name="customer[password]"
        autocomplete="new-password"
        required
        {% if form.errors %}aria-invalid="true" aria-describedby="ResetErrors"{% endif %}
      >
      <label for="ResetPasswordConfirmation">{{ 'customer.reset_password.password_confirm' | t }}</label>
      <input
        id="ResetPasswordConfirmation"
        type="password"
        name="customer[password_confirmation]"
        autocomplete="new-password"
        required
      >
      <button class="karthika-primary-button" type="submit">{{ 'customer.reset_password.submit' | t }}</button>
    {% endform %}
    <a class="karthika-auth-text-link" href="{{ routes.account_login_url }}">{{ 'customer.login_page.title' | t }}</a>
  </section>
</div>
