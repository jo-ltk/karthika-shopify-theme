<div class="karthika-auth-page">
  <div class="karthika-auth-hero karthika-auth-hero--compact"><div class="karthika-auth-brand">{% render 'karthika-logo', class: 'karthika-logo--auth', loading: 'eager' %}</div></div>
  <section class="karthika-auth-panel" aria-labelledby="KarthikaResetTitle">
    <h1 id="KarthikaResetTitle">Reset password</h1>
    <p>Create a new password for {{ email }}.</p>
    {% form 'reset_customer_password', class: 'karthika-auth-form' %}
      {% if form.errors %}<div class="karthika-form-message" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
      <label for="ResetPassword">New password</label><input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required>
      <label for="ResetPasswordConfirmation">Confirm password</label><input id="ResetPasswordConfirmation" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
      <button class="karthika-primary-button" type="submit">Reset password</button>
    {% endform %}
  </section>
</div>
