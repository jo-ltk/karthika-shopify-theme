<div class="karthika-auth-page">
  <div class="karthika-auth-hero karthika-auth-hero--compact">
    <a class="karthika-auth-back" href="{{ routes.account_login_url }}" aria-label="{{ 'customer.login_page.title' | t }}">&larr;</a>
    <div class="karthika-auth-brand">{% render 'karthika-logo', class: 'karthika-logo--auth', loading: 'eager' %}</div>
  </div>
  <section class="karthika-auth-panel" aria-labelledby="KarthikaRegisterTitle">
    <h1 id="KarthikaRegisterTitle">{{ 'customer.register.title' | t }}</h1>
    {% form 'create_customer', class: 'karthika-auth-form' %}
      {% render 'karthika-login-home', mode: 'fields', destination: 'account' %}
      {% if form.errors %}
        <div id="RegisterErrors" class="karthika-form-message" role="alert" tabindex="-1">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}
      <label for="RegisterFirstName">{{ 'customer.register.first_name' | t }}</label>
      <input id="RegisterFirstName" type="text" name="customer[first_name]" autocomplete="given-name">
      <label for="RegisterLastName">{{ 'customer.register.last_name' | t }}</label>
      <input id="RegisterLastName" type="text" name="customer[last_name]" autocomplete="family-name">
      <label for="RegisterEmail">{{ 'customer.register.email' | t }}</label>
      <input
        id="RegisterEmail"
        type="email"
        name="customer[email]"
        autocomplete="email"
        required
        {% if form.errors contains 'email' %}aria-invalid="true" aria-describedby="RegisterErrors"{% endif %}
      >
      <label for="RegisterPassword">{{ 'customer.register.password' | t }}</label>
      <input
        id="RegisterPassword"
        type="password"
        name="customer[password]"
        autocomplete="new-password"
        required
        {% if form.errors contains 'password' %}aria-invalid="true" aria-describedby="RegisterErrors"{% endif %}
      >
      <button class="karthika-primary-button" type="submit">{{ 'customer.register.submit' | t }}</button>
    {% endform %}
    <a class="karthika-auth-text-link" href="{{ routes.account_login_url }}">{{ 'customer.login_page.title' | t }}</a>
  </section>
</div>
