{%- if customer -%}
  <script>
    window.location.replace({{ routes.account_url | json }});
  </script>
{%- endif -%}

<div class="karthika-auth-page">
  <div class="karthika-auth-hero">
    <a class="karthika-auth-back" href="{{ routes.root_url }}" aria-label="Back to home">&larr;</a>
    <div class="karthika-auth-decor" aria-hidden="true"><span>Tomato</span><span>Lemon</span><span>Apple</span></div>
    <div class="karthika-auth-brand">
      {% render 'karthika-logo', class: 'karthika-logo--auth', loading: 'eager' %}
    </div>
  </div>

  <section class="karthika-auth-panel" aria-labelledby="KarthikaLoginTitle">
    <h1 id="KarthikaLoginTitle">{{ 'customer.login_page.title' | t }}</h1>
    <p>Log in to view your orders and saved addresses.</p>

    {% form 'customer_login', class: 'karthika-auth-form' %}
      {% render 'karthika-login-home', mode: 'fields', destination: 'account' %}
      {% if form.errors %}
        <div id="LoginErrors" class="karthika-form-message" role="alert" tabindex="-1">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}
      <label for="CustomerEmail">{{ 'customer.login_page.email' | t }}</label>
      <input
        id="CustomerEmail"
        type="email"
        name="customer[email]"
        autocomplete="email"
        required
        {% if form.errors %}aria-invalid="true" aria-describedby="LoginErrors"{% endif %}
      >
      <label for="CustomerPassword">{{ 'customer.login_page.password' | t }}</label>
      <input
        id="CustomerPassword"
        type="password"
        name="customer[password]"
        autocomplete="current-password"
        required
        {% if form.errors %}aria-invalid="true" aria-describedby="LoginErrors"{% endif %}
      >
      <button class="karthika-primary-button" type="submit">{{ 'customer.login_page.sign_in' | t }}</button>
    {% endform %}

    {% if shop.customer_accounts_enabled %}
      <a class="karthika-auth-text-link" href="{{ routes.account_register_url }}">{{ 'customer.login_page.create_account' | t }}</a>
    {% endif %}

    <button
      class="karthika-auth-text-link karthika-recovery-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="KarthikaRecovery"
    >
      {{ 'customer.login_page.forgot_password' | t }}
    </button>

    {% form 'recover_customer_password', class: 'karthika-auth-form' %}
      {% if form.posted_successfully? or form.errors %}
        {% assign recover_feedback = true %}
      {% else %}
        {% assign recover_feedback = false %}
      {% endif %}
      <div id="KarthikaRecovery" class="karthika-recovery"{% unless recover_feedback %} hidden{% endunless %}>
        {% if form.posted_successfully? %}
          <p class="karthika-form-success" role="status">{{ 'customer.recover_password.success' | t }}</p>
        {% endif %}
        {% if form.errors %}
          <div id="RecoverErrors" class="karthika-form-message" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}
        <p>{{ 'customer.recover_password.subtext' | t }}</p>
        <label for="RecoverEmail">{{ 'customer.login_page.email' | t }}</label>
        <input
          id="RecoverEmail"
          type="email"
          name="email"
          autocomplete="email"
          required
          {% if form.errors %}aria-invalid="true" aria-describedby="RecoverErrors"{% endif %}
        >
        <button class="karthika-secondary-button" type="submit">{{ 'customer.recover_password.title' | t }}</button>
      </div>
    {% endform %}

    <p class="karthika-auth-legal">By continuing, you accept the <a href="{{ shop.terms_of_service.url | default: '/policies/terms-of-service' }}">terms of service</a> and <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">privacy policy</a>.</p>
  </section>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var toggle = document.querySelector('.karthika-recovery-toggle');
    var panel = document.getElementById('KarthikaRecovery');
    var hash = (window.location.hash || '').replace('#', '');
    if (panel && (hash === 'recover' || hash === 'recovery' || !panel.hidden)) {
      panel.hidden = false;
      if (toggle) toggle.setAttribute('aria-expanded', 'true');
    }
    if (toggle && panel) {
      toggle.addEventListener('click', function () {
        var open = panel.hidden;
        panel.hidden = !open;
        toggle.setAttribute('aria-expanded', String(open));
        if (open) {
          var email = document.getElementById('RecoverEmail');
          if (email) email.focus();
        }
      });
    }
    var loginErrors = document.getElementById('LoginErrors');
    if (loginErrors) loginErrors.focus();
  });
</script>
