{%- comment -%}
  Karthika Supermarket - Grocery Product Grid Section
  Renders responsive 2-column mobile / 4-5 column desktop product grid.
{%- endcomment -%}

<div class="karthika-grid-section{% if section.settings.carousel %} karthika-product-section--carousel{% endif %}">
  <div class="karthika-section-head">
    <div class="karthika-section-head-title-wrap">
      <h2 class="karthika-section-head-title">{{ section.settings.title | default: 'Popular this week' }}</h2>
      {%- if section.settings.subtitle != blank -%}
        <span class="karthika-section-head-sub">{{ section.settings.subtitle }}</span>
      {%- endif -%}
    </div>
    
    {%- assign see_all_link = section.settings.collection.url | default: routes.all_products_collection_url -%}
    <a href="{{ see_all_link }}" class="karthika-section-head-link">
      {{ section.settings.link_text | default: 'See all' }}
    </a>
  </div>

  <div class="{% if section.settings.preset_type == 'popular' %}karthika-popular-mini-grid{% elsif section.settings.preset_type == 'deals' or section.settings.preset_type == 'kerala' or section.settings.preset_type == 'new_arrivals' %}karthika-deals-three-grid{% else %}karthika-two-col-grid{% endif %}">
    {%- assign products_to_show = section.settings.products_to_show | default: 4 -%}
    {%- if section.settings.collection != blank and section.settings.collection.products_count > 0 -%}
      {%- for product in section.settings.collection.products limit: products_to_show -%}
        {%- if section.settings.preset_type == 'popular' -%}
          {% render 'karthika-card-product-mini', card_product: product %}
        {%- else -%}
          {% render 'karthika-card-product', card_product: product, section_id: section.id %}
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      <div class="karthika-empty-state" role="status" aria-live="polite">
        <p>No products are available in this collection yet.</p>
        <a href="{{ routes.all_products_collection_url }}" class="karthika-section-head-link">Browse all products</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Karthika Product Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Popular this week"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link Text",
      "default": "See all"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "select",
      "id": "preset_type",
      "label": "Demo Category Type",
      "options": [
        { "value": "popular", "label": "Popular / Fresh Produce" },
        { "value": "kerala", "label": "Kerala Essentials" },
        { "value": "deals", "label": "Today's Deals" },
        { "value": "new_arrivals", "label": "New Arrivals" }
      ],
      "default": "popular"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 2,
      "default": 4,
      "label": "Products to Show"
    },
    {
      "type": "checkbox",
      "id": "carousel",
      "label": "Use horizontal carousel",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Karthika Product Grid"
    }
  ]
}
{% endschema %}
