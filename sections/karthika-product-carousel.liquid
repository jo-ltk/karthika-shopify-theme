{%- comment -%}
  Karthika product shelf. Products come from one merchant-selected collection.
{%- endcomment -%}

{%- comment -%}
  UI restore: if no collection is configured in the theme editor, fall back to the
  all-products collection so historical homepage shelves still render (matches
  pre-93a94c5 index.json which bound shelves to "all"). No offset slicing.
{%- endcomment -%}
{%- assign target_collection = section.settings.collection -%}
{%- if target_collection == blank -%}
  {%- assign target_collection = collections.all -%}
{%- endif -%}
{%- assign products_to_show = section.settings.products_to_show | default: 4 -%}

{%- if target_collection != blank -%}
  <div class="karthika-grid-section{% if section.settings.carousel %} karthika-product-section--carousel{% endif %}">
    <div class="karthika-section-head">
      <div class="karthika-section-head-title-wrap">
        <h2 class="karthika-section-head-title">{{ section.settings.title | default: target_collection.title }}</h2>
        {%- if section.settings.subtitle != blank -%}
          <span class="karthika-section-head-sub">{{ section.settings.subtitle }}</span>
        {%- endif -%}
      </div>

      {%- if target_collection.url != blank -%}
        <a href="{{ target_collection.url }}" class="karthika-section-head-link">
          {{ section.settings.link_text | default: 'See all' }}
        </a>
      {%- endif -%}
    </div>

    <div class="{% if section.settings.preset_type == 'popular' %}karthika-popular-mini-grid{% elsif section.settings.preset_type == 'deals' or section.settings.preset_type == 'kerala' or section.settings.preset_type == 'new_arrivals' %}karthika-deals-three-grid{% else %}karthika-two-col-grid{% endif %}">
      {%- if target_collection.products_count > 0 -%}
        {%- for product in target_collection.products limit: products_to_show -%}
          {%- if section.settings.preset_type == 'popular' -%}
            {% render 'karthika-card-product-mini', card_product: product %}
          {%- else -%}
            {% render 'karthika-card-product', card_product: product, section_id: section.id %}
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <div class="karthika-empty-state" role="status">
          <p>No products are available in this collection yet.</p>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="karthika-grid-section">
    <div class="karthika-empty-state" role="status">
      <p>Select a collection for this product shelf in the theme editor.</p>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Karthika Product Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Popular this week"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link Text",
      "default": "See all"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Required. This shelf is hidden on the storefront until a collection is selected. Do not reuse one collection across shelves unless they should show the same products."
    },
    {
      "type": "select",
      "id": "preset_type",
      "label": "Layout",
      "options": [
        { "value": "popular", "label": "Compact mini cards" },
        { "value": "kerala", "label": "Three-column cards" },
        { "value": "deals", "label": "Deal cards" },
        { "value": "new_arrivals", "label": "New arrival cards" }
      ],
      "default": "popular"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 2,
      "default": 4,
      "label": "Products to Show"
    },
    {
      "type": "checkbox",
      "id": "carousel",
      "label": "Use horizontal carousel",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Karthika Product Grid"
    }
  ]
}
{% endschema %}
