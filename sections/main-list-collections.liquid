  var productsEl    = document.getElementById('KCB2Products');
  var loadingEl     = document.getElementById('KCB2Loading');
  var emptyEl       = document.getElementById('KCB2Empty');
  var brandMenuEl   = document.getElementById('KCB2BrandMenu');
  var brandBtnEl    = document.getElementById('KCB2BrandBtn');
  var brandLabelEl  = document.getElementById('KCB2BrandLabel');
  var sortBtnEl     = document.getElementById('KCB2SortBtn');
  var sortLabelEl   = document.getElementById('KCB2SortLabel');
  var sortMenuEl    = document.getElementById('KCB2SortMenu');
  var typeBtnEl     = document.getElementById('KCB2TypeBtn');
  var typeLabelEl   = document.getElementById('KCB2TypeLabel');
  var typeMenuEl    = document.getElementById('KCB2TypeMenu');
  var packBtnEl     = document.getElementById('KCB2PackBtn');
  var packLabelEl   = document.getElementById('KCB2PackLabel');
  var packMenuEl    = document.getElementById('KCB2PackMenu');

  /* ── State ─────────────────────────────────────────────────────────────── */
  var state = {
    handle: 'dairy-eggs',
    products: [],
    filteredProducts: [],
    activeBrand: 'all',
    activeType: 'all',
    activePack: 'all',
    activeSort: 'default',
    loading: false
  };

  /* ── Fetch products with instant store data integration ── */
  var cachedAllProducts = null;

  var HANDLE_KEYWORDS = {
    'dairy-eggs':    ['dairy', 'milk', 'egg', 'paneer', 'butter', 'cheese', 'ghee', 'yogurt', 'bread', 'bun', 'curd'],
    'bread-buns':    ['bread', 'bun', 'bakery', 'sliced', 'sandwich', 'pav', 'toast'],
    'paneer-tofu':   ['paneer', 'tofu', 'curd', 'soya'],
    'cheese':        ['cheese', 'slice', 'mozzarella', 'cheddar', 'spread'],
    'eggs':          ['egg', 'poultry', 'tray', 'white egg', 'country egg'],
    'top-deals':     ['deal', 'offer', 'bestseller', 'special', 'prime', 'popular', 'discount'],
    'fresh-fruits':  ['fruit', 'mango', 'orange', 'grape', 'banana', 'apple', 'avocado', 'fresh fruits', 'berry', 'watermelon', 'papaya'],
    'vegetables':    ['vegetable', 'tomato', 'potato', 'onion', 'pepper', 'broccoli', 'fresh produce', 'carrot', 'beans', 'spinach', 'ginger', 'garlic'],
    'rice-grains':   ['rice', 'basmati', 'matta', 'grain', 'staples', 'millet', 'quinoa', 'poha', 'raw rice'],
    'spices-masala': ['spice', 'pepper', 'turmeric', 'masala', 'chilli', 'powder', 'coriander', 'cardamom', 'clove', 'cinnamon', 'garam masala'],
    'dals-pulses':   ['dal', 'pulse', 'toor', 'moong', 'chana', 'rajma', 'urad', 'lentil', 'gram'],
    'atta-flours':   ['atta', 'flour', 'wheat', 'besan', 'ragi', 'appam', 'puttu', 'maida', 'rice powder'],
    'indian-snacks': ['snack', 'mixture', 'chips', 'murukku', 'biscuit', 'namkeen', 'kerala', 'cookies', 'crackers'],
    'frozen-foods':  ['frozen', 'parotta', 'chapati', 'ready to eat', 'peas', 'nuggets', 'fries'],
    'beverages':     ['beverage', 'drink', 'coconut', 'tea', 'coffee', 'juice', 'water', 'soda', 'syrup', 'squash'],
    'household':     ['clean', 'household', 'tissue', 'wash', 'detergent', 'soap', 'dishwash', 'cleaner']
  };

  function fetchProducts(handle, cb) {
    if (cachedAllProducts) {
      filterByHandle(cachedAllProducts, handle, cb);
      return;
    }

    // Combine store products first, falling back to dummy products if store has no products
    var initialCatalog = UNIQUE_STORE_PRODUCTS.length > 0 ? UNIQUE_STORE_PRODUCTS : DUMMY_PRODUCTS;
    cachedAllProducts = initialCatalog;
    filterByHandle(cachedAllProducts, handle, cb);

    /* Fetch real products via Shopify /products.json in the background and update cache */
    try {
      fetch(ROOT + 'products.json?limit=250')
        .then(function(r) { return r.ok ? r.json() : Promise.reject(r.status); })
        .then(function(data) {
          var storeProds = data.products || [];
          if (storeProds.length > 0) {
            var combinedMap = {};
            var merged = [];
            storeProds.forEach(function(p) {
              if (p && p.id && !combinedMap[p.id]) {
                combinedMap[p.id] = true;
                merged.push(p);
              }
            });
            UNIQUE_STORE_PRODUCTS.forEach(function(p) {
              if (p && p.id && !combinedMap[p.id]) {
                combinedMap[p.id] = true;
                merged.push(p);
              }
            });
            cachedAllProducts = merged.length > 0 ? merged : DUMMY_PRODUCTS;
            filterByHandle(cachedAllProducts, state.handle, function(err, refreshed) {
              if (refreshed && refreshed.length > 0) {
                state.products = refreshed;
                buildDropdownMenus(refreshed);
                applyFilters();
              }
            });
          }
        })
        .catch(function() { /* keep existing cache */ });
    } catch(e) { /* fetch not available */ }
  }

  function filterByHandle(all, handle, cb) {
    var kwList = HANDLE_KEYWORDS[handle] || [handle.replace(/-/g, ' ')];
    var matched = all.filter(function(p) {
      var str = ((p.title || '') + ' ' + (p.product_type || '') + ' ' + ((p.tags || []).join(' ')) + ' ' + (p.handle || '') + ' ' + (p.collection_handle || '') + ' ' + (p.collection_title || '')).toLowerCase();
      return kwList.some(function(kw) { return str.indexOf(kw.toLowerCase()) !== -1; });
    });

    if (matched.length > 0) {
      cb(null, matched);
    } else if (all.length > 0) {
      // If no direct keyword match in this category, show catalog products so user has items to view & purchase
      cb(null, all.slice(0, 8));
    } else {
      cb(null, DUMMY_PRODUCTS.slice(0, 6));
    }
  }

  /* ── Price formatting helper ────────────────────────────────────────────── */
  function parsePrice(val) {
    if (!val) return 0;
    var num = parseFloat(String(val).replace(/[^0-9.]/g, ''));
    return isNaN(num) ? 0 : num;
  }

  function formatMoney(num) {
    var symbol = window.Shopify && window.Shopify.currency && window.Shopify.currency.symbol ? window.Shopify.currency.symbol : '₹';
    return symbol + Math.round(num);
  }

  /* ── Render product grid ────────────────────────────────────────────────── */
  function renderProducts(products) {
    if (!productsEl) return;

    /* Remove old cards */
    Array.from(productsEl.querySelectorAll('.kcb2-card')).forEach(function(el){ el.remove(); });

    if (!products || products.length === 0) {
      if (loadingEl) loadingEl.style.display = 'none';
      if (emptyEl)   emptyEl.style.display   = 'block';
      return;
    }

    if (loadingEl) loadingEl.style.display = 'none';
    if (emptyEl)   emptyEl.style.display   = 'none';

    var grid = document.createElement('div');
    grid.className = 'kcb2-grid';

    products.forEach(function(product) {
      var variant = product.variants && product.variants[0] ? product.variants[0] : {};
      var numPrice = parsePrice(variant.price);
      var numCompare = parsePrice(variant.compare_at_price);

      var priceFormatted = formatMoney(numPrice);
      var compareFormatted = numCompare > numPrice ? formatMoney(numCompare) : '';
      var savePercent = numCompare > numPrice ? Math.round((numCompare - numPrice) / numCompare * 100) : 0;

      var imgSrc = (product.images && product.images[0] && product.images[0].src)
        ? product.images[0].src
        : 'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=600&auto=format&fit=crop&q=80';

      var packLabel = variant.title && variant.title !== 'Default Title'
        ? variant.title
        : (variant.grams ? variant.grams + 'g' : (product.vendor || '500g'));

      var available = variant.available !== false;
      var productUrl = ROOT + 'products/' + (product.handle || 'product');

      var card = document.createElement('div');
      card.className = 'kcb2-card karthika-compact-card';
      card.innerHTML = [
        '<div class="karthika-compact-media">',
          savePercent ? '<div class="karthika-card-badge">' + savePercent + '% OFF</div>' : '',
          '<a href="' + productUrl + '" aria-label="' + escHtml(product.title) + '" tabindex="-1">',
            '<img src="' + imgSrc + '" alt="' + escHtml(product.title) + '" width="200" height="200" loading="lazy" class="karthika-compact-img" onerror="this.src=\'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=600&auto=format&fit=crop&q=80\'">',
          '</a>',
        '</div>',
        '<div class="karthika-compact-info">',
          '<div class="karthika-card-meta-row">',
            '<span class="karthika-compact-pack">' + escHtml(packLabel) + '</span>',
            '<span class="karthika-stock-badge"><span class="karthika-stock-dot"></span>' + (available ? 'In stock' : 'Sold out') + '</span>',
          '</div>',
          '<a href="' + productUrl + '" class="karthika-compact-title" title="' + escHtml(product.title) + '">' + escHtml(product.title) + '</a>',
          '<div class="karthika-price-container">',
            '<div class="karthika-price-main-row">',
              '<span class="karthika-price-current">' + priceFormatted + '</span>',
              compareFormatted ? '<span class="karthika-price-original">' + compareFormatted + '</span>' : '',
              savePercent ? '<span class="karthika-price-discount-tag">-' + savePercent + '%</span>' : '',
            '</div>',
          '</div>',
          available
            ? [
                '<div class="karthika-card-action-bar karthika-stepper" data-variant-id="' + (variant.id || '1') + '" data-product-available="true">',
                  '<button type="button" class="karthika-stepper-add-btn" aria-label="Add ' + escHtml(product.title) + ' to cart">',
                    '<span class="karthika-add-btn-icon">+</span>',
                    '<span class="karthika-add-btn-text">ADD</span>',
                  '</button>',
                  '<div class="karthika-compact-stepper">',
                    '<button type="button" class="karthika-stepper-act-btn karthika-stepper-btn--minus" aria-label="Decrease quantity"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.8"><line x1="5" y1="12" x2="19" y2="12"/></svg></button>',
                    '<span class="karthika-compact-stepper-val karthika-stepper-qty">1</span>',
                    '<button type="button" class="karthika-stepper-act-btn karthika-stepper-btn--plus" aria-label="Increase quantity"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.8"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></button>',
                  '</div>',
                '</div>'
              ].join('')
            : '<div class="karthika-sold-out-badge" aria-label="Sold out" role="status">SOLD OUT</div>',
        '</div>'
      ].join('');

      grid.appendChild(card);
    });

    productsEl.appendChild(grid);

    /* Re-sync steppers via Karthika global cart manager */
    if (window.Karthika && window.Karthika.Cart) {
      window.Karthika.Cart.syncAllSteppers();
    }
  }

  function escHtml(s) {
    return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  /* ── Apply active filters & sort ──────────────────────────────────────── */
  function applyFilters() {
    var products = state.products.slice();

    /* Brand filter */
    if (state.activeBrand && state.activeBrand !== 'all') {
      products = products.filter(function(p) {
        return (p.vendor || '').toLowerCase() === state.activeBrand.toLowerCase();
      });
    }

    /* Type filter */
    if (state.activeType && state.activeType !== 'all') {
      var tw = state.activeType.toLowerCase();
      products = products.filter(function(p) {
        return (p.product_type || '').toLowerCase().indexOf(tw) !== -1
          || (p.title || '').toLowerCase().indexOf(tw) !== -1
          || (p.tags || []).some(function(t){ return t.toLowerCase().indexOf(tw) !== -1; });
      });
    }

    /* Pack size filter */
    if (state.activePack && state.activePack !== 'all') {
      var pw = state.activePack.toLowerCase();
      products = products.filter(function(p) {
        var vTitle = (p.variants && p.variants[0] && p.variants[0].title ? p.variants[0].title : '').toLowerCase();
        return vTitle.indexOf(pw) !== -1 || (p.title || '').toLowerCase().indexOf(pw) !== -1;
      });
    }

    /* Sort */
    if (state.activeSort === 'price-asc') {
      products.sort(function(a,b){ return priceOf(a) - priceOf(b); });
    } else if (state.activeSort === 'price-desc') {
      products.sort(function(a,b){ return priceOf(b) - priceOf(a); });
    } else if (state.activeSort === 'title-asc') {
      products.sort(function(a,b){ return (a.title||'').localeCompare(b.title||''); });
    }

    state.filteredProducts = products;
    renderProducts(products);
    countEl && (countEl.textContent = products.length + ' product' + (products.length !== 1 ? 's' : ''));
  }

  function priceOf(p) {
    return p.variants && p.variants[0] ? parsePrice(p.variants[0].price) : 0;
  }

  /* ── Build filter dropdown menus ─────────────────────────────────────── */
  function buildDropdownMenus(products) {
    // 1. Brands
    if (brandMenuEl) {
      var brands = [];
      products.forEach(function(p) {
        var v = (p.vendor || '').trim();
        if (v && brands.indexOf(v) === -1) brands.push(v);
      });
      brands.sort();
      populateMenu(brandMenuEl, brands, 'brand', 'All Brands');
    }

    // 2. Types / Subcategories
    if (typeMenuEl) {
      var types = [];
      products.forEach(function(p) {
        var pt = (p.product_type || '').trim();
        if (pt && types.indexOf(pt) === -1) types.push(pt);
      });
      types.sort();
      populateMenu(typeMenuEl, types, 'type', 'All Types');
    }

    // 3. Pack sizes
    if (packMenuEl) {
      var packs = [];
      products.forEach(function(p) {
        var pk = p.variants && p.variants[0] && p.variants[0].title && p.variants[0].title !== 'Default Title'
          ? p.variants[0].title
          : (p.variants && p.variants[0] && p.variants[0].grams ? p.variants[0].grams + 'g' : null);
        if (pk && packs.indexOf(pk) === -1) packs.push(pk);
      });
      packs.sort();
      populateMenu(packMenuEl, packs, 'pack', 'All Sizes');
    }
  }

  function populateMenu(menuEl, items, dataAttr, allLabel) {
    menuEl.innerHTML = '';
    var allItem = document.createElement('li');
    allItem.className = 'kcb2-dropdown-item is-selected';
    allItem.setAttribute('data-' + dataAttr, 'all');
    allItem.setAttribute('role', 'option');
    allItem.setAttribute('aria-selected', 'true');
    allItem.setAttribute('tabindex', '0');
    allItem.textContent = allLabel;
    menuEl.appendChild(allItem);

    items.forEach(function(item) {
      var li = document.createElement('li');
      li.className = 'kcb2-dropdown-item';
      li.setAttribute('data-' + dataAttr, item);
      li.setAttribute('role', 'option');
      li.setAttribute('aria-selected', 'false');
      li.setAttribute('tabindex', '0');
      li.textContent = item;
      menuEl.appendChild(li);
    });
  }

  /* ── Load a category ─────────────────────────────────────────────────── */
  function loadCategory(handle, label) {
    if (state.loading) return;
    state.handle      = handle;
    state.activeBrand = 'all';
    state.activeType  = 'all';
    state.activePack  = 'all';
    state.loading     = true;

    /* Update heading */
    titleEl && (titleEl.textContent = label);
    countEl && (countEl.textContent = '');

    /* Show skeleton */
    productsEl && Array.from(productsEl.querySelectorAll('.kcb2-grid')).forEach(function(g){ g.remove(); });
    if (loadingEl) loadingEl.style.display = 'flex';
    if (emptyEl)   emptyEl.style.display   = 'none';

    /* Reset labels */
    brandLabelEl && (brandLabelEl.textContent = 'Brand');
    typeLabelEl  && (typeLabelEl.textContent  = 'Type');
    packLabelEl  && (packLabelEl.textContent  = 'Pack Size');
    sortLabelEl  && (sortLabelEl.textContent  = 'Sort By');
    state.activeSort = 'default';

    /* Active sidebar */
    page.querySelectorAll('.kcb2-cat-item').forEach(function(btn) {
      var active = btn.dataset.handle === handle;
      btn.classList.toggle('is-active', active);
      btn.setAttribute('aria-pressed', active ? 'true' : 'false');
    });

    fetchProducts(handle, function(err, products) {
      state.loading  = false;
      state.products = products;
      buildDropdownMenus(products);
      applyFilters();
    });
  }

  /* ── Dropdown helpers ────────────────────────────────────────────────── */
  var _openBtn = null, _openMenu = null;

  function positionMenu(btnEl, menuEl) {
    var rect = btnEl.getBoundingClientRect();
    menuEl.style.top  = (rect.bottom + 6) + 'px';
    menuEl.style.left = rect.left + 'px';
  }

  function openDropdown(btnEl, menuEl) {
    _openBtn  = btnEl;
    _openMenu = menuEl;
    menuEl.hidden = false;
    positionMenu(btnEl, menuEl);
    btnEl.setAttribute('aria-expanded', 'true');
    btnEl.classList.add('is-open');
  }

  function closeDropdown(btnEl, menuEl) {
    if (!menuEl || !btnEl) return;
    menuEl.hidden = true;
    menuEl.style.top  = '';
    menuEl.style.left = '';
    btnEl.setAttribute('aria-expanded', 'false');
    btnEl.classList.remove('is-open');
    if (_openMenu === menuEl) { _openBtn = null; _openMenu = null; }
  }

  function closeAllDropdowns() {
    brandBtnEl && brandMenuEl && closeDropdown(brandBtnEl, brandMenuEl);
    sortBtnEl  && sortMenuEl  && closeDropdown(sortBtnEl,  sortMenuEl);
    typeBtnEl  && typeMenuEl  && closeDropdown(typeBtnEl,  typeMenuEl);
    packBtnEl  && packMenuEl  && closeDropdown(packBtnEl,  packMenuEl);
  }

  /* ── Event delegation ─────────────────────────────────────────────────── */
  page.addEventListener('click', function(e) {
    /* Sidebar category */
    var catBtn = e.target.closest('.kcb2-cat-item');
    if (catBtn) {
      var h = catBtn.dataset.handle;
      var l = catBtn.dataset.label;
      if (h) { loadCategory(h, l); catBtn.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); }
      closeAllDropdowns();
      return;
    }

    /* Brand dropdown toggle */
    if (e.target.closest('#KCB2BrandBtn')) {
      var wasOpen = brandMenuEl && !brandMenuEl.hidden;
      closeAllDropdowns();
      if (!wasOpen) openDropdown(brandBtnEl, brandMenuEl);
      return;
    }

    /* Brand selection */
    var brandItem = e.target.closest('#KCB2BrandMenu .kcb2-dropdown-item');
    if (brandItem) {
      state.activeBrand = brandItem.dataset.brand || 'all';
      brandMenuEl.querySelectorAll('.kcb2-dropdown-item').forEach(function(i) {
        var sel = i.dataset.brand === state.activeBrand;
        i.classList.toggle('is-selected', sel);
        i.setAttribute('aria-selected', sel ? 'true' : 'false');
      });
      brandLabelEl.textContent = state.activeBrand === 'all' ? 'Brand' : state.activeBrand;
      applyFilters();
      closeDropdown(brandBtnEl, brandMenuEl);
      return;
    }

    /* Type dropdown toggle */
    if (e.target.closest('#KCB2TypeBtn')) {
      var typeWasOpen = typeMenuEl && !typeMenuEl.hidden;
      closeAllDropdowns();
      if (!typeWasOpen) openDropdown(typeBtnEl, typeMenuEl);
      return;
    }

    /* Type selection */
    var typeItem = e.target.closest('#KCB2TypeMenu .kcb2-dropdown-item');
    if (typeItem) {
      state.activeType = typeItem.dataset.type || 'all';
      typeMenuEl.querySelectorAll('.kcb2-dropdown-item').forEach(function(i) {
        var sel = i.dataset.type === state.activeType;
        i.classList.toggle('is-selected', sel);
        i.setAttribute('aria-selected', sel ? 'true' : 'false');
      });
      typeLabelEl.textContent = state.activeType === 'all' ? 'Type' : state.activeType;
      applyFilters();
      closeDropdown(typeBtnEl, typeMenuEl);
      return;
    }

    /* Pack dropdown toggle */
    if (e.target.closest('#KCB2PackBtn')) {
      var packWasOpen = packMenuEl && !packMenuEl.hidden;
      closeAllDropdowns();
      if (!packWasOpen) openDropdown(packBtnEl, packMenuEl);
      return;
    }

    /* Pack selection */
    var packItem = e.target.closest('#KCB2PackMenu .kcb2-dropdown-item');
    if (packItem) {
      state.activePack = packItem.dataset.pack || 'all';
      packMenuEl.querySelectorAll('.kcb2-dropdown-item').forEach(function(i) {
        var sel = i.dataset.pack === state.activePack;
        i.classList.toggle('is-selected', sel);
        i.setAttribute('aria-selected', sel ? 'true' : 'false');
      });
      packLabelEl.textContent = state.activePack === 'all' ? 'Pack Size' : state.activePack;
      applyFilters();
      closeDropdown(packBtnEl, packMenuEl);
      return;
    }

    /* Sort dropdown toggle */
    if (e.target.closest('#KCB2SortBtn')) {
      var sortWasOpen = sortMenuEl && !sortMenuEl.hidden;
      closeAllDropdowns();
      if (!sortWasOpen) openDropdown(sortBtnEl, sortMenuEl);
      return;
    }

    /* Sort selection */
    var sortItem = e.target.closest('#KCB2SortMenu .kcb2-dropdown-item');
    if (sortItem) {
      state.activeSort = sortItem.dataset.sort || 'default';
      sortMenuEl.querySelectorAll('.kcb2-dropdown-item').forEach(function(i) {
        var sel = i.dataset.sort === state.activeSort;
        i.classList.toggle('is-selected', sel);
        i.setAttribute('aria-selected', sel ? 'true' : 'false');
      });
      sortLabelEl.textContent = sortItem.textContent;
      applyFilters();
      closeDropdown(sortBtnEl, sortMenuEl);
      return;
    }

    /* Close dropdowns when clicking outside (menus are position:fixed on body) */
    var clickedInsideDropdown = e.target.closest('.kcb2-dropdown');
    var clickedOnMenu = _openMenu && _openMenu.contains(e.target);
    if (!clickedInsideDropdown && !clickedOnMenu) {
      closeAllDropdowns();
    }
  });

  /* Reposition on scroll/resize */
  window.addEventListener('scroll', function() {
    if (_openBtn && _openMenu && !_openMenu.hidden) positionMenu(_openBtn, _openMenu);
  }, true);
  window.addEventListener('resize', function() {
    if (_openBtn && _openMenu && !_openMenu.hidden) positionMenu(_openBtn, _openMenu);
  });

  /* Close dropdowns on Escape */
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeAllDropdowns();
  });

  /* ── Initial load (optional deep-link ?cat=handle) ───────────────────── */
  var initialHandle = 'dairy-eggs';
  var initialLabel = 'Milk';
  var defaultBtn = page.querySelector('.kcb2-cat-item[data-handle="dairy-eggs"]');
  if (defaultBtn && defaultBtn.dataset.label) {
    initialLabel = defaultBtn.dataset.label;
  }

  try {
    var catParam = new URLSearchParams(window.location.search).get('cat');
    if (catParam) {
      var matchedBtn = null;
      page.querySelectorAll('.kcb2-cat-item').forEach(function (btn) {
        if (btn.dataset.handle === catParam) matchedBtn = btn;
      });
      if (matchedBtn) {
        initialHandle = matchedBtn.dataset.handle;
        initialLabel = matchedBtn.dataset.label || initialHandle;
      }
    }
  } catch (e) { /* URLSearchParams unavailable */ }

  loadCategory(initialHandle, initialLabel);

})();
</script>

{% schema %}
{
  "name": "Categories",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Page title",
      "default": "Categories"
    }
  ]
}
{% endschema %}
