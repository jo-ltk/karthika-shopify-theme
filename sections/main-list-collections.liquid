    : (window.routes && window.routes.root ? window.routes.root : '/');
  if (!ROOT.endsWith('/')) ROOT += '/';

  /* ── Liquid Store Products Data ── */
  var LIQUID_STORE_PRODUCTS = [
    {%- for collection in collections -%}
      {%- for product in collection.products -%}
        {
          id: {{ product.id | json }},
          title: {{ product.title | json }},
          handle: {{ product.handle | json }},
          vendor: {{ product.vendor | json }},
          product_type: {{ product.type | default: product.product_type | json }},
          tags: {{ product.tags | json }},
          collection_handle: {{ collection.handle | json }},
          collection_title: {{ collection.title | json }},
          variants: [
            {%- for variant in product.variants -%}
              {
                id: {{ variant.id | json }},
                title: {{ variant.title | json }},
                price: {{ variant.price | divided_by: 100.0 | json }},
                compare_at_price: {% if variant.compare_at_price %}{{ variant.compare_at_price | divided_by: 100.0 | json }}{% else %}null{% endif %},
                available: {{ variant.available | json }},
                grams: {{ variant.grams | json }}
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ],
          images: [
            {%- for image in product.images -%}
              { src: {{ image | image_url: width: 600 | json }} }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        },
      {%- endfor -%}
    {%- endfor -%}
    {%- if collections.all and collections.all.products.size > 0 -%}
      {%- for product in collections.all.products -%}
        {
          id: {{ product.id | json }},
          title: {{ product.title | json }},
          handle: {{ product.handle | json }},
