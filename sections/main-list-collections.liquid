{{ 'karthika-grocery.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Karthika /collections browser — live Shopify catalog only.
  Categories come from real collections (when present) or product types.
  Products load via collection.kcb2-json alternate template (paginated).
  Temporary placeholders: Lorem Flickr food/grocery images seeded by product type (snippet karthika-type-placeholder).

  KARTHIKA FEATURED CATEGORIES — first 16 items in the sidebar (added 2026-09):
  Images served from Shopify Files via file_url filter (karthika-cat-*.webp).
  Each item uses the same kcb2-cat-item + kcb2-cat-img-wrap structure as the
  existing store categories so the existing loadCategory() JS handles them
  with no changes required.

  Handle mapping (product type mode — catalog_mode='types'):
    Home            → MISCELLANEOUS      miscellaneous
    Baby & Child    → BABY CARE          baby-care
    Baking          → FLOUR              flour
    Beverages       → SOFT DRINKS        soft-drinks
    Personal Care   → BODYCARE           bodycare
    Confectioneries → CHOCOLATES & SWEETS chocolates-sweets
    Dairy           → GHEE               ghee
    Frozen          → ICE CREAM          ice-cream
    Fruit & Veg     → VEGETABLES         vegetables
    Rice            → BASMATI            basmati
    Groceries       → GRAINS/PULSES      grains-pulses
    Household       → DETERGENTS         detergents
    Kitchen         → TAWA/KADAI/PAN     tawa-kadai-pan
    Pharmacy        → AYURVEDA MEDICINE  ayurveda-medicine
    Pooja Items     → AGARBATHI          agarbathi
    Manufacturer    → BRASS              brass
{%- endcomment -%}

{%- comment -%}
  Pre-resolve the 16 Karthika category image URLs from Shopify Files.
  Files must be uploaded via Shopify Admin → Content → Files.
{%- endcomment -%}
{%- liquid
  assign kcat_img_home          = 'karthika-cat-home.webp'            | file_url
  assign kcat_img_baby          = 'karthika-cat-baby-child.webp'      | file_url
  assign kcat_img_baking        = 'karthika-cat-baking.webp'          | file_url
  assign kcat_img_beverages     = 'karthika-cat-beverages.webp'       | file_url
  assign kcat_img_personal_care = 'karthika-cat-personal-care.webp'   | file_url
  assign kcat_img_confect       = 'karthika-cat-confectioneries.webp' | file_url
  assign kcat_img_dairy         = 'karthika-cat-dairy.webp'           | file_url
  assign kcat_img_frozen        = 'karthika-cat-frozen.webp'          | file_url
  assign kcat_img_fruit_veg     = 'karthika-cat-fruit-vegetables.webp'| file_url
  assign kcat_img_rice          = 'karthika-cat-rice.webp'            | file_url
  assign kcat_img_groceries     = 'karthika-cat-groceries.webp'       | file_url
  assign kcat_img_household     = 'karthika-cat-household.webp'       | file_url
  assign kcat_img_kitchen       = 'karthika-cat-kitchen.webp'         | file_url
  assign kcat_img_pharmacy      = 'karthika-cat-pharmacy.webp'        | file_url
  assign kcat_img_pooja         = 'karthika-cat-pooja-items.webp'     | file_url
  assign kcat_img_mfr           = 'karthika-cat-manufacturer.webp'    | file_url
-%}

{%- liquid
  assign catalog_mode = 'types'
  assign custom_collection_count = 0

  for col in collections
    unless col.handle == 'all' or col.handle == 'frontpage'
      if col.all_products_count > 0
        assign custom_collection_count = custom_collection_count | plus: 1
      endif
    endunless
  endfor

  if custom_collection_count > 0
    assign catalog_mode = 'collections'
  endif

  assign money_format = shop.money_format
  assign initial_title = section.settings.title
-%}

<section
  class="kcb2"
  id="KCB2Page"
  data-section-id="{{ section.id }}"
  data-catalog-mode="{{ catalog_mode }}"
  data-root="{{ routes.root_url }}"
  data-money-format="{{ money_format | escape }}"
  data-search-url="{{ routes.search_url }}"
  data-all-url="{{ routes.all_products_collection_url }}"
  aria-label="Browse categories"
>
  <div class="kcb2-layout">
    <aside class="kcb2-sidebar" aria-label="Product categories">
      <nav class="kcb2-cat-list" id="KCB2CatList">
        {%- comment -%}
          ── KARTHIKA FEATURED CATEGORIES (first 16) ──────────────────────────
          These 16 items appear at the top of the sidebar, before the existing
          store product-type categories.  They use the identical kcb2-cat-item
          + kcb2-cat-img-wrap markup as the store categories so the existing
          loadCategory() JS, active-state sync, and ?cat= param all work
          without any JavaScript changes.
          Images are served from Shopify Files via file_url (karthika-cat-*.webp).
        {%- endcomment -%}

        {%- comment -%}Home → MISCELLANEOUS{%- endcomment -%}
        <button
          type="button"
          class="kcb2-cat-item"
          data-kind="type"
          data-handle="miscellaneous"
          data-type="MISCELLANEOUS"
          data-label="Home"
          aria-pressed="false"
        >
          <div class="kcb2-cat-img-wrap">
            <img src="{{ kcat_img_home }}" alt="" width="52" height="52" loading="eager">
          </div>
          <span class="kcb2-cat-label">Home</span>
        </button>

        {%- comment -%}Baby & Child → BABY CARE{%- endcomment -%}
        <button
          type="button"
          class="kcb2-cat-item"
          data-kind="type"
          data-handle="baby-care"
          data-type="BABY CARE"
          data-label="Baby &amp; Child"
          aria-pressed="false"
        >
          <div class="kcb2-cat-img-wrap">
            <img src="{{ kcat_img_baby }}" alt="" width="52" height="52" loading="eager">
          </div>
          <span class="kcb2-cat-label">Baby &amp; Child</span>
        </button>

        {%- comment -%}Baking → FLOUR{%- endcomment -%}
        <button
          type="button"
          class="kcb2-cat-item"
          data-kind="type"
          data-handle="flour"
          data-type="FLOUR"
          data-label="Baking"
          aria-pressed="false"
        >
          <div class="kcb2-cat-img-wrap">
            <img src="{{ kcat_img_baking }}" alt="" width="52" height="52" loading="lazy">
          </div>
          <span class="kcb2-cat-label">Baking</span>
        </button>

        {%- comment -%}Beverages → SOFT DRINKS{%- endcomment -%}
        <button
          type="button"
          class="kcb2-cat-item"
          data-kind="type"
          data-handle="soft-drinks"
          data-type="SOFT DRINKS"
          data-label="Beverages"
          aria-pressed="false"
        >
          <div class="kcb2-cat-img-wrap">
            <img src="{{ kcat_img_beverages }}" alt="" width="52" height="52" loading="lazy">
          </div>
          <span class="kcb2-cat-label">Beverages</span>
        </button>

        {%- comment -%}Personal Care → BODYCARE{%- endcomment -%}
        <button
          type="button"
          class="kcb2-cat-item"
          data-kind="type"
          data-handle="bodycare"
          data-type="BODYCARE"
          data-label="Personal Care"
          aria-pressed="false"
        >
          <div class="kcb2-cat-img-wrap">
            <img src="{{ kcat_img_personal_care }}" alt="" width="52" height="52" loading="lazy">
          </div>
          <span class="kcb2-cat-label">Personal Care</span>
        </button>

        {%- comment -%}Confectioneries → CHOCOLATES & SWEETS{%- endcomment -%}
        <button
          type="button"
          class="kcb2-cat-item"
          data-kind="type"
          data-handle="chocolates-sweets"
          data-type="CHOCOLATES &amp; SWEETS"
          data-label="Confectioneries"
          aria-pressed="false"
        >
          <div class="kcb2-cat-img-wrap">
            <img src="{{ kcat_img_confect }}" alt="" width="52" height="52" loading="lazy">
          </div>
          <span class="kcb2-cat-label">Confectioneries</span>
        </button>

        {%- comment -%}Dairy → GHEE{%- endcomment -%}
        <button
          type="button"
          class="kcb2-cat-item"
          data-kind="type"
          data-handle="ghee"
          data-type="GHEE"
          data-label="Dairy"
          aria-pressed="false"
        >
          <div class="kcb2-cat-img-wrap">
            <img src="{{ kcat_img_dairy }}" alt="" width="52" height="52" loading="lazy">
          </div>
          <span class="kcb2-cat-label">Dairy</span>
        </button>

        {%- comment -%}Frozen → ICE CREAM{%- endcomment -%}
        <button
          type="button"
          class="kcb2-cat-item"
          data-kind="type"
          data-handle="ice-cream"
          data-type="ICE CREAM"
          data-label="Frozen"
          aria-pressed="false"
        >
          <div class="kcb2-cat-img-wrap">
            <img src="{{ kcat_img_frozen }}" alt="" width="52" height="52" loading="lazy">
          </div>
          <span class="kcb2-cat-label">Frozen</span>
        </button>

        {%- comment -%}Fruit & Vegetables → VEGETABLES{%- endcomment -%}
        <button
          type="button"
          class="kcb2-cat-item"
          data-kind="type"
          data-handle="vegetables"
          data-type="VEGETABLES"
          data-label="Fruit &amp; Vegetables"
          aria-pressed="false"
        >
          <div class="kcb2-cat-img-wrap">
            <img src="{{ kcat_img_fruit_veg }}" alt="" width="52" height="52" loading="lazy">
          </div>
          <span class="kcb2-cat-label">Fruit &amp; Veg</span>
        </button>

        {%- comment -%}Rice → BASMATI{%- endcomment -%}
        <button
          type="button"
          class="kcb2-cat-item"
          data-kind="type"
          data-handle="basmati"
          data-type="BASMATI"
          data-label="Rice"
          aria-pressed="false"
        >
          <div class="kcb2-cat-img-wrap">
            <img src="{{ kcat_img_rice }}" alt="" width="52" height="52" loading="lazy">
          </div>
          <span class="kcb2-cat-label">Rice</span>
        </button>

        {%- comment -%}Groceries → GRAINS/PULSES{%- endcomment -%}
        <button
          type="button"
          class="kcb2-cat-item"
          data-kind="type"
          data-handle="grains-pulses"
          data-type="GRAINS/PULSES"
          data-label="Groceries"
          aria-pressed="false"
        >
          <div class="kcb2-cat-img-wrap">
            <img src="{{ kcat_img_groceries }}" alt="" width="52" height="52" loading="lazy">
          </div>
          <span class="kcb2-cat-label">Groceries</span>
        </button>

        {%- comment -%}Household → DETERGENTS{%- endcomment -%}
        <button
          type="button"
          class="kcb2-cat-item"
          data-kind="type"
          data-handle="detergents"
          data-type="DETERGENTS"
          data-label="Household"
          aria-pressed="false"
        >
          <div class="kcb2-cat-img-wrap">
            <img src="{{ kcat_img_household }}" alt="" width="52" height="52" loading="lazy">
          </div>
          <span class="kcb2-cat-label">Household</span>
        </button>

        {%- comment -%}Kitchen → TAWA/KADAI/PAN{%- endcomment -%}
        <button
          type="button"
          class="kcb2-cat-item"
          data-kind="type"
          data-handle="tawa-kadai-pan"
          data-type="TAWA/KADAI/PAN"
          data-label="Kitchen"
          aria-pressed="false"
        >
          <div class="kcb2-cat-img-wrap">
            <img src="{{ kcat_img_kitchen }}" alt="" width="52" height="52" loading="lazy">
          </div>
          <span class="kcb2-cat-label">Kitchen</span>
        </button>

        {%- comment -%}Pharmacy → AYURVEDA MEDICINE{%- endcomment -%}
        <button
          type="button"
          class="kcb2-cat-item"
          data-kind="type"
          data-handle="ayurveda-medicine"
          data-type="AYURVEDA MEDICINE"
          data-label="Pharmacy"
          aria-pressed="false"
        >
          <div class="kcb2-cat-img-wrap">
            <img src="{{ kcat_img_pharmacy }}" alt="" width="52" height="52" loading="lazy">
          </div>
          <span class="kcb2-cat-label">Pharmacy</span>
        </button>

        {%- comment -%}Pooja Items → AGARBATHI{%- endcomment -%}
        <button
          type="button"
          class="kcb2-cat-item"
          data-kind="type"
          data-handle="agarbathi"
          data-type="AGARBATHI"
          data-label="Pooja Items"
          aria-pressed="false"
        >
          <div class="kcb2-cat-img-wrap">
            <img src="{{ kcat_img_pooja }}" alt="" width="52" height="52" loading="lazy">
          </div>
          <span class="kcb2-cat-label">Pooja Items</span>
        </button>

        {%- comment -%}Manufacturer → BRASS{%- endcomment -%}
        <button
          type="button"
          class="kcb2-cat-item"
          data-kind="type"
          data-handle="brass"
          data-type="BRASS"
          data-label="Manufacturer"
          aria-pressed="false"
        >
          <div class="kcb2-cat-img-wrap">
            <img src="{{ kcat_img_mfr }}" alt="" width="52" height="52" loading="lazy">
          </div>
          <span class="kcb2-cat-label">Manufacturer</span>
        </button>

        {%- comment -%}── EXISTING STORE CATEGORIES (product types / collections) ─────────{%- endcomment -%}
        {%- if catalog_mode == 'collections' -%}
          {%- assign first_set = false -%}
          {%- for col in collections -%}
            {%- unless col.handle == 'all' or col.handle == 'frontpage' -%}
              {%- if col.all_products_count > 0 -%}
                {%- liquid
                  assign is_active = false
                  unless first_set
                    assign is_active = true
                    assign first_set = true
                    assign initial_title = col.title
                  endunless
                  if col.featured_image
                    assign cat_img = col.featured_image | image_url: width: 160
                  else
                    capture cat_img
                      render 'karthika-type-placeholder', product_type: col.title
                    endcapture
                    assign cat_img = cat_img | strip
                  endif
                -%}
                <button
                  type="button"
                  class="kcb2-cat-item{% if is_active %} is-active{% endif %}"
                  data-kind="collection"
                  data-handle="{{ col.handle | escape }}"
                  data-label="{{ col.title | escape }}"
                  data-count="{{ col.all_products_count }}"
                  aria-pressed="{% if is_active %}true{% else %}false{% endif %}"
                >
                  <div class="kcb2-cat-img-wrap">
                    <img src="{{ cat_img }}" alt="" width="52" height="52" loading="lazy">
                  </div>
                  <span class="kcb2-cat-label">{{ col.title | escape }}</span>
                </button>
              {%- endif -%}
            {%- endunless -%}
          {%- endfor -%}
        {%- else -%}
          {%- assign first_set = false -%}
          {%- for product_type in collections.all.all_types -%}
            {%- if product_type != blank -%}
              {%- liquid
                assign is_active = false
                unless first_set
                  assign is_active = true
                  assign first_set = true
                  assign initial_title = product_type
                endunless
                capture cat_img
                  render 'karthika-type-placeholder', product_type: product_type
                endcapture
                assign cat_img = cat_img | strip
              -%}
              <button
                type="button"
                class="kcb2-cat-item{% if is_active %} is-active{% endif %}"
                data-kind="type"
                data-handle="{{ product_type | handleize | escape }}"
                data-type="{{ product_type | escape }}"
                data-label="{{ product_type | escape }}"
                aria-pressed="{% if is_active %}true{% else %}false{% endif %}"
              >
                <div class="kcb2-cat-img-wrap">
                  <img src="{{ cat_img }}" alt="" width="52" height="52" loading="lazy">
                </div>
                <span class="kcb2-cat-label">{{ product_type | escape }}</span>
              </button>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </nav>
    </aside>

    <main class="kcb2-main" id="KCB2Main" aria-live="polite" aria-label="Products">
      <div class="kcb2-top-bar">
        <div class="kcb2-top-bar__left">
          {% render 'karthika-back-button' %}
          <h1 class="kcb2-page-title" id="KCB2Title">{{ initial_title | default: section.settings.title | escape }}</h1>
        </div>
        <a href="{{ routes.search_url }}" class="kcb2-search-btn karthika-search-bar-trigger" aria-label="Search">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </a>
      </div>

      <div class="kcb2-filter-strip" role="group" aria-label="Filter and Sort">
        <div class="kcb2-filter-scroll karthika-hide-scrollbar">
          <div class="kcb2-dropdown" id="KCB2SortDropdown">
            <button type="button" class="kcb2-pill-btn" id="KCB2SortBtn" aria-haspopup="listbox" aria-expanded="false">
              <span id="KCB2SortLabel">Sort By</span>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <ul class="kcb2-dropdown-menu" id="KCB2SortMenu" role="listbox" aria-label="Sort products" hidden>
              <li class="kcb2-dropdown-item is-selected" data-sort="manual" role="option" aria-selected="true" tabindex="0">Featured</li>
              <li class="kcb2-dropdown-item" data-sort="best-selling" role="option" aria-selected="false" tabindex="0">Best selling</li>
              <li class="kcb2-dropdown-item" data-sort="price-ascending" role="option" aria-selected="false" tabindex="0">Price: Low to High</li>
              <li class="kcb2-dropdown-item" data-sort="price-descending" role="option" aria-selected="false" tabindex="0">Price: High to Low</li>
              <li class="kcb2-dropdown-item" data-sort="title-ascending" role="option" aria-selected="false" tabindex="0">Name: A–Z</li>
              <li class="kcb2-dropdown-item" data-sort="title-descending" role="option" aria-selected="false" tabindex="0">Name: Z–A</li>
            </ul>
          </div>

          <div class="kcb2-dropdown" id="KCB2BrandDropdown">
            <button type="button" class="kcb2-pill-btn" id="KCB2BrandBtn" aria-haspopup="listbox" aria-expanded="false">
              <span id="KCB2BrandLabel">Brand</span>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <ul class="kcb2-dropdown-menu" id="KCB2BrandMenu" role="listbox" aria-label="Filter by brand" hidden></ul>
          </div>

          <div class="kcb2-dropdown" id="KCB2TypeDropdown">
            <button type="button" class="kcb2-pill-btn" id="KCB2TypeBtn" aria-haspopup="listbox" aria-expanded="false">
              <span id="KCB2TypeLabel">Type</span>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <ul class="kcb2-dropdown-menu" id="KCB2TypeMenu" role="listbox" aria-label="Filter by type" hidden></ul>
          </div>

          <div class="kcb2-dropdown" id="KCB2AvailDropdown">
            <button type="button" class="kcb2-pill-btn" id="KCB2AvailBtn" aria-haspopup="listbox" aria-expanded="false">
              <span id="KCB2AvailLabel">Availability</span>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <ul class="kcb2-dropdown-menu" id="KCB2AvailMenu" role="listbox" aria-label="Filter by availability" hidden>
              <li class="kcb2-dropdown-item is-selected" data-avail="all" role="option" aria-selected="true" tabindex="0">All</li>
              <li class="kcb2-dropdown-item" data-avail="in_stock" role="option" aria-selected="false" tabindex="0">In stock</li>
              <li class="kcb2-dropdown-item" data-avail="sold_out" role="option" aria-selected="false" tabindex="0">Sold out</li>
            </ul>
          </div>

          <div class="kcb2-dropdown" id="KCB2PriceDropdown">
            <button type="button" class="kcb2-pill-btn" id="KCB2PriceBtn" aria-haspopup="listbox" aria-expanded="false">
              <span id="KCB2PriceLabel">Price</span>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <ul class="kcb2-dropdown-menu" id="KCB2PriceMenu" role="listbox" aria-label="Filter by price" hidden></ul>
          </div>
        </div>
      </div>

      <p class="kcb2-count" id="KCB2Count" hidden></p>

      <div class="kcb2-products" id="KCB2Products">
        <div class="kcb2-loading" id="KCB2Loading" aria-label="Loading products" style="display:none">
          <span class="kcb2-spinner" aria-hidden="true"></span>
          <span>Loading products…</span>
        </div>
      </div>

      <div class="kcb2-load-more-wrap" id="KCB2LoadMoreWrap" hidden>
        <button type="button" class="kcb2-empty-btn" id="KCB2LoadMore">Load more</button>
      </div>

      <div class="kcb2-empty" id="KCB2Empty" style="display:none">
        <p class="kcb2-empty-icon" aria-hidden="true">🛒</p>
        <h2>No products found</h2>
        <p>Try selecting a different category or clearing the filter.</p>
        <a href="{{ routes.all_products_collection_url }}" class="kcb2-empty-btn">Browse all products</a>
      </div>
    </main>
  </div>
</section>

<script>
(function () {
  'use strict';

  var page = document.getElementById('KCB2Page');
  if (!page) return;

  var ROOT = page.dataset.root || '/';
  if (ROOT.slice(-1) !== '/') ROOT += '/';

  var moneyFormat = page.dataset.moneyFormat || {{ shop.money_format | json }};

  var titleEl = document.getElementById('KCB2Title');
  var countEl = document.getElementById('KCB2Count');
  var productsEl = document.getElementById('KCB2Products');
  var loadingEl = document.getElementById('KCB2Loading');
  var emptyEl = document.getElementById('KCB2Empty');
  var loadMoreWrap = document.getElementById('KCB2LoadMoreWrap');
  var loadMoreBtn = document.getElementById('KCB2LoadMore');

  var brandMenuEl = document.getElementById('KCB2BrandMenu');
  var brandBtnEl = document.getElementById('KCB2BrandBtn');
  var brandLabelEl = document.getElementById('KCB2BrandLabel');
  var sortBtnEl = document.getElementById('KCB2SortBtn');
  var sortLabelEl = document.getElementById('KCB2SortLabel');
  var sortMenuEl = document.getElementById('KCB2SortMenu');
  var typeBtnEl = document.getElementById('KCB2TypeBtn');
  var typeLabelEl = document.getElementById('KCB2TypeLabel');
  var typeMenuEl = document.getElementById('KCB2TypeMenu');
  var availBtnEl = document.getElementById('KCB2AvailBtn');
  var availLabelEl = document.getElementById('KCB2AvailLabel');
  var availMenuEl = document.getElementById('KCB2AvailMenu');
  var priceBtnEl = document.getElementById('KCB2PriceBtn');
  var priceLabelEl = document.getElementById('KCB2PriceLabel');
  var priceMenuEl = document.getElementById('KCB2PriceMenu');

  var state = {
    kind: 'collection',
    handle: '',
