      'POHA/PORI/PUFFED':     'M26 46h28a14 14 0 0 1-28 0zm6-6a2 2 0 1 0 4 0 2 2 0 0 0-4 0m6-2a2 2 0 1 0 4 0 2 2 0 0 0-4 0m6 2a2 2 0 1 0 4 0 2 2 0 0 0-4 0m-10-6a2 2 0 1 0 4 0 2 2 0 0 0-4 0m6 0a2 2 0 1 0 4 0 2 2 0 0 0-4 0',
      'POTATO':               'M40 30c-10 0-16 6-16 12s6 12 16 12 16-6 16-12-6-12-16-12zm-6 8a2 2 0 1 0 4 0 2 2 0 0 0-4 0m8 4a2 2 0 1 0 4 0 2 2 0 0 0-4 0',
      'SALT':                 'M37 55V34h6v21zm-3-21v-8a4 4 0 0 1 4-4h2a4 4 0 0 1 4 4v8zm2-8v-6m2 2a1 1 0 1 0 2 0 1 1 0 0 0-2 0m-4 4a1 1 0 1 0 2 0 1 1 0 0 0-2 0m4 0a1 1 0 1 0 2 0 1 1 0 0 0-2 0',
      'SAUCES':               'M34 55V34h12v21zm0-21v-6a4 4 0 0 1 4-4h0a4 4 0 0 1 4 4v6zm3-10v-5h6v5zm4-5l4-4m-8 0l-4-4',
      'SOFT DRINKS':          'M32 55V30h16v25zm0-25a8 3 0 1 1 16 0zm0 25a8 3 0 1 0 16 0m8-12h-8m-8 0h-8',
      'TISSUE/NAPKINS':       'M24 36h32v18H24zm10-8a6 8 0 0 1 12 0v8H34zm6 0v-6m-6 14c4-4 12-4 12 0',
      'TOILETRIES':           'M34 55V34h12v21zm0-21v-6h12v6zm4-6v-6h4v6zm-2-10l2-4 2 4m-8 20h12',
      'SHAVING':              'M34 55V34h12v21zm0-21v-6h12v6zm4-6v-6h4v6zm-2-10l2-4 2 4m-8 20h12',
      'TOOVAKAL':             'M30 28h20l4 27H26zm0 0l-4-6h28l-4 6m8 10H18m6 8h32',
      'TOPPING':              'M36 55V34h8v21zm-2-21v-6h12v6zm3-6v-5h6v5zm3-5v-4l4-2v3h-4zm-6-2l-4-4 4-4',
      'UMBERELLA/RAINCOAT':   'M40 28v26m0 0a4 4 0 0 1-8 0m-12-22a20 20 0 0 1 40 0H28a12 12 0 0 0-12-4 12 12 0 0 0-8 4H8',
      'YEAST':                'M28 30h24v24H28zm4 4h16m-16 6h12m-12 6h16m-8-12v12',
      'YOGHURT':              'M30 36h20l-2 18H32zm0 0v-6h20v6zm4-6v-4h12v4m-12 12a6 4 0 0 0 12 0'
    };

    var BASKET = 'M22 36h36l-4 18H26zm9-10l-5 10m16-10l5 10m-13 0v12m6-12v12m-3-22v-6';
    var path = icons[t] || BASKET;

    var svg = [
      "<svg xmlns='http://www.w3.org/2000/svg' width='80' height='80' viewBox='0 0 80 80'>",
      "<circle cx='40' cy='40' r='36' fill='#EEF7E8'/>",
      "<circle cx='40' cy='40' r='28' fill='#D8EDCA' opacity='.5'/>",
      "<path d='" + path + "' fill='none' stroke='#2D6A1F' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'/>",
      "</svg>"
    ].join('');
    return 'data:image/svg+xml,' + encodeURIComponent(svg);
  }

  function formatMoney(cents) {
    var amount = (Number(cents) || 0) / 100;
    var formatted = amount.toFixed(2);
    var withCommas = formatted.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    var value = moneyFormat
      .replace(/\{\{\s*amount\s*\}\}/g, withCommas)
      .replace(/\{\{\s*amount_no_decimals\s*\}\}/g, Math.round(amount).toString())
      .replace(/\{\{\s*amount_with_comma_separator\s*\}\}/g, withCommas.replace('.', ',').replace(/,(?=\d{3})/g, '.'))
      .replace(/\{\{\s*amount_no_decimals_with_comma_separator\s*\}\}/g, Math.round(amount).toString());
    if (window.Shopify && typeof window.Shopify.formatMoney === 'function') {
      try { return window.Shopify.formatMoney(cents, moneyFormat); } catch (e) { /* fall through */ }
    }
    return value;
  }

  function escHtml(s) {
    return String(s || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function buildFetchUrl(pageNum) {
    var sort = state.activeSort || 'manual';
    var params = 'view=kcb2-json&page=' + encodeURIComponent(pageNum) + '&sort_by=' + encodeURIComponent(sort);
    if (state.kind === 'type') {
      return ROOT + 'collections/types?' + params + '&q=' + encodeURIComponent(state.type || '');
    }
    return ROOT + 'collections/' + encodeURIComponent(state.handle) + '?' + params;
  }

  function normalizeProduct(p) {
    if (!p || !p.id) return null;
    var variants = p.variants || [];
    var variant = variants[0] || {};
    var available = typeof p.available === 'boolean'
      ? p.available
      : variants.some(function (v) { return v && v.available; });
    return {
      id: p.id,
      title: p.title || '',
      handle: p.handle || '',
      url: p.url || (ROOT + 'products/' + (p.handle || '')),
      vendor: p.vendor || '',
      type: p.type || p.product_type || '',
      tags: p.tags || [],
      available: available,
      price: typeof p.price === 'number' ? p.price : (variant.price || 0),
      compare_at_price: p.compare_at_price || variant.compare_at_price || 0,
      featured_image: p.featured_image || (p.images && p.images[0] && (p.images[0].src || p.images[0])) || null,
      variants: variants
    };
  }

  function fetchPage(pageNum, append) {
    state.loading = true;
    if (!append) {
      if (loadingEl) loadingEl.style.display = 'flex';
      if (emptyEl) emptyEl.style.display = 'none';
      if (loadMoreWrap) loadMoreWrap.hidden = true;
      Array.from(productsEl.querySelectorAll('.kcb2-grid')).forEach(function (g) { g.remove(); });
    }

    return fetch(buildFetchUrl(pageNum), { credentials: 'same-origin' })
      .then(function (r) {
        if (!r.ok) throw new Error('HTTP ' + r.status);
        return r.text();
      })
      .then(function (text) {
        var data = JSON.parse(text.trim());
        var incoming = (data.products || []).map(normalizeProduct).filter(Boolean);
        var unique = [];
        incoming.forEach(function (p) {
          if (state.seenIds[p.id]) return;
          state.seenIds[p.id] = true;
          unique.push(p);
        });

        if (append) {
          state.products = state.products.concat(unique);
        } else {
          state.products = unique;
        }

        state.page = (data.pagination && data.pagination.current_page) || pageNum;
        state.pages = (data.pagination && data.pagination.pages) || 1;
        state.productsCount = (data.collection && data.collection.products_count) || state.products.length;

        if (data.collection) {
          if (Array.isArray(data.collection.all_vendors)) state.vendors = data.collection.all_vendors.slice();
          if (Array.isArray(data.collection.all_types)) state.types = data.collection.all_types.filter(Boolean);
        }

        buildDropdownMenus();
        applyFilters();
        updateLoadMore();
      })
      .catch(function () {
        if (!append && state.products.length === 0) {
          if (loadingEl) loadingEl.style.display = 'none';
          if (emptyEl) emptyEl.style.display = 'block';
        }
      })
      .then(function () {
        state.loading = false;
        if (loadingEl) loadingEl.style.display = 'none';
      });
  }

  function updateLoadMore() {
    if (!loadMoreWrap) return;
    var hasMore = state.page < state.pages;
    loadMoreWrap.hidden = !hasMore;
  }

  function priceOf(p) {
    if (p.variants && p.variants[0] && typeof p.variants[0].price === 'number') return p.variants[0].price;
    return Number(p.price) || 0;
  }

  function buildPriceBuckets(products) {
    var prices = products.map(priceOf).filter(function (n) { return n > 0; });
    if (!prices.length) return [];
    var min = Math.min.apply(null, prices);
    var max = Math.max.apply(null, prices);
    if (min === max) {
      return [{ id: 'eq', label: formatMoney(min), min: min, max: max }];
    }
    var step = Math.max(1, Math.ceil((max - min) / 4));
    var buckets = [];
    var start = min;
    for (var i = 0; i < 4 && start <= max; i++) {
      var end = i === 3 ? max : Math.min(max, start + step - 1);
      buckets.push({
        id: start + '-' + end,
        label: formatMoney(start) + ' – ' + formatMoney(end),
        min: start,
        max: end
      });
      start = end + 1;
    }
    return buckets;
  }

  function applyFilters() {
    var products = state.products.slice();

    if (state.activeBrand && state.activeBrand !== 'all') {
      products = products.filter(function (p) {
        return (p.vendor || '').toLowerCase() === state.activeBrand.toLowerCase();
      });
    }

    if (state.activeType && state.activeType !== 'all') {
      products = products.filter(function (p) {
        return (p.type || '').toLowerCase() === state.activeType.toLowerCase();
      });
    }

    if (state.activeAvail === 'in_stock') {
      products = products.filter(function (p) { return !!p.available; });
    } else if (state.activeAvail === 'sold_out') {
      products = products.filter(function (p) { return !p.available; });
    }

    if (state.activePrice && state.activePrice !== 'all') {
      var parts = String(state.activePrice).split('-');
      var minP = Number(parts[0]);
      var maxP = Number(parts[1]);
      products = products.filter(function (p) {
        var price = priceOf(p);
        return price >= minP && price <= maxP;
      });
    }

    state.filteredProducts = products;
    renderProducts(products);

    if (countEl) {
      var total = state.productsCount || products.length;
      countEl.hidden = false;
      countEl.textContent = products.length + ' shown' + (total && total !== products.length ? ' · ' + total + ' in category' : '');
    }
  }

  function renderProducts(products) {
    Array.from(productsEl.querySelectorAll('.kcb2-grid')).forEach(function (el) { el.remove(); });

    if (!products || products.length === 0) {
      if (emptyEl) emptyEl.style.display = 'block';
      return;
    }
    if (emptyEl) emptyEl.style.display = 'none';

    var grid = document.createElement('div');
    grid.className = 'kcb2-grid';

    products.forEach(function (product) {
      // Use the first available variant so the ADD button targets a variant
      // that can actually be added to cart. Fall back to variants[0] only when
      // no variant is available (product will render as sold-out anyway).
      var variants = product.variants || [];
      var variant = variants.find(function (v) { return v && v.available; }) || variants[0] || {};
      var numPrice = priceOf(product);
      var numCompare = Number(variant.compare_at_price || product.compare_at_price || 0);
      var savePercent = numCompare > numPrice ? Math.round((numCompare - numPrice) / numCompare * 100) : 0;
      var imgSrc = product.featured_image || placeholderForType(product.type);
      var packLabel = variant.title && variant.title !== 'Default Title'
        ? variant.title
        : (product.vendor || '');
      var available = !!product.available;
      var productUrl = product.url || (ROOT + 'products/' + product.handle);

      var card = document.createElement('div');
      card.className = 'kcb2-card karthika-compact-card' + (available ? '' : ' is-sold-out');
      card.setAttribute('data-product-id', product.id);
      card.setAttribute('data-product-handle', product.handle || '');
      card.innerHTML = [
        '<button type="button" class="karthika-wishlist-btn" aria-label="' + escHtml('Add ' + product.title + ' to wishlist') + '" aria-pressed="false" data-product-handle="' + escHtml(product.handle || '') + '" data-product-id="' + escHtml(product.id) + '" data-product-title="' + escHtml(product.title) + '" data-label-add="' + escHtml('Add ' + product.title + ' to wishlist') + '" data-label-remove="' + escHtml('Remove ' + product.title + ' from wishlist') + '"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg></button>',
        '<div class="karthika-compact-media">',
          savePercent ? '<div class="karthika-card-badge">' + savePercent + '% OFF</div>' : '',
          '<a href="' + escHtml(productUrl) + '" aria-label="' + escHtml(product.title) + '" tabindex="-1"' + (available ? '' : ' class="kcb2-soldout-media"') + '><img src="' + escHtml(imgSrc) + '" alt="' + escHtml(product.title) + '" width="200" height="200" loading="lazy" class="karthika-compact-img" data-ph="' + escHtml(placeholderForType(product.type)) + '" onerror="this.onerror=null;this.src=this.getAttribute(\'data-ph\')||\'\'"></a>',
        '</div>',
        '<div class="karthika-compact-info">',
          '<div class="karthika-card-meta-row">',
            '<span class="karthika-compact-pack">' + escHtml(packLabel) + '</span>',
            '<span class="karthika-stock-badge' + (available ? '' : ' karthika-stock-badge--out') + '"><span class="karthika-stock-dot"></span>' + (available ? 'In stock' : 'Sold out') + '</span>',
          '</div>',
          '<a href="' + escHtml(productUrl) + '" class="karthika-compact-title" title="' + escHtml(product.title) + '">' + escHtml(product.title) + '</a>',
          '<div class="karthika-price-container"><div class="karthika-price-main-row">',
            '<span class="karthika-price-current">' + formatMoney(numPrice) + '</span>',
            savePercent ? '<span class="karthika-price-original">' + formatMoney(numCompare) + '</span>' : '',
            savePercent ? '<span class="karthika-price-discount-tag">-' + savePercent + '%</span>' : '',
          '</div></div>',
          available
            ? [
                '<div class="karthika-card-action-bar karthika-stepper" data-variant-id="' + escHtml(variant.id || '') + '" data-product-available="true">',
                  '<button type="button" class="karthika-stepper-add-btn" aria-label="Add ' + escHtml(product.title) + ' to cart">',
                    '<span class="karthika-add-btn-icon">+</span>',
                    '<span class="karthika-add-btn-text">ADD</span>',
                  '</button>',
                  '<div class="karthika-compact-stepper">',
                    '<button type="button" class="karthika-stepper-act-btn karthika-stepper-btn--minus" aria-label="Decrease quantity"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.8"><line x1="5" y1="12" x2="19" y2="12"/></svg></button>',
                    '<span class="karthika-compact-stepper-val karthika-stepper-qty">1</span>',
                    '<button type="button" class="karthika-stepper-act-btn karthika-stepper-btn--plus" aria-label="Increase quantity"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.8"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></button>',
                  '</div>',
                '</div>'
              ].join('')
            : '<div class="karthika-sold-out-badge" aria-label="Sold out" role="status">SOLD OUT</div>',
        '</div>'
      ].join('');

      grid.appendChild(card);
    });

    productsEl.appendChild(grid);

    if (window.Karthika && window.Karthika.Cart) {
      window.Karthika.Cart.syncAllSteppers();
    }
  }

  function populateMenu(menuEl, items, dataAttr, allLabel, selected) {
    if (!menuEl) return;
    menuEl.innerHTML = '';
    var allItem = document.createElement('li');
    allItem.className = 'kcb2-dropdown-item' + (selected === 'all' ? ' is-selected' : '');
    allItem.setAttribute('data-' + dataAttr, 'all');
    allItem.setAttribute('role', 'option');
    allItem.setAttribute('aria-selected', selected === 'all' ? 'true' : 'false');
    allItem.setAttribute('tabindex', '0');
    allItem.textContent = allLabel;
    menuEl.appendChild(allItem);

    items.forEach(function (item) {
      var value = typeof item === 'object' ? item.id : item;
      var label = typeof item === 'object' ? item.label : item;
      var li = document.createElement('li');
      li.className = 'kcb2-dropdown-item' + (String(selected) === String(value) ? ' is-selected' : '');
      li.setAttribute('data-' + dataAttr, value);
      li.setAttribute('role', 'option');
      li.setAttribute('aria-selected', String(selected) === String(value) ? 'true' : 'false');
      li.setAttribute('tabindex', '0');
      li.textContent = label;
      menuEl.appendChild(li);
    });
  }

  function buildDropdownMenus() {
    var vendors = state.vendors.slice();
    if (!vendors.length) {
      state.products.forEach(function (p) {
        if (p.vendor && vendors.indexOf(p.vendor) === -1) vendors.push(p.vendor);
      });
    }
    vendors.sort();
    populateMenu(brandMenuEl, vendors, 'brand', 'All Brands', state.activeBrand);

    var types = state.types.slice();
    if (!types.length) {
      state.products.forEach(function (p) {
        if (p.type && types.indexOf(p.type) === -1) types.push(p.type);
      });
    }
    types = types.filter(Boolean).sort();
    populateMenu(typeMenuEl, types, 'type', 'All Types', state.activeType);

    var buckets = buildPriceBuckets(state.products);
    populateMenu(priceMenuEl, buckets, 'price', 'All Prices', state.activePrice);
  }

  function loadCategory(btn) {
    if (!btn || state.loading) return;

    state.kind = btn.dataset.kind || 'collection';
    state.handle = btn.dataset.handle || '';
    state.type = btn.dataset.type || '';
    state.label = btn.dataset.label || '';
    state.activeBrand = 'all';
    state.activeType = 'all';
    state.activeAvail = 'all';
    state.activePrice = 'all';
    state.activeSort = 'manual';
    state.page = 1;
    state.pages = 1;
    state.products = [];
    state.seenIds = {};
    state.vendors = [];
    state.types = [];

    if (titleEl) titleEl.textContent = state.label;
    if (brandLabelEl) brandLabelEl.textContent = 'Brand';
    if (typeLabelEl) typeLabelEl.textContent = 'Type';
    if (availLabelEl) availLabelEl.textContent = 'Availability';
    if (priceLabelEl) priceLabelEl.textContent = 'Price';
    if (sortLabelEl) sortLabelEl.textContent = 'Sort By';
    if (sortMenuEl) {
      sortMenuEl.querySelectorAll('.kcb2-dropdown-item').forEach(function (i) {
        var sel = i.dataset.sort === 'manual';
        i.classList.toggle('is-selected', sel);
        i.setAttribute('aria-selected', sel ? 'true' : 'false');
      });
    }
    if (availMenuEl) {
      availMenuEl.querySelectorAll('.kcb2-dropdown-item').forEach(function (i) {
        var sel = i.dataset.avail === 'all';
        i.classList.toggle('is-selected', sel);
        i.setAttribute('aria-selected', sel ? 'true' : 'false');
      });
    }

    page.querySelectorAll('.kcb2-cat-item').forEach(function (el) {
      var active = el === btn;
      el.classList.toggle('is-active', active);
      el.setAttribute('aria-pressed', active ? 'true' : 'false');
    });

    try {
      var url = new URL(window.location.href);
      if (state.kind === 'type') url.searchParams.set('cat', state.handle);
      else url.searchParams.set('cat', state.handle);
      window.history.replaceState({}, '', url);
    } catch (e) { /* ignore */ }

    fetchPage(1, false);
  }

  var _openBtn = null;
  var _openMenu = null;

  function positionMenu(btnEl, menuEl) {
    var rect = btnEl.getBoundingClientRect();
    menuEl.style.top = (rect.bottom + 6) + 'px';
    menuEl.style.left = rect.left + 'px';
  }

  function openDropdown(btnEl, menuEl) {
    _openBtn = btnEl;
    _openMenu = menuEl;
    menuEl.hidden = false;
    positionMenu(btnEl, menuEl);
    btnEl.setAttribute('aria-expanded', 'true');
    btnEl.classList.add('is-open');
  }

  function closeDropdown(btnEl, menuEl) {
    if (!menuEl || !btnEl) return;
    menuEl.hidden = true;
    menuEl.style.top = '';
    menuEl.style.left = '';
    btnEl.setAttribute('aria-expanded', 'false');
    btnEl.classList.remove('is-open');
    if (_openMenu === menuEl) { _openBtn = null; _openMenu = null; }
  }

  function closeAllDropdowns() {
    brandBtnEl && brandMenuEl && closeDropdown(brandBtnEl, brandMenuEl);
    sortBtnEl && sortMenuEl && closeDropdown(sortBtnEl, sortMenuEl);
    typeBtnEl && typeMenuEl && closeDropdown(typeBtnEl, typeMenuEl);
    availBtnEl && availMenuEl && closeDropdown(availBtnEl, availMenuEl);
    priceBtnEl && priceMenuEl && closeDropdown(priceBtnEl, priceMenuEl);
  }

  function selectMenuItem(menuEl, attr, value) {
    menuEl.querySelectorAll('.kcb2-dropdown-item').forEach(function (i) {
      var sel = String(i.getAttribute('data-' + attr)) === String(value);
      i.classList.toggle('is-selected', sel);
      i.setAttribute('aria-selected', sel ? 'true' : 'false');
    });
  }

  page.addEventListener('click', function (e) {
    var catBtn = e.target.closest('.kcb2-cat-item');
    if (catBtn) {
      loadCategory(catBtn);
      catBtn.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      closeAllDropdowns();
      return;
    }

    if (e.target.closest('#KCB2LoadMore')) {
      if (!state.loading && state.page < state.pages) fetchPage(state.page + 1, true);
      return;
    }

    if (e.target.closest('#KCB2BrandBtn')) {
      var brandOpen = brandMenuEl && !brandMenuEl.hidden;
      closeAllDropdowns();
      if (!brandOpen) openDropdown(brandBtnEl, brandMenuEl);
      return;
    }
    var brandItem = e.target.closest('#KCB2BrandMenu .kcb2-dropdown-item');
    if (brandItem) {
      state.activeBrand = brandItem.dataset.brand || 'all';
      selectMenuItem(brandMenuEl, 'brand', state.activeBrand);
      brandLabelEl.textContent = state.activeBrand === 'all' ? 'Brand' : state.activeBrand;
      applyFilters();
      closeDropdown(brandBtnEl, brandMenuEl);
      return;
    }

    if (e.target.closest('#KCB2TypeBtn')) {
      var typeOpen = typeMenuEl && !typeMenuEl.hidden;
      closeAllDropdowns();
      if (!typeOpen) openDropdown(typeBtnEl, typeMenuEl);
      return;
    }
    var typeItem = e.target.closest('#KCB2TypeMenu .kcb2-dropdown-item');
    if (typeItem) {
      state.activeType = typeItem.dataset.type || 'all';
      selectMenuItem(typeMenuEl, 'type', state.activeType);
      typeLabelEl.textContent = state.activeType === 'all' ? 'Type' : state.activeType;
      applyFilters();
      closeDropdown(typeBtnEl, typeMenuEl);
      return;
    }

    if (e.target.closest('#KCB2AvailBtn')) {
      var availOpen = availMenuEl && !availMenuEl.hidden;
      closeAllDropdowns();
      if (!availOpen) openDropdown(availBtnEl, availMenuEl);
      return;
    }
    var availItem = e.target.closest('#KCB2AvailMenu .kcb2-dropdown-item');
    if (availItem) {
      state.activeAvail = availItem.dataset.avail || 'all';
      selectMenuItem(availMenuEl, 'avail', state.activeAvail);
      availLabelEl.textContent = state.activeAvail === 'all' ? 'Availability' : availItem.textContent;
      applyFilters();
      closeDropdown(availBtnEl, availMenuEl);
      return;
    }

    if (e.target.closest('#KCB2PriceBtn')) {
      var priceOpen = priceMenuEl && !priceMenuEl.hidden;
      closeAllDropdowns();
      if (!priceOpen) openDropdown(priceBtnEl, priceMenuEl);
      return;
    }
    var priceItem = e.target.closest('#KCB2PriceMenu .kcb2-dropdown-item');
    if (priceItem) {
      state.activePrice = priceItem.dataset.price || 'all';
      selectMenuItem(priceMenuEl, 'price', state.activePrice);
      priceLabelEl.textContent = state.activePrice === 'all' ? 'Price' : priceItem.textContent;
      applyFilters();
      closeDropdown(priceBtnEl, priceMenuEl);
      return;
    }

    if (e.target.closest('#KCB2SortBtn')) {
      var sortOpen = sortMenuEl && !sortMenuEl.hidden;
      closeAllDropdowns();
      if (!sortOpen) openDropdown(sortBtnEl, sortMenuEl);
      return;
    }
    var sortItem = e.target.closest('#KCB2SortMenu .kcb2-dropdown-item');
    if (sortItem) {
      state.activeSort = sortItem.dataset.sort || 'manual';
      selectMenuItem(sortMenuEl, 'sort', state.activeSort);
      sortLabelEl.textContent = sortItem.textContent;
      closeDropdown(sortBtnEl, sortMenuEl);
      state.products = [];
      state.seenIds = {};
      fetchPage(1, false);
      return;
    }

    if (!e.target.closest('.kcb2-dropdown') && !(_openMenu && _openMenu.contains(e.target))) {
      closeAllDropdowns();
    }
  });

  window.addEventListener('scroll', function () {
    if (_openBtn && _openMenu && !_openMenu.hidden) positionMenu(_openBtn, _openMenu);
  }, true);
  window.addEventListener('resize', function () {
    if (_openBtn && _openMenu && !_openMenu.hidden) positionMenu(_openBtn, _openMenu);
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeAllDropdowns();
  });

  var initialBtn = page.querySelector('.kcb2-cat-item.is-active') || page.querySelector('.kcb2-cat-item');
  try {
    var catParam = new URLSearchParams(window.location.search).get('cat');
    if (catParam) {
      page.querySelectorAll('.kcb2-cat-item').forEach(function (btn) {
        if (btn.dataset.handle === catParam) initialBtn = btn;
      });
    }
  } catch (e) { /* ignore */ }

  if (initialBtn) {
    loadCategory(initialBtn);
  } else if (emptyEl) {
    emptyEl.style.display = 'block';
    if (titleEl) titleEl.textContent = 'Categories';
  }
})();
</script>

{% schema %}
{
  "name": "Categories",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Page title",
      "default": "Categories"
    }
  ]
}
{% endschema %}
