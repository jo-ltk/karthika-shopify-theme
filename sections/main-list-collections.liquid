{{ 'karthika-grocery.css' | asset_url | stylesheet_tag }}

{%- liquid
  -%}

{%- comment -%}
  Sidebar categories with curated Unsplash CDN grocery images matching the reference UI
{%- endcomment -%}

{%- assign sidebar_handles = 'dairy-eggs,bread-buns,paneer-tofu,cheese,eggs,top-deals,fresh-fruits,vegetables,rice-grains,spices-masala,dals-pulses,atta-flours,indian-snacks,frozen-foods,beverages,household' | split: ',' -%}

{%- assign sidebar_labels = 'Milk,Bread and Buns,Paneer and Tofu,Cheese,Eggs,Top Deals,Fresh Fruits,Vegetables,Rice & Grains,Spices & Masala,Dals & Pulses,Atta & Flours,Indian Snacks,Frozen Foods,Beverages,Household' | split: ',' -%}

{%- assign sidebar_imgs = 'https://images.unsplash.com/photo-1550583724-b2692b85b150?w=160&auto=format&fit=crop&q=80,https://images.unsplash.com/photo-1509440159596-0249088772ff?w=160&auto=format&fit=crop&q=80,https://images.unsplash.com/photo-1589301760014-d929f3979dbc?w=160&auto=format&fit=crop&q=80,https://images.unsplash.com/photo-1624806992066-5ffcf7ca186b?w=160&auto=format&fit=crop&q=80,https://images.unsplash.com/photo-1582722872445-44dc5f7e3c8f?w=160&auto=format&fit=crop&q=80,https://images.unsplash.com/photo-1607082348824-0a96f2a4b9da?w=160&auto=format&fit=crop&q=80,https://images.unsplash.com/photo-1619566636858-adf3ef46400b?w=160&auto=format&fit=crop&q=80,https://images.unsplash.com/photo-1540420773420-3366772f4999?w=160&auto=format&fit=crop&q=80,https://images.unsplash.com/photo-1586201375761-83865001e31c?w=160&auto=format&fit=crop&q=80,https://images.unsplash.com/photo-1596040033229-a9821ebd058d?w=160&auto=format&fit=crop&q=80,https://images.unsplash.com/photo-1515543237350-b3eea1ec8082?w=160&auto=format&fit=crop&q=80,https://images.unsplash.com/photo-1509440159596-0249088772ff?w=160&auto=format&fit=crop&q=80,https://images.unsplash.com/photo-1621447504864-d8686e12698c?w=160&auto=format&fit=crop&q=80,https://images.unsplash.com/photo-1513104890138-7c749659a591?w=160&auto=format&fit=crop&q=80,https://images.unsplash.com/photo-1544787219-7f47ccb76574?w=160&auto=format&fit=crop&q=80,https://images.unsplash.com/photo-1585421514284-efb74c2b69ba?w=160&auto=format&fit=crop&q=80' | split: ',' -%}

<section class="kcb2" id="KCB2Page" data-section-id="{{ section.id }}" aria-label="Browse categories">

  {%- comment -%} ── MAIN LAYOUT: Sidebar + Content ── {%- endcomment -%}
  <div class="kcb2-layout">

    {%- comment -%} ── LEFT SIDEBAR ── {%- endcomment -%}
    <aside class="kcb2-sidebar" aria-label="Product categories">
      <nav class="kcb2-cat-list">
        {%- for handle in sidebar_handles -%}
          {%- assign label = sidebar_labels[forloop.index0] -%}
          {%- assign img_url = sidebar_imgs[forloop.index0] -%}
          <button
            type="button"
            class="kcb2-cat-item{% if forloop.first %} is-active{% endif %}"
            data-handle="{{ handle }}"
            data-label="{{ label | escape }}"
            aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
          >
            <div class="kcb2-cat-img-wrap">
              <img src="{{ img_url }}" alt="{{ label | escape }}" width="52" height="52" loading="lazy" onerror="this.style.display='none'">
            </div>
            <span class="kcb2-cat-label">{{ label }}</span>
          </button>
        {%- endfor -%}
      </nav>
    </aside>

    {%- comment -%} ── RIGHT CONTENT PANEL ── {%- endcomment -%}
    <main class="kcb2-main" id="KCB2Main" aria-live="polite" aria-label="Products">

      {%- comment -%} ── TOP NAVIGATION BAR (Matching reference header) ── {%- endcomment -%}
      <div class="kcb2-top-bar">
        <div class="kcb2-top-bar__left">
          {% render 'karthika-back-button' %}
          <h1 class="kcb2-page-title" id="KCB2Title">Dairy, Bread and Eggs</h1>
        </div>
        <a href="{{ routes.search_url }}" class="kcb2-search-btn karthika-search-bar-trigger" aria-label="Search">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </a>
      </div>

      {%- comment -%} ── SECONDARY FILTER CONTROLS (Sort By, Brand, Type pills) ── {%- endcomment -%}
      <div class="kcb2-filter-strip" role="group" aria-label="Filter and Sort">
        <div class="kcb2-filter-scroll karthika-hide-scrollbar">

        <!-- Sort By Dropdown Pill -->
        <div class="kcb2-dropdown" id="KCB2SortDropdown">
          <button type="button" class="kcb2-pill-btn" id="KCB2SortBtn" aria-haspopup="listbox" aria-expanded="false">
            <span id="KCB2SortLabel">Sort By</span>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <ul class="kcb2-dropdown-menu" id="KCB2SortMenu" role="listbox" aria-label="Sort products" hidden>
            <li class="kcb2-dropdown-item is-selected" data-sort="default" role="option" aria-selected="true" tabindex="0">Relevance</li>
            <li class="kcb2-dropdown-item" data-sort="price-asc" role="option" aria-selected="false" tabindex="0">Price: Low to High</li>
            <li class="kcb2-dropdown-item" data-sort="price-desc" role="option" aria-selected="false" tabindex="0">Price: High to Low</li>
            <li class="kcb2-dropdown-item" data-sort="title-asc" role="option" aria-selected="false" tabindex="0">Name: A–Z</li>
          </ul>
        </div>

        <!-- Brand Dropdown Pill -->
        <div class="kcb2-dropdown" id="KCB2BrandDropdown">
          <button type="button" class="kcb2-pill-btn" id="KCB2BrandBtn" aria-haspopup="listbox" aria-expanded="false">
            <span id="KCB2BrandLabel">Brand</span>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <ul class="kcb2-dropdown-menu" id="KCB2BrandMenu" role="listbox" aria-label="Filter by brand" hidden></ul>
        </div>

        <!-- Subcategory/Type Dropdown Pill -->
        <div class="kcb2-dropdown" id="KCB2TypeDropdown">
          <button type="button" class="kcb2-pill-btn" id="KCB2TypeBtn" aria-haspopup="listbox" aria-expanded="false">
            <span id="KCB2TypeLabel">Type</span>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <ul class="kcb2-dropdown-menu" id="KCB2TypeMenu" role="listbox" aria-label="Filter by type" hidden></ul>
        </div>

        <!-- Pack Size Pill -->
        <div class="kcb2-dropdown" id="KCB2PackDropdown">
          <button type="button" class="kcb2-pill-btn" id="KCB2PackBtn" aria-haspopup="listbox" aria-expanded="false">
            <span id="KCB2PackLabel">Pack Size</span>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <ul class="kcb2-dropdown-menu" id="KCB2PackMenu" role="listbox" aria-label="Filter by pack size" hidden></ul>
        </div>
        </div><!-- /.kcb2-filter-scroll -->
      </div><!-- /.kcb2-filter-strip -->

      {%- comment -%} ── PRODUCTS GRID ── {%- endcomment -%}
      <div class="kcb2-products" id="KCB2Products">
        <div class="kcb2-loading" id="KCB2Loading" aria-label="Loading products" style="display:none">
          <span class="kcb2-spinner" aria-hidden="true"></span>
          <span>Loading products…</span>
        </div>
      </div>

      {%- comment -%} Empty state {%- endcomment -%}
      <div class="kcb2-empty" id="KCB2Empty" style="display:none">
        <p class="kcb2-empty-icon" aria-hidden="true">🛒</p>
        <h2>No products found</h2>
        <p>Try selecting a different category or clearing the filter.</p>
        <a href="{{ routes.all_products_collection_url }}" class="kcb2-empty-btn">Browse all products</a>
      </div>

    </main>
  </div>
</section>

