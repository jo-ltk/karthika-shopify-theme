<div class="karthika-mini-promo" role="region" aria-label="{{ section.settings.title | default: 'Weekend Deals' | escape }}">
  <div class="karthika-mini-promo-icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.78 4.78 4 4 0 0 1-6.74 0 4 4 0 0 1-4.78-4.78 4 4 0 0 1 0-6.75Z"></path>
      <line x1="15" x2="9" y1="9" y2="15"></line>
      <line x1="9" x2="9.01" y1="9" y2="9"></line>
      <line x1="15" x2="15.01" y1="15" y2="15"></line>
    </svg>
  </div>
  <div class="karthika-mini-promo-copy">
    <h2>{{ section.settings.title | default: 'Weekend Deals' }}</h2>
    <p>{{ section.settings.subtitle | default: 'Up to 30% off on top brands' }}</p>
  </div>
  <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="karthika-mini-promo-button">
    {{ section.settings.button_label | default: 'View offers' }}
  </a>
</div>

{% schema %}
{
  "name": "Karthika Mini Promotion",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Offer Title", "default": "Weekend Deals" },
    { "type": "text", "id": "subtitle", "label": "Supporting Text", "default": "Up to 30% off on top brands" },
    { "type": "text", "id": "button_label", "label": "Button Label", "default": "View offers" },
    { "type": "url", "id": "button_link", "label": "Button Link" }
  ],
  "presets": [
    { "name": "Karthika Mini Promotion" }
  ]
}
{% endschema %}