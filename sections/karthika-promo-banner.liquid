<div class="karthika-promo-banner-wrap" id="KarthikaCarousel-{{ section.id }}">
  <div class="karthika-carousel-container" id="karthikaHeroCarousel-{{ section.id }}">
    <div class="karthika-carousel-track" id="karthikaHeroTrack-{{ section.id }}">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.button_link | default: block.settings.link | default: routes.collections_url }}" class="karthika-carousel-slide" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 900 }}"
                alt="{{ block.settings.heading | default: block.settings.title | default: 'Karthika Banner' | escape }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                class="karthika-promo-bg-img"
                width="900"
                height="400"
              >
            {%- endif -%}
          </a>
        {%- endfor -%}
      {%- else -%}
        <!-- Banner 1 -->
        <a href="{{ routes.collections_url }}" class="karthika-carousel-slide">
          <img 
            src="{{ 'banner-1.png' | asset_url }}"
            alt="Freshness You Can Trust - Fresh Picks" 
            class="karthika-promo-bg-img" 
            loading="eager" 
            width="900" 
            height="400"
          >
        </a>
        <!-- Banner 2 -->
        <a href="{{ routes.collections_url }}" class="karthika-carousel-slide">
          <img 
            src="{{ 'banner-2.png' | asset_url }}"
            alt="Poli Onam Sale - Festive Sale" 
            class="karthika-promo-bg-img" 
            loading="lazy" 
            width="900" 
            height="400"
          >
        </a>
        <!-- Banner 3 -->
        <a href="{{ routes.collections_url }}" class="karthika-carousel-slide">
          <img 
            src="{{ 'banner-3.png' | asset_url }}"
            alt="New Season Arrivals - Fresh Picks" 
            class="karthika-promo-bg-img" 
            loading="lazy" 
            width="900" 
            height="400"
          >
        </a>
      {%- endif -%}
    </div>
  </div>

  <!-- Pagination Dots -->
  <div class="karthika-carousel-pagination" id="karthikaHeroDots-{{ section.id }}" role="tablist" aria-label="Hero Carousel Dots">
    {%- assign slide_count = section.blocks.size -%}
    {%- if slide_count == 0 -%}{%- assign slide_count = 3 -%}{%- endif -%}
    {%- for i in (1..slide_count) -%}
      {%- assign idx = forloop.index0 -%}
      <button
        type="button"
        class="karthika-carousel-dot {% if forloop.first %}is-active{% endif %}"
        aria-label="Slide {{ i }}"
        data-index="{{ idx }}"
      ></button>
    {%- endfor -%}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sectionWrap = document.getElementById('KarthikaCarousel-{{ section.id }}');
    if (!sectionWrap) return;
    const carousel = sectionWrap.querySelector('.karthika-carousel-container');
    const track = sectionWrap.querySelector('.karthika-carousel-track');
    const dots = sectionWrap.querySelectorAll('.karthika-carousel-dot');
    if (!carousel || !track || !dots.length) return;

    const slides = track.querySelectorAll('.karthika-carousel-slide');
    const totalSlides = slides.length;
    let currentIndex = 0;
    let autoPlayTimer = null;
    let startX = 0;
    let isDragging = false;
    let hasMoved = false;

    function goToSlide(index) {
      if (index < 0) {
        currentIndex = totalSlides - 1;
      } else if (index >= totalSlides) {
        currentIndex = 0;
      } else {
        currentIndex = index;
      }

      track.style.transition = 'transform 0.45s cubic-bezier(0.25, 1, 0.5, 1)';
      track.style.transform = `translateX(-${currentIndex * 100}%)`;

      dots.forEach((dot, idx) => {
        dot.classList.toggle('is-active', idx === currentIndex);
      });
    }

    function startAutoPlay() {
      stopAutoPlay();
      autoPlayTimer = setInterval(() => {
        goToSlide(currentIndex + 1);
      }, {{ section.settings.autoplay_speed | default: 4 | times: 1000 }});
    }

    function stopAutoPlay() {
      if (autoPlayTimer) {
        clearInterval(autoPlayTimer);
        autoPlayTimer = null;
      }
    }

    dots.forEach(dot => {
      dot.addEventListener('click', (e) => {
        e.stopPropagation();
        stopAutoPlay();
        const targetIndex = parseInt(dot.getAttribute('data-index'), 10);
        goToSlide(targetIndex);
        startAutoPlay();
      });
    });

    // Touch Swipe with active finger tracking
    carousel.addEventListener('touchstart', (e) => {
      stopAutoPlay();
      startX = e.touches[0].clientX;
      isDragging = true;
      hasMoved = false;
    }, { passive: true });

    carousel.addEventListener('touchmove', (e) => {
      if (!isDragging) return;
      const currentX = e.touches[0].clientX;
      const diff = currentX - startX;
      if (Math.abs(diff) > 5) hasMoved = true;
      track.style.transition = 'none';
      track.style.transform = `translateX(calc(-${currentIndex * 100}% + ${diff}px))`;
    }, { passive: true });

    carousel.addEventListener('touchend', (e) => {
      if (!isDragging) return;
      isDragging = false;
      const endX = e.changedTouches[0].clientX;
      const diff = endX - startX;

      // Minimum 50px swipe threshold
      if (diff < -50) {
        goToSlide(currentIndex + 1);
      } else if (diff > 50) {
        goToSlide(currentIndex - 1);
      } else {
        goToSlide(currentIndex);
      }
      startAutoPlay();
    });

    // Mouse Drag Support for Desktop testing
    carousel.addEventListener('mousedown', (e) => {
      stopAutoPlay();
      startX = e.clientX;
      isDragging = true;
      hasMoved = false;
      carousel.style.cursor = 'grabbing';
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      const diff = e.clientX - startX;
      if (Math.abs(diff) > 5) hasMoved = true;
      track.style.transition = 'none';
      track.style.transform = `translateX(calc(-${currentIndex * 100}% + ${diff}px))`;
    });

    window.addEventListener('mouseup', (e) => {
      if (!isDragging) return;
      isDragging = false;
      carousel.style.cursor = 'grab';
      const diff = e.clientX - startX;
      if (diff < -50) {
        goToSlide(currentIndex + 1);
      } else if (diff > 50) {
        goToSlide(currentIndex - 1);
      } else {
        goToSlide(currentIndex);
      }
      startAutoPlay();
    });

    // Prevent accidental click during drag
    carousel.querySelectorAll('.karthika-carousel-slide').forEach(slide => {
      slide.addEventListener('click', (e) => {
        if (hasMoved) {
          e.preventDefault();
          e.stopPropagation();
        }
      });
    });

    carousel.addEventListener('mouseenter', stopAutoPlay);
    carousel.addEventListener('mouseleave', startAutoPlay);

    {% if section.settings.autoplay %}
      startAutoPlay();
    {% endif %}
  });
</script>

{% schema %}
{
  "name": "Karthika Promo Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 2,
      "max": 8,
      "step": 1,
      "unit": "s",
      "label": "Slide duration",
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Promo Slide",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Freshness You Can Trust"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "Fresh Picks"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Handpicked fruits & veggies for a healthier you"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge Text (e.g. 40% OFF)",
          "default": "40% OFF"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Banner Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title (alt text)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Banner Link (fallback)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Karthika Promo Hero",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "heading": "Freshness You Can Trust",
            "subheading": "Fresh Picks",
            "description": "Handpicked fruits & veggies for a healthier you",
            "badge_text": "40% OFF",
            "button_text": "Shop Now"
          }
        },
        {
          "type": "slide",
          "settings": {
            "heading": "Poli Onam Sale",
            "subheading": "Festive Sale",
            "description": "Onam specials, Sadya essentials & festive picks",
            "badge_text": "50% OFF",
            "button_text": "Shop Now"
          }
        },
        {
          "type": "slide",
          "settings": {
            "heading": "New Season Arrivals",
            "subheading": "Fresh Picks",
            "description": "Discover what's in season now",
            "badge_text": "NEW",
            "button_text": "Shop Now"
          }
        }
      ]
    }
  ]
}
{% endschema %}
