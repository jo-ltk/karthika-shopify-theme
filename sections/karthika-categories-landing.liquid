{{ 'karthika-grocery.css' | asset_url | stylesheet_tag }}



{%- liquid

  assign browse_url = routes.collections_url

  assign page_title = section.settings.title | default: 'Categories'

  assign promo_link = section.settings.promo_link | default: browse_url

  assign promo_image = section.settings.promo_image

  if promo_image == blank

    assign promo_image_url = 'https://images.unsplash.com/photo-1542838132-92c53300491e?w=600&auto=format&fit=crop&q=80'

  endif

-%}



<section

  class="kcl"

  id="KCL-{{ section.id }}"

  data-section-id="{{ section.id }}"

  aria-label="{{ page_title | escape }}"

>

  <header class="kcl-page-header">

    <div class="kcl-page-header__main">

      {% render 'karthika-back-button' %}

      <div class="kcl-page-header__copy">

        <h1 class="kcl-page-header__title">{{ page_title }}</h1>

        <p class="kcl-page-header__subtitle">{{ section.settings.subtitle | default: 'Browse all products by category' }}</p>

      </div>

    </div>

    <button

      type="button"

      class="kcl-page-header__search karthika-search-bar-trigger"

      aria-label="Search categories"

    >

      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">

        <circle cx="11" cy="11" r="8"></circle>

        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>

      </svg>

    </button>

  </header>



  <div class="kcl-promo-wrap" id="KCLPromo-{{ section.id }}">

    <div class="kcl-promo-carousel" id="kclPromoCarousel-{{ section.id }}">

      <div class="kcl-promo-track" id="kclPromoTrack-{{ section.id }}">

        {%- assign promo_slides = section.blocks | where: 'type', 'promo_slide' -%}

        {%- if promo_slides.size > 0 -%}

          {%- for block in promo_slides -%}

            <article class="kcl-promo-slide" {{ block.shopify_attributes }}>

              <div class="kcl-promo-slide__content">

                <h2 class="kcl-promo-slide__headline">

                  <span class="kcl-promo-slide__headline-dark">{{ block.settings.headline_dark | default: 'Fresh essentials,' }}</span>

                  <span class="kcl-promo-slide__headline-green">{{ block.settings.headline_green | default: 'delivered to you' }}</span>

                </h2>

                <p class="kcl-promo-slide__sub">{{ block.settings.subtext | default: 'Quality products at your doorstep' }}</p>

                <a href="{{ block.settings.button_link | default: promo_link }}" class="kcl-promo-slide__cta">

                  {{ block.settings.button_text | default: 'Shop Now' }} <span aria-hidden="true">→</span>

                </a>

              </div>

              <div class="kcl-promo-slide__visual">

                <span class="kcl-promo-slide__leaf kcl-promo-slide__leaf--1" aria-hidden="true"></span>

                <span class="kcl-promo-slide__leaf kcl-promo-slide__leaf--2" aria-hidden="true"></span>

                {%- if block.settings.image != blank -%}

                  <img

                    src="{{ block.settings.image | image_url: width: 420 }}"

                    alt=""

                    class="kcl-promo-slide__photo"

                    width="210"

                    height="210"

                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"

                  >

                {%- else -%}

                  <img

                    src="{{ promo_image_url }}"

                    alt=""

                    class="kcl-promo-slide__photo"

                    width="210"

                    height="210"

                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"

                  >

                {%- endif -%}

                <span class="kcl-promo-slide__badge" aria-label="{{ block.settings.badge_text | default: 'Up to 25 percent off' }}">
                  <span class="kcl-promo-slide__badge-line">UP TO</span>
                  <span class="kcl-promo-slide__badge-line kcl-promo-slide__badge-line--pct">{{ block.settings.badge_percent | default: '25%' }}</span>
                  <span class="kcl-promo-slide__badge-line">OFF</span>
                </span>

              </div>

            </article>

          {%- endfor -%}

        {%- else -%}

          {%- for i in (1..3) -%}

            <article class="kcl-promo-slide">

              <div class="kcl-promo-slide__content">

                <h2 class="kcl-promo-slide__headline">

                  <span class="kcl-promo-slide__headline-dark">Fresh essentials,</span>

                  <span class="kcl-promo-slide__headline-green">delivered to you</span>

                </h2>

                <p class="kcl-promo-slide__sub">Quality products at your doorstep</p>

                <a href="{{ promo_link }}" class="kcl-promo-slide__cta">Shop Now <span aria-hidden="true">→</span></a>

              </div>

              <div class="kcl-promo-slide__visual">

                <span class="kcl-promo-slide__leaf kcl-promo-slide__leaf--1" aria-hidden="true"></span>

                <span class="kcl-promo-slide__leaf kcl-promo-slide__leaf--2" aria-hidden="true"></span>

                <img src="{{ promo_image_url }}" alt="" class="kcl-promo-slide__photo" width="210" height="210" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">

                <span class="kcl-promo-slide__badge" aria-label="Up to 25 percent off">
                  <span class="kcl-promo-slide__badge-line">UP TO</span>
                  <span class="kcl-promo-slide__badge-line kcl-promo-slide__badge-line--pct">25%</span>
                  <span class="kcl-promo-slide__badge-line">OFF</span>
                </span>

              </div>

            </article>

          {%- endfor -%}

        {%- endif -%}

      </div>

    </div>

    <div class="kcl-promo-dots" id="kclPromoDots-{{ section.id }}" role="tablist" aria-label="Promo carousel">

      {%- assign dot_count = promo_slides.size -%}

      {%- if dot_count == 0 -%}{%- assign dot_count = 3 -%}{%- endif -%}

      {%- for i in (1..dot_count) -%}

        <button

          type="button"

          class="kcl-promo-dot{% if forloop.first %} is-active{% endif %}"

          aria-label="Slide {{ i }}"

          data-index="{{ forloop.index0 }}"

        ></button>

      {%- endfor -%}

    </div>

  </div>



  <div class="kcl-body">

    {%- if section.blocks.size > 0 -%}

      {%- liquid

        assign in_group = false

        assign group_tile_count = 0

        assign group_tile_index = 0

        assign show_tile_view_all = false

        assign group_view_url = browse_url

      -%}

      {%- for block in section.blocks -%}

        {%- case block.type -%}

          {%- when 'group' -%}

            {%- if in_group -%}

              </div>

            </section>

            {%- endif -%}

            {%- liquid

              assign in_group = true

              assign group_tile_index = 0

              assign group_tile_count = 0

              assign group_view_url = browse_url

              assign group_start = forloop.index0

              for b in section.blocks

                if forloop.index0 > group_start

                  if b.type == 'group'

                    break

                  endif

                  if b.type == 'tile'

                    assign group_tile_count = group_tile_count | plus: 1

                    if group_tile_count == 1

                      assign group_view_url = browse_url | append: '?cat=' | append: b.settings.browse_handle

                    endif

                  endif

                endif

              endfor

              if group_tile_count > 5

                assign show_tile_view_all = true

              else

                assign show_tile_view_all = false

              endif

            -%}

            <section class="kcl-group" {{ block.shopify_attributes }}>

              <div class="kcl-group__head">

                <h2 class="kcl-group__title">{{ block.settings.title }}</h2>

                <a href="{{ group_view_url }}" class="kcl-group__view-all">

                  View all

                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">

                    <polyline points="9 18 15 12 9 6"></polyline>

                  </svg>

                </a>

              </div>

              <div class="kcl-grid">

          {%- when 'tile' -%}

            {%- if in_group -%}

              {%- liquid

                assign group_tile_index = group_tile_index | plus: 1

                assign tile_title = block.settings.title

                assign tile_handle = block.settings.browse_handle

                assign tile_link = browse_url | append: '?cat=' | append: tile_handle

                assign tile_image = block.settings.image

                assign tile_demo_url = block.settings.demo_image_url

                assign tile_collection = collections[block.settings.collection]

                if tile_image == blank and tile_collection != blank and tile_collection.featured_image

                  assign tile_image = tile_collection.featured_image

                endif



                case tile_handle

                  when 'dairy-eggs'

                    assign tile_bg = '#E3F2FD'

                  when 'bread-buns'

                    assign tile_bg = '#FBF0E6'

                  when 'paneer-tofu'

                    assign tile_bg = '#F0F0F0'

                  when 'cheese'

                    assign tile_bg = '#FFF8E1'

                  when 'eggs'

                    assign tile_bg = '#FCE8EC'

                  when 'fresh-fruits'

                    assign tile_bg = '#E8F5E9'

                  when 'vegetables'

                    assign tile_bg = '#EAF6EA'

                  when 'rice-grains'

                    assign tile_bg = '#FCE4EC'

                  when 'spices-masala'

                    assign tile_bg = '#FFF3E0'

                  when 'dals-pulses'

                    assign tile_bg = '#FFFDE7'

                  when 'atta-flours'

                    assign tile_bg = '#FBF0E6'

                  when 'household'

                    assign tile_bg = '#E3F2FD'

                  when 'indian-snacks'

                    assign tile_bg = '#FFF9C4'

                  when 'frozen-foods'

                    assign tile_bg = '#E8EAF6'

                  when 'beverages'

                    assign tile_bg = '#E1F5FE'

                  when 'top-deals'

                    assign tile_bg = '#FFF3E0'

                  else

                    assign pastel_cycle = 'E3F2FD,FBF0E6,F0F0F0,FFF8E1,FCE8EC,E8F5E9' | split: ','

                    assign pastel_idx = group_tile_index | minus: 1 | modulo: pastel_cycle.size

                    assign tile_bg = '#' | append: pastel_cycle[pastel_idx]

                endcase

              -%}

              <a

                href="{{ tile_link }}"

                class="kcl-tile"

                style="--kcl-tile-bg: {{ tile_bg }}"

                {{ block.shopify_attributes }}

              >

                <div class="kcl-tile__card">

                  {%- if tile_image != blank -%}

                    <img

                      src="{{ tile_image | image_url: width: 240 }}"

                      alt="{{ tile_title | escape }}"

                      class="kcl-tile__img"

                      width="120"

                      height="120"

                      loading="lazy"

                    >

                  {%- elsif tile_demo_url != blank -%}

                    <img

                      src="{{ tile_demo_url }}"

                      alt="{{ tile_title | escape }}"

                      class="kcl-tile__img"

                      width="120"

                      height="120"

                      loading="lazy"

                    >

                  {%- endif -%}

                </div>

                <span class="kcl-tile__name">{{ tile_title }}</span>

              </a>

              {%- if show_tile_view_all and group_tile_index == group_tile_count -%}

                <a href="{{ group_view_url }}" class="kcl-tile kcl-tile--view-all">

                  <div class="kcl-tile__card kcl-tile__card--view-all">

                    <span class="kcl-tile__view-all-text">View all</span>

                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">

                      <polyline points="9 18 15 12 9 6"></polyline>

                    </svg>

                  </div>

                </a>

              {%- endif -%}

            {%- endif -%}

        {%- endcase -%}

      {%- endfor -%}

      {%- if in_group -%}

              </div>

            </section>

      {%- endif -%}

    {%- else -%}

      <p class="kcl-empty">Add category groups and tiles in the theme editor.</p>

    {%- endif -%}

  </div>

</section>



<script>

  document.addEventListener('DOMContentLoaded', function() {

    const sectionWrap = document.getElementById('KCLPromo-{{ section.id }}');

    if (!sectionWrap) return;

    const carousel = sectionWrap.querySelector('.kcl-promo-carousel');

    const track = sectionWrap.querySelector('.kcl-promo-track');

    const dots = sectionWrap.querySelectorAll('.kcl-promo-dot');

    if (!carousel || !track || !dots.length) return;



    const slides = track.querySelectorAll('.kcl-promo-slide');

    const totalSlides = slides.length;

    let currentIndex = 0;

    let autoPlayTimer = null;

    let startX = 0;

    let isDragging = false;

    let hasMoved = false;



    function goToSlide(index) {

      if (index < 0) currentIndex = totalSlides - 1;

      else if (index >= totalSlides) currentIndex = 0;

      else currentIndex = index;



      track.style.transition = 'transform 0.45s cubic-bezier(0.25, 1, 0.5, 1)';

      track.style.transform = 'translateX(-' + (currentIndex * 100) + '%)';

      dots.forEach(function(dot, idx) {

        dot.classList.toggle('is-active', idx === currentIndex);

      });

    }



    function startAutoPlay() {

      stopAutoPlay();

      autoPlayTimer = setInterval(function() {

        goToSlide(currentIndex + 1);

      }, {{ section.settings.promo_autoplay_speed | default: 4 | times: 1000 }});

    }



    function stopAutoPlay() {

      if (autoPlayTimer) {

        clearInterval(autoPlayTimer);

        autoPlayTimer = null;

      }

    }



    dots.forEach(function(dot) {

      dot.addEventListener('click', function(e) {

        e.stopPropagation();

        stopAutoPlay();

        goToSlide(parseInt(dot.getAttribute('data-index'), 10));

        startAutoPlay();

      });

    });



    carousel.addEventListener('touchstart', function(e) {

      stopAutoPlay();

      startX = e.touches[0].clientX;

      isDragging = true;

      hasMoved = false;

    }, { passive: true });



    carousel.addEventListener('touchmove', function(e) {

      if (!isDragging) return;

      var diff = e.touches[0].clientX - startX;

      if (Math.abs(diff) > 5) hasMoved = true;

      track.style.transition = 'none';

      track.style.transform = 'translateX(calc(-' + (currentIndex * 100) + '% + ' + diff + 'px))';

    }, { passive: true });



    carousel.addEventListener('touchend', function(e) {

      if (!isDragging) return;

      isDragging = false;

      var diff = e.changedTouches[0].clientX - startX;

      if (diff < -50) goToSlide(currentIndex + 1);

      else if (diff > 50) goToSlide(currentIndex - 1);

      else goToSlide(currentIndex);

      startAutoPlay();

    });



    carousel.addEventListener('mouseenter', stopAutoPlay);

    carousel.addEventListener('mouseleave', startAutoPlay);



    {% if section.settings.promo_autoplay %}

      startAutoPlay();

    {% endif %}

  });

</script>



{% schema %}

{

  "name": "Categories landing",

  "tag": "section",

  "class": "section kcl-section",

  "settings": [

    {

      "type": "text",

      "id": "title",

      "label": "Page title",

      "default": "Categories"

    },

    {

      "type": "text",

      "id": "subtitle",

      "label": "Page subtitle",

      "default": "Browse all products by category"

    },

    {

      "type": "url",

      "id": "promo_link",

      "label": "Promo default link"

    },

    {

      "type": "image_picker",

      "id": "promo_image",

      "label": "Promo basket image"

    },

    {

      "type": "checkbox",

      "id": "promo_autoplay",

      "label": "Auto-rotate promo slides",

      "default": true

    },

    {

      "type": "range",

      "id": "promo_autoplay_speed",

      "min": 2,

      "max": 8,

      "step": 1,

      "unit": "s",

      "label": "Promo slide duration",

      "default": 4

    }

  ],

  "blocks": [

    {

      "type": "group",

      "name": "Group heading",

      "settings": [

        {

          "type": "text",

          "id": "title",

          "label": "Group title",

          "default": "Fresh & Dairy"

        }

      ]

    },

    {

      "type": "tile",

      "name": "Category tile",

      "settings": [

        {

          "type": "text",

          "id": "title",

          "label": "Tile label",

          "default": "Category"

        },

        {

          "type": "text",

          "id": "browse_handle",

          "label": "Browse handle",

          "info": "Must match a sidebar handle on the /collections browse page (e.g. fresh-fruits, dairy-eggs)."

        },

        {

          "type": "image_picker",

          "id": "image",

          "label": "Tile image"

        },

        {

          "type": "text",

          "id": "demo_image_url",

          "label": "Fallback image URL"

        },

        {

          "type": "collection",

          "id": "collection",

          "label": "Collection (optional image source)"

        }

      ]

    },

    {

      "type": "promo_slide",

      "name": "Promo slide",

      "limit": 5,

      "settings": [

        {

          "type": "text",

          "id": "headline_dark",

          "label": "Headline (dark)",

          "default": "Fresh essentials,"

        },

        {

          "type": "text",

          "id": "headline_green",

          "label": "Headline (green)",

          "default": "delivered to you"

        },

        {

          "type": "text",

          "id": "subtext",

          "label": "Subtext",

          "default": "Quality products at your doorstep"

        },

        {

          "type": "text",

          "id": "button_text",

          "label": "Button label",

          "default": "Shop Now"

        },

        {

          "type": "url",

          "id": "button_link",

          "label": "Button link"

        },

        {

          "type": "text",

          "id": "badge_text",

          "label": "Badge label (accessibility)",

          "default": "Up to 25 percent off"

        },

        {

          "type": "text",

          "id": "badge_percent",

          "label": "Badge percent",

          "default": "25%"

        },

        {

          "type": "image_picker",

          "id": "image",

          "label": "Basket image"

        }

      ]

    }

  ],

  "presets": [

    {

      "name": "Categories landing",

      "blocks": [

        { "type": "group", "settings": { "title": "Fresh & Dairy" } },

        { "type": "tile", "settings": { "title": "Milk", "browse_handle": "dairy-eggs", "demo_image_url": "https://images.unsplash.com/photo-1550583724-b2692b85b150?w=280&auto=format&fit=crop&q=80" } },

        { "type": "tile", "settings": { "title": "Bread and Buns", "browse_handle": "bread-buns", "demo_image_url": "https://images.unsplash.com/photo-1509440159596-0249088772ff?w=280&auto=format&fit=crop&q=80" } },

        { "type": "tile", "settings": { "title": "Paneer and Tofu", "browse_handle": "paneer-tofu", "demo_image_url": "https://images.unsplash.com/photo-1589301760014-d929f3979dbc?w=280&auto=format&fit=crop&q=80" } },

        { "type": "tile", "settings": { "title": "Cheese", "browse_handle": "cheese", "demo_image_url": "https://images.unsplash.com/photo-1624806992066-5ffcf7ca186b?w=280&auto=format&fit=crop&q=80" } },

        { "type": "tile", "settings": { "title": "Eggs", "browse_handle": "eggs", "demo_image_url": "https://images.unsplash.com/photo-1582722872445-44dc5f7e3c8f?w=280&auto=format&fit=crop&q=80" } },

        { "type": "tile", "settings": { "title": "Fresh Fruits", "browse_handle": "fresh-fruits", "demo_image_url": "https://images.unsplash.com/photo-1619566636858-adf3ef46400b?w=280&auto=format&fit=crop&q=80" } },

        { "type": "tile", "settings": { "title": "Vegetables", "browse_handle": "vegetables", "demo_image_url": "https://images.unsplash.com/photo-1540420773420-3366772f4999?w=280&auto=format&fit=crop&q=80" } },

        { "type": "group", "settings": { "title": "Grocery & Kitchen Essentials" } },

        { "type": "tile", "settings": { "title": "Rice & Grains", "browse_handle": "rice-grains", "demo_image_url": "https://images.unsplash.com/photo-1586201375761-83865001e31c?w=280&auto=format&fit=crop&q=80" } },

        { "type": "tile", "settings": { "title": "Spices & Masala", "browse_handle": "spices-masala", "demo_image_url": "https://images.unsplash.com/photo-1596040033229-a9821ebd058d?w=280&auto=format&fit=crop&q=80" } },

        { "type": "tile", "settings": { "title": "Dals & Pulses", "browse_handle": "dals-pulses", "demo_image_url": "https://images.unsplash.com/photo-1515543237350-b3eea1ec8082?w=280&auto=format&fit=crop&q=80" } },

        { "type": "tile", "settings": { "title": "Atta & Flours", "browse_handle": "atta-flours", "demo_image_url": "https://images.unsplash.com/photo-1509440159596-0249088772ff?w=280&auto=format&fit=crop&q=80" } },

        { "type": "tile", "settings": { "title": "Household", "browse_handle": "household", "demo_image_url": "https://images.unsplash.com/photo-1585421514284-efb74c2b69ba?w=280&auto=format&fit=crop&q=80" } },

        { "type": "group", "settings": { "title": "Snacks & Drinks" } },

        { "type": "tile", "settings": { "title": "Indian Snacks", "browse_handle": "indian-snacks", "demo_image_url": "https://images.unsplash.com/photo-1621447504864-d8686e12698c?w=280&auto=format&fit=crop&q=80" } },

        { "type": "tile", "settings": { "title": "Frozen Foods", "browse_handle": "frozen-foods", "demo_image_url": "https://images.unsplash.com/photo-1513104890138-7c749659a591?w=280&auto=format&fit=crop&q=80" } },

        { "type": "tile", "settings": { "title": "Beverages", "browse_handle": "beverages", "demo_image_url": "https://images.unsplash.com/photo-1544787219-7f47ccb76574?w=280&auto=format&fit=crop&q=80" } },

        { "type": "tile", "settings": { "title": "Top Deals", "browse_handle": "top-deals", "demo_image_url": "https://images.unsplash.com/photo-1607082348824-0a96f2a4b9da?w=280&auto=format&fit=crop&q=80" } }

      ]

    }

  ]

}

{% endschema %}

