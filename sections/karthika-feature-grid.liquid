{%- comment -%}
  Karthika Feature Grid — two-column grid of large tappable cards, many blocks so the page scrolls.
{%- endcomment -%}

<div class="karthika-feature-grid-wrap">
  {%- if section.settings.title != blank -%}
    <div class="karthika-section-head karthika-section-head--compact">
      <h2 class="karthika-section-head-title">{{ section.settings.title }}</h2>
      {%- if section.settings.link_text != blank -%}
        <a href="{{ section.settings.link | default: routes.collections_url }}" class="karthika-section-head-link">{{ section.settings.link_text }}</a>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="karthika-feature-grid">
    <a href="{{ routes.all_products_collection_url }}" class="karthika-feature-card karthika-feature-card--masala">
      <span class="karthika-feature-card-copy">
        <strong class="karthika-feature-card-label">Masala<br>Snacks</strong>
        <span class="karthika-feature-card-description">Spicy &amp; crunchy<br>favorites</span>
      </span>
      <span class="karthika-feature-card-arrow" aria-hidden="true">&#8594;</span>
      <img src="{{ 'masala-snacks.png' | asset_url }}" alt="Masala Snacks" class="karthika-feature-card-img" width="300" height="275" loading="lazy">
    </a>
    <a href="{{ routes.all_products_collection_url }}" class="karthika-feature-card karthika-feature-card--dairy">
      <span class="karthika-feature-card-copy">
        <strong class="karthika-feature-card-label">Dairy<br>Delights</strong>
        <span class="karthika-feature-card-description">Fresh &amp; pure<br>essentials</span>
      </span>
      <span class="karthika-feature-card-arrow" aria-hidden="true">&#8594;</span>
      <img src="{{ 'dairy-delights.png' | asset_url }}" alt="Dairy Delights" class="karthika-feature-card-img" width="300" height="275" loading="lazy">
    </a>
    <a href="{{ routes.all_products_collection_url }}" class="karthika-feature-card karthika-feature-card--home">
      <span class="karthika-feature-card-copy">
        <strong class="karthika-feature-card-label">Home<br>Essentials</strong>
        <span class="karthika-feature-card-description">Everything for<br>your home</span>
      </span>
      <span class="karthika-feature-card-arrow" aria-hidden="true">&#8594;</span>
      <img src="{{ 'home-essentials.png' | asset_url }}" alt="Home Essentials" class="karthika-feature-card-img" width="300" height="200" loading="lazy">
    </a>
  </div>
  <a href="{{ routes.all_products_collection_url }}" class="karthika-feature-banner">
    <img src="{{ 'raksha-bandhan-banner.png' | asset_url }}" alt="Gifts for the ones you love - Celebrate Raksha Bandhan" width="766" height="154" loading="lazy">
  </a>
</div>

{% schema %}
{
  "name": "Karthika Feature Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Section title" },
    { "type": "text", "id": "link_text", "label": "Link text", "default": "See all" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "feature_card",
      "name": "Card",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "demo_image_url", "label": "Demo image URL" },
        { "type": "color", "id": "bg_color", "label": "Background color", "default": "#EAF4DE" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Karthika Feature Grid",
      "blocks": [
        { "type": "feature_card", "settings": { "title": "Onam specials", "bg_color": "#EAF4DE", "demo_image_url": "https://images.unsplash.com/photo-1596040033229-a9821ebd058d?auto=format&fit=crop&w=300&q=80" } },
        { "type": "feature_card", "settings": { "title": "Sadya & payasam", "bg_color": "#FFF6DC", "demo_image_url": "https://images.unsplash.com/photo-1606491956689-2ea866880c84?auto=format&fit=crop&w=300&q=80" } },
        { "type": "feature_card", "settings": { "title": "Pookkalam & celebration", "bg_color": "#FCEAEA", "demo_image_url": "https://images.unsplash.com/photo-1600684646107-cd777b111b70?auto=format&fit=crop&w=300&q=80" } },
        { "type": "feature_card", "settings": { "title": "Glam up for the festival", "bg_color": "#EDEBFB", "demo_image_url": "https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?auto=format&fit=crop&w=300&q=80" } },
        { "type": "feature_card", "settings": { "title": "Fresh vegetables", "bg_color": "#E7EEDA", "demo_image_url": "https://images.unsplash.com/photo-1518843875459-f738682238a6?auto=format&fit=crop&w=300&q=80" } },
        { "type": "feature_card", "settings": { "title": "Kerala snacks", "bg_color": "#FFEDA8", "demo_image_url": "https://images.unsplash.com/photo-1601050690597-df0568f70950?auto=format&fit=crop&w=300&q=80" } },
        { "type": "feature_card", "settings": { "title": "Dairy delights", "bg_color": "#EAF4DE", "demo_image_url": "https://images.unsplash.com/photo-1550583724-b2692b85b150?auto=format&fit=crop&w=300&q=80" } },
        { "type": "feature_card", "settings": { "title": "Home essentials", "bg_color": "#FCEAEA", "demo_image_url": "https://images.unsplash.com/photo-1583947215259-38e31be8751f?auto=format&fit=crop&w=300&q=80" } }
      ]
    }
  ]
}
{% endschema %}
