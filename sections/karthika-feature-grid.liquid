{%- comment -%}
  Karthika Feature Grid — tappable cards that navigate to configured collections.
{%- endcomment -%}

{%- assign visible_cards = 0 -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'feature_card' -%}
    {%- if block.settings.collection != blank or block.settings.link != blank -%}
      {%- assign visible_cards = visible_cards | plus: 1 -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}

{%- if visible_cards > 0 or request.design_mode -%}
  <div class="karthika-feature-grid-wrap">
    {%- if section.settings.title != blank -%}
      <div class="karthika-section-head karthika-section-head--compact">
        <h2 class="karthika-section-head-title">{{ section.settings.title }}</h2>
        {%- if section.settings.link_text != blank -%}
          <a href="{{ section.settings.link | default: routes.collections_url }}" class="karthika-section-head-link">{{ section.settings.link_text }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if visible_cards > 0 -%}
      <div class="karthika-feature-grid">
        {%- assign card_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'feature_card' -%}
            {%- liquid
              assign card_collection = block.settings.collection
              assign card_url = blank
              assign card_title = block.settings.title
              if card_collection != blank
                assign card_url = card_collection.url
                if card_title == blank
                  assign card_title = card_collection.title
                endif
              elsif block.settings.link != blank
                assign card_url = block.settings.link
              endif
              assign variant_class = 'karthika-feature-card--home'
              assign remainder = card_index | modulo: 3
              if remainder == 0
                assign variant_class = 'karthika-feature-card--masala'
              elsif remainder == 1
                assign variant_class = 'karthika-feature-card--dairy'
              endif
            -%}
            {%- if card_url != blank -%}
              {%- assign card_index = card_index | plus: 1 -%}
              <a href="{{ card_url }}" class="karthika-feature-card {{ variant_class }}" {{ block.shopify_attributes }}>
                <span class="karthika-feature-card-copy">
                  <strong class="karthika-feature-card-label">{{ card_title | escape }}</strong>
                </span>
                <span class="karthika-feature-card-arrow" aria-hidden="true">&#8594;</span>
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 300 }}" alt="{{ card_title | escape }}" class="karthika-feature-card-img" width="300" height="275" loading="lazy">
                {%- elsif card_collection != blank and card_collection.featured_image -%}
                  <img src="{{ card_collection.featured_image | image_url: width: 300 }}" alt="{{ card_title | escape }}" class="karthika-feature-card-img" width="300" height="275" loading="lazy">
                {%- endif -%}
              </a>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- elsif request.design_mode -%}
      <p class="karthika-empty-state">Select a collection on each feature card in the theme editor.</p>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Karthika Feature Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Section title" },
    { "type": "text", "id": "link_text", "label": "Link text", "default": "See all" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "feature_card",
      "name": "Card",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "color", "id": "bg_color", "label": "Background color", "default": "#EAF4DE" },
        { "type": "collection", "id": "collection", "label": "Collection", "info": "Required on the storefront. The card is hidden until a collection or custom link is set." },
        { "type": "url", "id": "link", "label": "Custom link", "info": "Used only when no collection is selected." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Karthika Feature Grid",
      "blocks": [
        { "type": "feature_card", "settings": { "title": "Masala snacks", "bg_color": "#EAF4DE" } },
        { "type": "feature_card", "settings": { "title": "Dairy delights", "bg_color": "#EAF4DE" } },
        { "type": "feature_card", "settings": { "title": "Home essentials", "bg_color": "#FCEAEA" } }
      ]
    }
  ]
}
{% endschema %}
