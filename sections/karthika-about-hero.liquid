<section class="karthika-about-hero">
  <div class="karthika-about-hero__inner">
    <div class="karthika-about-hero__content">
      <p class="karthika-about-hero__eyebrow">ABOUT KARTHIKA</p>
      <h1>Fresh groceries.<br>Familiar flavours.<br>Delivered with care.</h1>
      <p class="karthika-about-hero__text">
        Karthika brings everyday groceries, Kerala favourites, fresh produce and household essentials together in one simple shopping experience.
      </p>

      <div class="karthika-about-hero__actions">
        <a class="karthika-button karthika-button--primary" href="{{ routes.all_products_collection_url }}">Shop Now <span aria-hidden="true">→</span></a>
        <a class="karthika-button karthika-button--secondary" href="{{ routes.collections_url }}">Explore Categories</a>
      </div>
    </div>

    <div class="karthika-about-hero__media">
      {% assign hero_image = section.settings.image %}
      {% if hero_image != blank %}
        {{ hero_image | image_url: width: 1200 | image_tag: loading: 'eager', widths: '500,700,900,1200', sizes: '(min-width: 1200px) 52vw, 100vw', alt: 'Fresh Karthika groceries and produce' }}
      {% else %}
        <img
          src="https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=1200&q=80"
          alt="Fresh Karthika groceries and produce"
          width="1200"
          height="1000"
          loading="eager"
        >
      {% endif %}
    </div>
  </div>

  <style>
    .karthika-about-hero {
      background: var(--karthika-bg-body);
      color: var(--karthika-text-dark);
      padding: 32px 0 8px;
    }

    .karthika-about-hero__inner {
      width: min(1280px, calc(100% - 64px));
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1.02fr 0.98fr;
      align-items: center;
      gap: clamp(28px, 5vw, 64px);
      background: #fff;
      border: 1px solid var(--karthika-border);
      border-radius: var(--karthika-radius-hero);
      overflow: hidden;
    }

    .karthika-about-hero__content {
      padding: clamp(32px, 5vw, 70px) clamp(24px, 4vw, 62px);
    }

    .karthika-about-hero__eyebrow {
      margin: 0 0 18px;
      color: var(--karthika-red);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .karthika-about-hero__content h1 {
      margin: 0;
      font-size: clamp(2.5rem, 4vw, 5rem);
      line-height: 0.98;
      letter-spacing: -0.07em;
      font-weight: 800;
      color: var(--karthika-text-dark);
    }

    .karthika-about-hero__text {
      max-width: 560px;
      margin: 22px 0 0;
      color: var(--karthika-text-muted);
      font-size: 1.06rem;
      line-height: 1.7;
    }

    .karthika-about-hero__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      margin-top: 32px;
    }

    .karthika-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 52px;
      padding: 0 28px;
      border-radius: var(--karthika-radius-btn);
      border: 1px solid transparent;
      font-size: 0.96rem;
      font-weight: 700;
      text-decoration: none;
      transition: transform 0.2s ease, filter 0.2s ease;
      cursor: pointer;
    }

    .karthika-button:hover {
      transform: translateY(-1px);
      filter: brightness(0.98);
    }

    .karthika-button--primary {
      background: var(--karthika-red);
      color: #fff;
      box-shadow: var(--karthika-shadow-subtle);
    }

    .karthika-button--secondary {
      background: #fff;
      border-color: var(--karthika-border);
      color: var(--karthika-text-dark);
    }

    .karthika-about-hero__media {
      position: relative;
      min-height: 560px;
      background: var(--karthika-bg-card-img);
    }

    .karthika-about-hero__media img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    @media screen and (max-width: 1180px) {
      .karthika-about-hero__inner {
        grid-template-columns: 1fr 1fr;
      }
    }

    @media screen and (max-width: 768px) {
      .karthika-about-hero {
        padding-top: 20px;
      }

      .karthika-about-hero__inner {
        width: min(100%, calc(100% - 24px));
        grid-template-columns: 1fr;
      }

      .karthika-about-hero__content {
        padding: 28px 20px 8px;
      }

      .karthika-about-hero__media {
        min-height: 320px;
      }

      .karthika-about-hero__actions {
        flex-direction: column;
        align-items: stretch;
      }

      .karthika-button {
        width: 100%;
      }
    }
  </style>
</section>

{% schema %}
{
  "name": "Karthika About Hero",
  "tag": "section",
  "class": "karthika-about-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    }
  ],
  "presets": [
    {
      "name": "Karthika About Hero"
    }
  ]
}
{% endschema %}
