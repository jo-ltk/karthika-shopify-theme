{%- comment -%}
  Renders the segmented switcher: [ Items ] [ Shop ]
  Height: 48px, Radius: 14px, white active surface with Karthika Red text and subtle shadow.
{%- endcomment -%}

<div class="karthika-segmented-wrapper">
  <div class="karthika-segmented-control" aria-label="Catalog view">
    <span class="karthika-segmented-btn is-active" aria-current="page">Items</span>
    <a href="{{ routes.collections_url }}" class="karthika-segmented-btn">Shop</a>
  </div>
</div>

{% schema %}
{
  "name": "Items / Shop Switcher",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "Items / Shop Switcher"
    }
  ]
}
{% endschema %}
