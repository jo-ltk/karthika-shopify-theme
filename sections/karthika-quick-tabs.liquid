{%- comment -%}
  Karthika Category Carousel — single horizontal scrollable row below the search bar.
  All 16 categories in ONE ROW. Users swipe left/right to browse.
  Images served from Shopify Admin → Content → Files via the file_url filter.
  No CDN URLs hardcoded. Do NOT move these images into the theme assets folder.
{%- endcomment -%}

{%- comment -%}
  Static 16-entry category data.
  Format: title||webp_filename||cat_param
  cat_param is the ?cat= handle used by the Collections page (/collections?cat=<param>).
  These handles match the product-type handles defined in main-list-collections.liquid.
  Home uses the all-products URL instead of a ?cat= param.
{%- endcomment -%}
{%- assign _cats_raw = "Home||karthika-cat-home.webp||__all__,Baby & Child||karthika-cat-baby-child.webp||baby-care,Baking||karthika-cat-baking.webp||flour,Beverages||karthika-cat-beverages.webp||soft-drinks,Personal Care||karthika-cat-personal-care.webp||bodycare,Confectioneries||karthika-cat-confectioneries.webp||chocolates-sweets,Dairy||karthika-cat-dairy.webp||ghee,Frozen||karthika-cat-frozen.webp||ice-cream,Fruit & Veg||karthika-cat-fruit-vegetables.webp||vegetables,Rice||karthika-cat-rice.webp||basmati,Groceries||karthika-cat-groceries.webp||grains-pulses,Household||karthika-cat-household.webp||detergents,Kitchen||karthika-cat-kitchen.webp||tawa-kadai-pan,Pharmacy||karthika-cat-pharmacy.webp||ayurveda-medicine,Pooja Items||karthika-cat-pooja-items.webp||agarbathi,Manufacturer||karthika-cat-manufacturer.webp||brass" | split: "," -%}

<section
  class="kcg-section"
  id="KCG-{{ section.id }}"
  aria-labelledby="kcg-title-{{ section.id }}"
>
  <div class="kcg-header">
    <h2 class="kcg-title" id="kcg-title-{{ section.id }}">
      {{- section.settings.title | default: 'Shop by Category' -}}
    </h2>
    {%- if section.settings.subtitle != blank or section.settings.subtitle == blank -%}
      <p class="kcg-subtitle">
        {{- section.settings.subtitle | default: 'Everything you need, all in one place' -}}
      </p>
    {%- endif -%}
  </div>

  <div class="kcg-scroll" role="list" aria-label="{{ section.settings.title | default: 'Shop by Category' | escape }}">
    {%- for _cat_entry in _cats_raw -%}
      {%- assign _parts  = _cat_entry | split: "||" -%}
      {%- assign _title  = _parts[0] -%}
      {%- assign _file   = _parts[1] -%}
      {%- assign _handle = _parts[2] -%}

      {%- comment -%}
        Build the URL using the same ?cat= mechanism as the Collections page.
        __all__ is a sentinel for Home → all products URL.
        All other handles become /collections?cat=<handle>.
      {%- endcomment -%}
      {%- if _handle == '__all__' -%}
        {%- assign _url = routes.all_products_collection_url -%}
      {%- else -%}
        {%- assign _url = routes.collections_url | append: '?cat=' | append: _handle -%}
      {%- endif -%}

      {%- comment -%} Active state: match against the current ?cat= param on the collections page {%- endcomment -%}
      {%- assign _active = false -%}
      {%- if template.name == 'list-collections' -%}
        {%- assign _req_cat = request.path | split: '?' | last -%}
        {%- if _handle != '__all__' and _req_cat contains _handle -%}
          {%- assign _active = true -%}
        {%- elsif _handle == '__all__' and request.path == routes.all_products_collection_url -%}
          {%- assign _active = true -%}
        {%- endif -%}
      {%- endif -%}

      <a
        href="{{ _url }}"
        class="kcg-item{% if _active %} kcg-item--active{% endif %}"
        aria-label="{{ _title | escape }}"
        {% if _active %}aria-current="page"{% endif %}
        role="listitem"
      >
        <span class="kcg-icon">
          <img
            src="{{ _file | file_url }}"
            alt=""
            width="72"
            height="72"
            loading="lazy"
            draggable="false"
          >
        </span>
        <span class="kcg-label">{{ _title }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Karthika Cat Carousel",
  "tag": "section",
  "class": "section karthika-quick-tabs-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Section subtitle",
      "default": "Everything you need, all in one place"
    }
  ],
  "blocks": [
    {
      "type": "tab_item",
      "name": "Tab Item",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Category"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "default": "🛒"
        },
        {
          "type": "text",
          "id": "collection",
          "label": "Collection title"
        },
        {
          "type": "text",
          "id": "collection_handle",
          "label": "Collection handle"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Karthika Cat Carousel"
    }
  ]
}
{% endschema %}
