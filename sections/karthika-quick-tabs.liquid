{%- comment -%}
  Karthika Category Carousel — single horizontal scrollable row below the search bar.
  All 16 categories in ONE ROW. Users swipe left/right to browse.
  Images served from Shopify Admin → Content → Files via the file_url filter.
  No CDN URLs hardcoded. Do NOT move these images into the theme assets folder.
{%- endcomment -%}

{%- comment -%}
  Static 16-entry category data.
  Format: title||webp_filename||collection_handle
{%- endcomment -%}
{%- assign _cats_raw = "Home||karthika-cat-home.webp||all,Baby & Child||karthika-cat-baby-child.webp||baby-child,Baking||karthika-cat-baking.webp||baking,Beverages||karthika-cat-beverages.webp||beverages,Personal Care||karthika-cat-personal-care.webp||personal-care,Confectioneries||karthika-cat-confectioneries.webp||confectioneries,Dairy||karthika-cat-dairy.webp||dairy-eggs,Frozen||karthika-cat-frozen.webp||frozen-foods,Fruit & Veg||karthika-cat-fruit-vegetables.webp||fresh-fruits,Rice||karthika-cat-rice.webp||rice-grains,Groceries||karthika-cat-groceries.webp||groceries,Household||karthika-cat-household.webp||household,Kitchen||karthika-cat-kitchen.webp||kitchen,Pharmacy||karthika-cat-pharmacy.webp||pharmacy,Pooja Items||karthika-cat-pooja-items.webp||pooja-items,Manufacturer||karthika-cat-manufacturer.webp||manufacturer" | split: "," -%}

<section
  class="kcg-section"
  id="KCG-{{ section.id }}"
  aria-labelledby="kcg-title-{{ section.id }}"
>
  <div class="kcg-header">
    <h2 class="kcg-title" id="kcg-title-{{ section.id }}">
      {{- section.settings.title | default: 'Shop by Category' -}}
    </h2>
    {%- if section.settings.subtitle != blank or section.settings.subtitle == blank -%}
      <p class="kcg-subtitle">
        {{- section.settings.subtitle | default: 'Everything you need, all in one place' -}}
      </p>
    {%- endif -%}
  </div>

  <div class="kcg-scroll" role="list" aria-label="{{ section.settings.title | default: 'Shop by Category' | escape }}">
    {%- for _cat_entry in _cats_raw -%}
      {%- assign _parts  = _cat_entry | split: "||" -%}
      {%- assign _title  = _parts[0] -%}
      {%- assign _file   = _parts[1] -%}
      {%- assign _handle = _parts[2] -%}

      {%- comment -%} Resolve URL from live collection object, with /collections/<handle> fallback {%- endcomment -%}
      {%- assign _col = collections[_handle] -%}
      {%- if _col != blank and _col.url != blank -%}
        {%- assign _url = _col.url -%}
      {%- elsif _handle == 'all' -%}
        {%- assign _url = routes.all_products_collection_url -%}
      {%- else -%}
        {%- assign _url = routes.collections_url | append: '/' | append: _handle -%}
      {%- endif -%}

      {%- comment -%} Active state when browsing a matching collection {%- endcomment -%}
      {%- assign _active = false -%}
      {%- if template.name == 'collection' and collection -%}
        {%- if collection.handle == _handle -%}
          {%- assign _active = true -%}
        {%- elsif _handle == 'all' and collection.handle == 'all' -%}
          {%- assign _active = true -%}
        {%- endif -%}
      {%- endif -%}

      <a
        href="{{ _url }}"
        class="kcg-item{% if _active %} kcg-item--active{% endif %}"
        aria-label="{{ _title | escape }}"
        {% if _active %}aria-current="page"{% endif %}
        role="listitem"
      >
        <span class="kcg-icon">
          <img
            src="{{ _file | file_url }}"
            alt=""
            width="72"
            height="72"
            loading="lazy"
            draggable="false"
          >
        </span>
        <span class="kcg-label">{{ _title }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Karthika Cat Carousel",
  "tag": "section",
  "class": "section karthika-quick-tabs-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Section subtitle",
      "default": "Everything you need, all in one place"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Karthika Cat Carousel"
    }
  ]
}
{% endschema %}
