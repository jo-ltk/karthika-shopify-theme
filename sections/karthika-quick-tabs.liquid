{%- comment -%}
  Karthika Quick Tabs — horizontal collection shortcuts under homepage search.
{%- endcomment -%}

{%- assign visible_tabs = 0 -%}
{%- for block in section.blocks -%}
  {%- liquid
    assign tab_url = blank
    assign tab_collection = block.settings.collection
    if tab_collection != blank and tab_collection.url != blank
      assign tab_url = tab_collection.url
    elsif block.settings.link_all_products
      assign tab_url = routes.all_products_collection_url
    endif
  -%}
  {%- if tab_url != blank -%}
    {%- assign visible_tabs = visible_tabs | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

{%- if visible_tabs > 0 or request.design_mode -%}
  <nav
    class="karthika-quick-tabs"
    id="KarthikaQuickTabs-{{ section.id }}"
    aria-label="{{ section.settings.title | default: 'Shop by category' | escape }}"
  >
    {%- for block in section.blocks -%}
      {%- liquid
        assign tab_url = blank
        assign tab_collection = block.settings.collection
        assign tab_label = block.settings.label | strip
        assign tab_image = block.settings.image

        if tab_collection != blank and tab_collection.url != blank
          assign tab_url = tab_collection.url
          if tab_label == blank
            assign tab_label = tab_collection.title
          endif
          if tab_image == blank and tab_collection.image
            assign tab_image = tab_collection.image
          endif
        elsif block.settings.link_all_products
          assign tab_url = routes.all_products_collection_url
          if tab_label == blank
            assign tab_label = 'All'
          endif
        endif

        assign tab_active = false
        if template.name == 'collection' and collection
          if tab_collection != blank and collection.handle == tab_collection.handle
            assign tab_active = true
          elsif block.settings.link_all_products and collection.handle == 'all'
            assign tab_active = true
          endif
        endif
      -%}
      {%- if tab_url != blank -%}
        <a
          href="{{ tab_url }}"
          class="karthika-quick-tab{% if tab_active %} is-active{% endif %}"
          {% if tab_active %}aria-current="page"{% endif %}
          {{ block.shopify_attributes }}
        >
          <span class="karthika-quick-tab-icon" aria-hidden="true">
            {%- if tab_image != blank -%}
              <img
                src="{{ tab_image | image_url: width: 96 }}"
                alt=""
                width="28"
                height="28"
                loading="lazy"
              >
            {%- else -%}
              {{ block.settings.icon | default: '🛒' }}
            {%- endif -%}
          </span>
          <span class="karthika-quick-tab-label">{{ tab_label | default: 'Category' | escape }}</span>
        </a>
      {%- elsif request.design_mode -%}
        <span class="karthika-quick-tab is-unconfigured" {{ block.shopify_attributes }}>
          <span class="karthika-quick-tab-icon" aria-hidden="true">{{ block.settings.icon | default: '🛒' }}</span>
          <span class="karthika-quick-tab-label">{{ tab_label | default: 'Select a collection' | escape }}</span>
        </span>
      {%- endif -%}
    {%- endfor -%}
  </nav>
{%- endif -%}

{% schema %}
{
  "name": "Karthika Quick Tabs",
  "tag": "section",
  "class": "section karthika-quick-tabs-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Accessible title",
      "default": "Shop by category"
    }
  ],
  "blocks": [
    {
      "type": "tab_item",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "info": "Optional. Defaults to the collection title." },
        { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "🛒", "info": "Used when no image or collection image is available." },
        { "type": "image_picker", "id": "image", "label": "Icon image (optional, overrides collection image)" },
        {
          "type": "checkbox",
          "id": "link_all_products",
          "label": "Link to all products",
          "default": false,
          "info": "Use for the All tab. Ignored when a collection is selected."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Required for category tabs. Unconfigured tabs are hidden on the storefront."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Karthika Quick Tabs",
      "blocks": [
        { "type": "tab_item", "settings": { "label": "All", "icon": "🛍️", "link_all_products": true } },
        { "type": "tab_item", "settings": { "label": "Rice", "icon": "🍚", "collection": "rice-grains" } },
        { "type": "tab_item", "settings": { "label": "Spices", "icon": "🌶️", "collection": "spices-masala" } },
        { "type": "tab_item", "settings": { "label": "Snacks", "icon": "🍪", "collection": "indian-snacks" } },
        { "type": "tab_item", "settings": { "label": "Beverages", "icon": "🥤", "collection": "beverages" } },
        { "type": "tab_item", "settings": { "label": "Dairy", "icon": "🥛", "collection": "dairy-eggs" } }
      ]
    }
  ]
}
{% endschema %}
