{%- liquid
  assign products_collection = section.settings.products_collection | default: collections.all
  assign category_handles = 'fresh-fruits,vegetables,rice-grains,spices-masala,kerala-favourites,indian-snacks,dairy-eggs,beverages' | split: ','
  assign products_url = routes.all_products_collection_url
  if products_collection != blank and products_collection.url != blank
    assign products_url = products_collection.url
  endif
-%}
<div class="karthika-home-desktop karthika-home-tablet kd-home">
  <main>
    <section class="kd-hero-outer kd-container">
      <div class="kd-hero">
        <div class="kd-hero-copy">
          <span class="kd-pill">Freshness, every day</span>
          <h1>GROCERIES<br>THAT FEEL<br><em>LIKE HOME.</em></h1>
          <p>Everyday essentials, Kerala favourites, and market-fresh produce delivered with care.</p>

          <div class="kd-hero-buttons">
            <a class="kd-button red" href="{{ routes.all_products_collection_url }}">Shop Now &rarr;</a>
            <a class="kd-button outline" href="{{ routes.collections_url }}">Explore Categories</a>
          </div>

          <div class="kd-hero-badges">
            <div class="kd-badge">
              <span class="kd-badge-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 21c-2-6 1-13 12-15-1 8-5 12-9 13"/><path d="M8 19c2-4 4-7 9-11"/></svg></span>
              <span>Fresh &amp; Quality<br><small>Carefully sourced</small></span>
            </div>
            <div class="kd-badge">
              <span class="kd-badge-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 3h13v13H1z"/><path d="M14 8h4l4 4v4h-8z"/><circle cx="5.5" cy="18.5" r="1.8"/><circle cx="17.5" cy="18.5" r="1.8"/></svg></span>
              <span>Fast Delivery<br><small>On-time, every time</small></span>
            </div>
            <div class="kd-badge">
              <span class="kd-badge-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2l8 3.5v6c0 5-3.4 8.7-8 10.5-4.6-1.8-8-5.5-8-10.5v-6z"/><path d="M9 12l2 2 4-4"/></svg></span>
              <span>Secure Payments<br><small>100% safe &amp; trusted</small></span>
            </div>
            <div class="kd-badge">
              <span class="kd-badge-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 15v-3a8 8 0 0 1 16 0v3"/><path d="M4 15a2 2 0 0 1 2-2h1v5H6a2 2 0 0 1-2-2z"/><path d="M20 15a2 2 0 0 0-2-2h-1v5h1a2 2 0 0 0 2-2z"/></svg></span>
              <span>24/7 Support<br><small>We're here to help</small></span>
            </div>
          </div>
        </div>
        <figure>
          <img src="https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=1400&q=88" alt="Fresh produce and groceries" width="700" height="610" loading="eager">
          <figcaption>
            <span class="kd-fig-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 21c-2-6 1-13 12-15-1 8-5 12-9 13"/><path d="M8 19c2-4 4-7 9-11"/></svg></span>
            Market fresh<br>to your door
            <span class="kd-fig-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="kd-section kd-category-section kd-container" aria-labelledby="kd-category-title">
      <div class="kd-section-heading"><h2 id="kd-category-title">Shop by category</h2><a href="{{ routes.collections_url }}">See all</a></div>
      <div class="kd-category-row">
        <a class="kd-category kd-category--masala" href="{{ routes.all_products_collection_url }}">
          <strong>Masala<br>Snacks</strong><span>Spicy &amp; crunchy<br>favorites</span><i aria-hidden="true">&#8594;</i><img src="{{ 'masala-snacks.png' | asset_url }}" alt="Masala Snacks" width="300" height="275" loading="lazy">
        </a>
        <a class="kd-category kd-category--dairy" href="{{ routes.all_products_collection_url }}">
          <strong>Dairy<br>Delights</strong><span>Fresh &amp; pure<br>essentials</span><i aria-hidden="true">&#8594;</i><img src="{{ 'dairy-delights.png' | asset_url }}" alt="Dairy Delights" width="300" height="275" loading="lazy">
        </a>
        <a class="kd-category kd-category--home" href="{{ routes.all_products_collection_url }}">
          <strong>Home<br>Essentials</strong><span>Everything for<br>your home</span><i aria-hidden="true">&#8594;</i><img src="{{ 'home-essentials.png' | asset_url }}" alt="Home Essentials" width="300" height="200" loading="lazy">
        </a>
      </div>
    </section>

    <section class="kd-promo kd-container" aria-label="Weekend deals">
      <div><span class="kd-promo-kicker">Weekend deals</span><h2>Save more on your everyday groceries</h2><p>Up to 30% off selected groceries and top brands.</p></div>
      <a class="kd-button yellow" href="{{ products_url }}?sort_by=best-selling">Shop offers &rarr;</a>
    </section>

    {%- assign desktop_sections = 'Popular this week|Fresh picks and customer favourites,Todays deals|Daily fresh savings and discounts,Kerala favourites|Authentic flavours from home' | split: ',' -%}
    {%- for section_data in desktop_sections -%}
      {%- assign section_parts = section_data | split: '|' -%}
      {%- assign section_offset = forloop.index0 | times: 6 -%}
      <section class="kd-section kd-products-section kd-container" aria-labelledby="kd-products-{{ forloop.index }}">
        <div class="kd-section-heading"><div><h2 id="kd-products-{{ forloop.index }}">{{ section_parts[0] }}</h2><p>{{ section_parts[1] }}</p></div><a href="{{ products_url }}">See all</a></div>
        {%- if products_collection != blank and products_collection.products_count > 0 -%}
          <div class="kd-product-grid">
            {%- for product in products_collection.products offset: section_offset limit: 6 -%}
              {% render 'karthika-card-product', card_product: product, section_id: section.id %}
            {%- endfor -%}
          </div>
        {%- else -%}
          <div class="kd-empty"><p>No products are available in this collection yet.</p><a href="{{ routes.all_products_collection_url }}">Browse all products</a></div>
        {%- endif -%}
      </section>
    {%- endfor -%}

  </main>
</div>

<style>
 .karthika-desktop-home-section { display: none; }
@media(min-width:769px){
:root{--kd-red:#b40000;--kd-yellow:#ffd200;--kd-bg:#f7f7f5;--kd-max:1600px}
body:has(.kd-home){background:var(--kd-bg)}
#MainContent.karthika-app-container:has(.kd-home){max-width:none;width:100vw;margin:0;padding:0;background:transparent;border:0;border-radius:0;box-shadow:none}
.karthika-desktop-home-section{display:block}
body:has(.kd-home) .karthika-desktop-home-section ~ .shopify-section{display:none!important;visibility:hidden!important}
.kd-home{width:100vw;margin-left:0;font-family:'Gilroy',sans-serif;color:#111}
.kd-home h1,.kd-home h2,.kd-home h3,.kd-home h4,.kd-home h5,.kd-home h6{font-family:inherit}

/* Shared capped container: keeps content readable and centered on any screen width */
.kd-container{width:100%;max-width:var(--kd-max);margin:0 auto;padding:0 clamp(20px,3vw,40px);box-sizing:border-box}

/* Top utility bar (full-bleed strip, capped inner content) */
.kd-topbar{background:#f0efe9;border-bottom:1px solid #e4e2da}
.kd-topbar .kd-container{display:flex;align-items:center;justify-content:space-between;gap:24px;height:42px}
.kd-topbar-item{display:flex;align-items:center;gap:7px;font-size:12.5px;color:#4a4a45;white-space:nowrap}
.kd-topbar-item svg{width:15px;height:15px;flex:none}
.kd-topbar-location b{color:#111;font-weight:700}
.kd-chevron{width:12px!important;height:12px!important;margin-left:1px}
.kd-topbar-links{display:flex;align-items:center;gap:22px}
.kd-topbar-links a{display:flex;align-items:center;gap:6px;font-size:12.5px;font-weight:600;color:#111;text-decoration:none}
.kd-topbar-links svg{width:15px;height:15px}

/* Header (full-bleed strip, capped inner content) */
.kd-header-bar{background:#fff;border-bottom:1px solid #eeece5}
.kd-header{height:92px;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:clamp(16px,2vw,28px)}
.kd-logo{font-size:23px;font-weight:700;color:var(--kd-red);text-decoration:none;white-space:nowrap}
.kd-logo span{color:var(--kd-yellow)}
.kd-header nav{display:flex;align-items:center;gap:clamp(16px,2vw,30px);justify-self:center}
.kd-header nav a{position:relative;font-size:13.5px;font-weight:600;color:#111;text-decoration:none;padding-bottom:6px;white-space:nowrap}
.kd-header nav a.kd-nav-active:after{content:'';position:absolute;left:0;right:0;bottom:0;height:2px;background:var(--kd-red)}
.kd-actions{display:flex;align-items:center;gap:clamp(10px,1.4vw,16px);justify-self:end}
.kd-searchbar{display:flex;align-items:center;gap:8px;width:clamp(190px,15vw,270px);height:44px;padding:0 8px 0 18px;border:1px solid #e2e0d8;border-radius:999px;background:#f7f7f5}
.kd-searchbar input{flex:1;min-width:0;border:0;background:transparent;font:400 13px 'Gilroy',sans-serif;outline:0}
.kd-searchbar input::placeholder{color:#9a9890}
.kd-searchbar button{display:grid;place-items:center;width:32px;height:32px;flex:none;border:0;border-radius:50%;background:var(--kd-red);color:#fff;cursor:pointer}
.kd-searchbar button svg{width:15px;height:15px}
.kd-button{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:0 clamp(16px,1.6vw,24px);border-radius:999px;font-size:13.5px;font-weight:600;text-decoration:none;transition:.2s;border:1px solid transparent;white-space:nowrap}
.kd-button:hover{transform:translateY(-2px);filter:brightness(.96)}
.red{background:var(--kd-red);color:#fff}
.yellow{background:var(--kd-yellow);color:#111}
.outline{background:transparent;color:var(--kd-red);border-color:#f0c9c9}
.kd-cart{position:relative;display:flex;align-items:center;padding:0;color:#111;text-decoration:none}
.kd-cart svg{width:24px;height:24px}
.kd-cart .karthika-cart-badge{display:inline-flex!important;position:absolute;top:-6px;right:-8px;align-items:center;justify-content:center;min-width:18px;height:18px;padding:0 5px;border-radius:999px;background:var(--kd-yellow);color:#111;font-size:10px;font-weight:700}
.kd-account{display:flex;align-items:center;gap:7px;color:#111;text-decoration:none;font-size:13.5px;font-weight:600;white-space:nowrap}
.kd-account svg{width:22px;height:22px}

/* Hero: capped + centered like a card, so wide screens don't blow the columns out */
.kd-hero-outer{padding:clamp(20px,3vw,36px) clamp(20px,3vw,40px)}
.kd-hero{display:grid;grid-template-columns:1fr 1fr;align-items:stretch;min-height:clamp(440px,52vw,560px);overflow:hidden;border-radius:28px;background:#fff;box-shadow:0 1px 3px rgba(17,17,17,.05)}
.kd-hero-copy{display:flex;flex-direction:column;justify-content:center;padding:clamp(32px,4vw,56px);min-width:0}
.kd-pill{display:inline-block;padding:7px 14px;border:1px solid #d6d4ce;border-radius:999px;font-size:11px;font-weight:600;text-transform:uppercase;width:fit-content}
.kd-hero h1{margin:22px 0 16px;font-size:clamp(38px,4vw,58px);line-height:1;font-weight:700}
.kd-hero em{color:var(--kd-red);font-style:normal}
.kd-hero p{max-width:390px;margin:0 0 26px;font-size:16px;line-height:1.45}
.kd-hero-buttons{display:flex;align-items:center;gap:14px;margin-bottom:36px;flex-wrap:wrap}
.kd-hero-badges{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px 26px;max-width:460px}
.kd-badge{display:flex;align-items:flex-start;gap:9px;font-size:12.5px;line-height:1.35;font-weight:600;color:#111}
.kd-badge small{font-weight:400;color:#6b6a64}
.kd-badge-icon{display:grid;place-items:center;width:30px;height:30px;flex:none;border-radius:50%;background:#f6ecd8;color:var(--kd-red)}
.kd-badge-icon svg{width:15px;height:15px}
.kd-hero figure{position:relative;margin:0;min-height:100%}
.kd-hero img{width:100%;height:100%;object-fit:cover;display:block}
.kd-hero figcaption{position:absolute;right:24px;bottom:24px;display:flex;align-items:center;gap:12px;padding:13px 17px;border-radius:16px;background:var(--kd-yellow);font-size:13px;font-weight:600;line-height:1.3}
.kd-fig-icon{display:grid;place-items:center;width:34px;height:34px;flex:none;border-radius:50%;background:rgba(0,0,0,.08)}
.kd-fig-icon svg{width:17px;height:17px}
.kd-fig-arrow{display:grid;place-items:center;width:34px;height:34px;flex:none;margin-left:6px;border-radius:50%;background:#fff}
.kd-fig-arrow svg{width:16px;height:16px}

.kd-section{padding-top:20px}.kd-section-heading{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:18px}.kd-section-heading h2{margin:0;font-size:24px;line-height:1.1}.kd-section-heading p{margin:6px 0 0;color:#777;font-size:13px}.kd-section-heading a{color:var(--kd-red);font-size:13px;font-weight:700;text-decoration:none;white-space:nowrap}.kd-category-row{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:16px}.kd-category{display:flex;flex-direction:column;align-items:center;gap:10px;color:#111;text-align:center;text-decoration:none}.kd-category img{width:100%;aspect-ratio:1;border-radius:50%;object-fit:cover;background:#eee}.kd-category strong{font-size:13px;line-height:1.2}.kd-promo{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-top:34px;padding-top:26px;padding-bottom:26px;border-radius:18px;background:#fff4d4}.kd-promo h2{margin:5px 0;font-size:22px}.kd-promo p{margin:0;color:#6c6658;font-size:13px}.kd-promo-kicker{color:var(--kd-red);font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.kd-products-section{padding-top:36px}.kd-product-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:16px}.kd-product-grid .karthika-compact-card{min-width:0;padding:0 0 12px;border:1px solid #e7e5df;border-radius:16px;background:#fff;overflow:hidden}.kd-product-grid .karthika-compact-media{height:auto;aspect-ratio:1.05;background:#f4f3ee}.kd-product-grid .karthika-compact-info{padding:13px}.kd-product-grid .karthika-compact-title{font-size:14px}.kd-product-grid .karthika-card-action-bar{margin-top:13px}.kd-product-grid .karthika-stepper-add-btn{border-radius:999px}.kd-empty{padding:22px 24px;border:1px dashed #d8d6ce;border-radius:14px;background:#fff;color:#6b6a64;font-size:13px}.kd-empty p{margin:0 0 8px}.kd-empty a{color:var(--kd-red);font-weight:700;text-decoration:none}.kd-bundle{display:flex;align-items:center;gap:30px;margin-top:38px;margin-bottom:50px;padding-top:25px;padding-bottom:25px;border:1px solid #ebe7d8;border-radius:18px;background:#fffdf2}.kd-bundle-copy{flex:1}.kd-bundle h2{margin:5px 0;font-size:22px}.kd-bundle p{margin:0;color:#6b6a64;font-size:13px}.kd-bundle-price{display:flex;align-items:baseline;gap:9px;white-space:nowrap}.kd-bundle-price strong{font-size:22px}.kd-bundle-price s{color:#999;font-size:13px}.kd-bundle-price span{padding:4px 8px;border-radius:999px;background:#e7f4df;color:#287119;font-size:11px;font-weight:700}
@media(min-width:769px) and (max-width:1199px){.kd-header{height:78px}.kd-header nav{gap:14px}.kd-header nav a{font-size:12px}.kd-searchbar{width:170px}.kd-account{font-size:0}.kd-account svg{width:24px}.kd-hero{min-height:390px}.kd-hero h1{font-size:38px}.kd-hero-badges{gap:12px}.kd-category-row{display:flex;overflow-x:auto;padding-bottom:8px}.kd-category{flex:0 0 100px}.kd-product-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.kd-promo{margin-left:20px;margin-right:20px}.kd-products-section{padding-top:28px}}

/* Three-card category panels */
.kd-category-row{grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.kd-category{position:relative;display:block;min-height:0;aspect-ratio:.88;overflow:hidden;padding:20px;border-radius:24px;color:#111;text-align:left;box-sizing:border-box}
.kd-category--masala{background:#fff1c9}.kd-category--dairy{background:#edf5e4}.kd-category--home{background:#eeecfb}
.kd-category strong{position:relative;z-index:2;display:block;max-width:72%;font-family:'Gilroy',sans-serif;font-size:26px;line-height:1.05}
.kd-category span{position:relative;z-index:2;display:block;max-width:72%;margin-top:7px;font-size:13px;line-height:1.35;white-space:nowrap;color:#3c3c36}
.kd-category i{position:absolute;left:20px;bottom:18px;z-index:2;display:grid;place-items:center;width:32px;height:32px;border-radius:50%;background:#c38a13;color:#fff;font-size:18px;font-style:normal;line-height:1}
.kd-category--dairy i{background:#8bb66f}.kd-category--home i{background:#8b80c5}
.kd-category img{position:absolute;right:-6%;bottom:-8%;width:64%;height:58%;object-fit:contain;object-position:right bottom;mix-blend-mode:multiply}
.kd-category--dairy img{right:-2%;bottom:-7%;width:56%;height:72%}.kd-category--home img{right:-4%;bottom:-5%;width:70%;height:62%}

/* Large desktop: badges settle into one row, hero gets a touch more room to breathe */
@media(min-width:1280px){
  .kd-hero{grid-template-columns:1.05fr .95fr}
  .kd-hero-badges{grid-template-columns:repeat(4,minmax(0,1fr));max-width:560px}
}
}
</style>
{% schema %}
{"name":"Karthika Desktop Homepage","tag":"section","class":"karthika-desktop-home-section","settings":[{"type":"collection","id":"products_collection","label":"Product collection"}],"presets":[{"name":"Karthika Desktop Homepage"}]}
{% endschema %}