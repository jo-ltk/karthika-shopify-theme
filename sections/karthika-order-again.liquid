    <span class="kor-dot kor-dot--active"></span>
    <span class="kor-dot"></span>
    <span class="kor-dot"></span>
  </div>
</div>

{%- comment -%}──────────────────────────────── SCOPED CSS ─────────────────────────────────────{%- endcomment -%}
<style>
  /* ═══════════════════════════════════════════════════════════════════
   Karthika — Order Again Section (kor-*)
   All rules scoped to .kor-* to prevent global conflicts.
   ═══════════════════════════════════════════════════════════════════ */

  /* ── Section wrapper ───────────────────────────────────────────── */
  .kor-section {
    padding: 20px 0 12px;
    font-family: var(--karthika-font-sans, 'Gilroy', sans-serif);
    color: var(--karthika-text-dark, #171717);
  }

  /* ── Section header ────────────────────────────────────────────── */
  .kor-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 0 16px 12px;
  }

  .kor-head__title {
    margin: 0;
    font-size: 18px;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.35px;
    color: var(--karthika-text-dark, #171717);
  }

  .kor-head__link {
    flex: 0 0 auto;
    color: var(--karthika-red, #3f7d2e);
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .kor-head__link:hover {
    text-decoration: underline;
  }

  /* ── Scroll outer (clips overflow) ────────────────────────────── */
  .kor-scroll-outer {
    position: relative;
  }

  /* ── Horizontal scroll track ───────────────────────────────────── */
  .kor-scroll-track {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding: 4px 16px 16px;
  }

  /* ── Category card ─────────────────────────────────────────────── */
  .kor-card {
    position: relative;
    flex: 0 0 calc(55vw);
    max-width: 220px;
    scroll-snap-align: start;
    border-radius: var(--karthika-radius-md, 20px);
    background-color: var(--kor-card-bg, #ebf4ff);
    padding: 12px 10px 16px;
    box-sizing: border-box;
    box-shadow: var(--karthika-shadow-subtle, 0 1px 3px rgba(0, 0, 0, 0.05));
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .kor-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--karthika-shadow-hover, 0 6px 18px rgba(0, 0, 0, 0.07));
  }

  /* ── Card header (category title link) ────────────────────────── */
  .kor-card__header {
    display: block;
    text-decoration: none;
    margin-bottom: 12px;
  }

  .kor-card__title {
    display: block;
    font-size: 13px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.2px;
    color: var(--karthika-text-dark, #171717);
    text-align: center;
  }

  .kor-card__header:hover .kor-card__title {
    color: var(--karthika-red, #3f7d2e);
  }

  /* ── 2×2 product image grid ────────────────────────────────────── */
  .kor-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
  }

  .kor-grid__cell {
    display: block;
    text-decoration: none;
  }

  .kor-grid__img-wrap {
    aspect-ratio: 1 / 1;
    background: #ffffff;
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .kor-grid__img-wrap--empty {
    background: rgba(255, 255, 255, 0.4);
  }

  .kor-grid__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    padding: 0;
    box-sizing: border-box;
    transition: transform 0.15s ease;
  }

  .kor-grid__cell:hover .kor-grid__img {
    transform: scale(1.05);
  }

  .kor-grid__placeholder {
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.04);
    border-radius: 12px;
  }

  /* ── Overflow badge ────────────────────────────────────────────── */
  .kor-badge {
    position: absolute;
    right: 8px;
    bottom: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    height: 20px;
    padding: 0 6px;
    border-radius: 999px;
    background: var(--karthika-red, #3f7d2e);
    color: #ffffff;
    font-family: var(--karthika-font-sans, 'Gilroy', sans-serif);
    font-size: 10px;
    font-weight: 800;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.14);
    z-index: 2;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .kor-badge:hover {
    background: var(--karthika-red-hover, #336524);
    transform: scale(1.06);
  }

  /* ── Scroll progress dots ──────────────────────────────────────── */
  .kor-dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 2px 0 4px;
  }

  .kor-dot {
    display: block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--karthika-border, #e1e8d3);
    transition: width 0.2s ease, background 0.2s ease, border-radius 0.2s ease;
  }

  .kor-dot--active {
    width: 16px;
    border-radius: 3px;
    background: var(--karthika-red, #3f7d2e);
  }

  /* ── Guest sign-in prompt ──────────────────────────────────────── */
  .kor-guest {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 16px;
    padding: 18px 20px;
    background: var(--karthika-bg-surface, #eff4e3);
    border-radius: var(--karthika-radius-md, 20px);
    border: 1px solid var(--karthika-border-light, #eaf0de);
  }

  .kor-guest__icon {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--karthika-bg-white, #fff);
    color: var(--karthika-red, #3f7d2e);
    box-shadow: var(--karthika-shadow-subtle, 0 1px 3px rgba(0, 0, 0, 0.05));
  }

  .kor-guest__copy {
    flex: 1 1 auto;
    min-width: 0;
  }

  .kor-guest__title {
    margin: 0 0 3px;
    font-size: 14px;
    font-weight: 800;
    line-height: 1.2;
  }

  .kor-guest__sub {
    margin: 0;
    font-size: 12px;
    color: var(--karthika-text-muted, #5c6b52);
    line-height: 1.4;
  }

  .kor-guest__btn {
    flex: 0 0 auto;
    display: inline-block;
    padding: 10px 18px;
    border-radius: var(--karthika-radius-btn, 9999px);
    background: var(--karthika-red, #3f7d2e);
    color: #ffffff;
    font-family: var(--karthika-font-sans, 'Gilroy', sans-serif);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .kor-guest__btn:hover {
    background: var(--karthika-red-hover, #336524);
    transform: translateY(-1px);
  }

  /* ── Editor hint ───────────────────────────────────────────────── */
  .kor-empty-hint {
    margin: 0 16px;
    padding: 24px;
    background: var(--karthika-bg-surface, #eff4e3);
    border-radius: var(--karthika-radius-md, 20px);
    border: 1.5px dashed var(--karthika-border, #e1e8d3);
    text-align: center;
    color: var(--karthika-text-muted, #5c6b52);
    font-size: 13px;
  }

  .kor-empty-hint p {
    margin: 0;
  }

  /* ═══════════════════════════════════════════════════════════════════
   TABLET (768px+): ~2 cards visible
   ═══════════════════════════════════════════════════════════════════ */
  @media screen and (min-width: 768px) {
    .kor-section {
      padding: 28px 0 16px;
    }

    .kor-head {
      padding: 0 24px 14px;
    }

    .kor-head__title {
      font-size: 22px;
      letter-spacing: -0.5px;
    }

    .kor-scroll-track {
      gap: 14px;
      padding: 6px 24px 18px;
    }

    .kor-card {
      flex: 0 0 calc(31% - 10px);
      max-width: 260px;
      padding: 16px 14px 20px;
    }

    .kor-card__title {
      font-size: 14px;
    }

    .kor-guest {
      margin: 0 24px;
      padding: 22px 28px;
    }
  }

  /* ═══════════════════════════════════════════════════════════════════
   DESKTOP (990px+): ~3 cards visible, generous spacing
   ═══════════════════════════════════════════════════════════════════ */
  @media screen and (min-width: 990px) {
    .kor-section {
      padding: 36px 0 20px;
    }

    .kor-head {
      padding: 0 32px 18px;
    }

    .kor-head__title {
      font-size: 26px;
      letter-spacing: -0.6px;
    }

    .kor-head__link {
      font-size: 13px;
    }

    .kor-scroll-track {
      gap: 16px;
      padding: 8px 32px 20px;
    }

    .kor-card {
      flex: 0 0 calc(20% - 12px);
      max-width: 280px;
      padding: 18px 16px 22px;
    }

    .kor-card__title {
      font-size: 15px;
    }

    .kor-badge {
      right: 12px;
      bottom: 12px;
      min-width: 26px;
      height: 22px;
      font-size: 11px;
    }

    /* Dots not needed for mouse users */
    .kor-dots {
      display: none;
    }

    .kor-guest {
      margin: 0 32px;
      padding: 28px 36px;
    }

    .kor-guest__icon {
      width: 56px;
      height: 56px;
    }

    .kor-guest__title {
      font-size: 16px;
    }

    .kor-guest__sub {
      font-size: 13px;
    }

    .kor-guest__btn {
      padding: 12px 24px;
      font-size: 13px;
    }
  }

  /* ═══════════════════════════════════════════════════════════════════
   LARGE DESKTOP (1280px+)
   ═══════════════════════════════════════════════════════════════════ */
  @media screen and (min-width: 1280px) {
    .kor-card {
      flex: 0 0 calc(18% - 12px);
    }
  }
</style>

{%- comment -%}──────────────────────────────── SCROLL JS ──────────────────────────────────────{%- endcomment -%}
<script>
  (function () {
    'use strict';

    var sectionId = '{{ section.id | escape }}';
    var trackEl = document.getElementById('korScrollTrack-' + sectionId);
    var dotsWrap = document.getElementById('korDots-' + sectionId);

    if (!trackEl) return;

    /* Dot progress indicator */
    if (dotsWrap) {
      var dots = Array.prototype.slice.call(dotsWrap.querySelectorAll('.kor-dot'));

      function updateDots() {
        if (!dots.length) return;
        var maxScroll = trackEl.scrollWidth - trackEl.clientWidth;
        var ratio = maxScroll > 0 ? trackEl.scrollLeft / maxScroll : 0;
        var idx = Math.round(ratio * (dots.length - 1));
        dots.forEach(function (d, i) {
          d.classList.toggle('kor-dot--active', i === idx);
        });
      }

      trackEl.addEventListener('scroll', updateDots, { passive: true });
      updateDots();
    }

    /* Keyboard arrow navigation */
    trackEl.addEventListener('keydown', function (e) {
      var cards = trackEl.querySelectorAll('.kor-card');
      if (!cards.length) return;
      var cardW = cards[0].offsetWidth + 12; /* card width + gap */

      if (e.key === 'ArrowRight') {
        trackEl.scrollBy({ left: cardW, behavior: 'smooth' });
        e.preventDefault();
      } else if (e.key === 'ArrowLeft') {
        trackEl.scrollBy({ left: -cardW, behavior: 'smooth' });
        e.preventDefault();
      }
    });
  })();
</script>

