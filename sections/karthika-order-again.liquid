        <div class="kor-card" style="--kor-card-bg: #FFE8F2;" role="listitem">
          <a href="/collections/all" class="kor-card__header">
            <span class="kor-card__title">Sweet<br>Tooth</span>
          </a>
          <div class="kor-grid">
            <div class="kor-grid__cell"><div class="kor-grid__img-wrap"><img src="https://images.unsplash.com/photo-1548907040-4baa42d10919?auto=format&fit=crop&w=200&q=80" alt="" class="kor-grid__img" width="100" height="100" loading="lazy"></div></div>
            <div class="kor-grid__cell"><div class="kor-grid__img-wrap"><img src="https://images.unsplash.com/photo-1511381939415-e44015466834?auto=format&fit=crop&w=200&q=80" alt="" class="kor-grid__img" width="100" height="100" loading="lazy"></div></div>
            <div class="kor-grid__cell"><div class="kor-grid__img-wrap"><img src="https://images.unsplash.com/photo-1587314168485-3236d6710814?auto=format&fit=crop&w=200&q=80" alt="" class="kor-grid__img" width="100" height="100" loading="lazy"></div></div>
