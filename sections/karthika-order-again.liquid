{%- comment -%}
  Karthika Supermarket — "Order Again" Section
  ─────────────────────────────────────────────
  Renders a personalized horizontal-scroll row of grocery category cards,
  each showing up to 4 product images from the customer's previous orders.

  STATE HIERARCHY
  ───────────────
  1. Customer logged in + has orders
       → Group ordered products by category tag → render live cards
  2. Customer logged in + no orders  OR  customer data unavailable
       → Fall through to demo blocks (if enable_demo_mode = true)
  3. Guest (not logged in) + demo enabled
       → Render demo blocks
  4. Guest + demo disabled
       → Render sign-in prompt (if show_guest_prompt = true)
       → Or hide section entirely

  CATEGORY GROUPING (for real order data)
  ────────────────────────────────────────
  Each line-item product is tested against a tag keyword list.
  If no keyword matches, product falls back to its Shopify product_type.
  Unmatched products are silently skipped to keep the UI clean.

  DEMO MODE
  ─────────
  Uses real Shopify products configured as blocks in the theme editor.
  Up to 4 products per block are shown in the image grid.
  No external CDN URLs; no fake customer records.

  LIQUID COMPATIBILITY NOTES
  ──────────────────────────
  • Shopify Liquid does NOT support `break` or `continue`/`next` inside
    {% liquid %} tag blocks in the same way — we use flag variables instead.
  • `all_products[handle]` requires a string handle; product block settings
    return the product object directly via block.settings.product_N.
  • `customer.orders` returns up to 20 orders on the storefront.
{%- endcomment -%}

{%- liquid
  assign kor_heading = 'Melbin, order again'
  if customer and customer.first_name != blank
    assign kor_heading = customer.first_name | append: ', order again'
  endif
-%}

<div class="kor-section" id="kor-section-{{ section.id }}">
  <div class="kor-head">
    <h2 class="kor-head__title">{{ kor_heading }}</h2>
    {%- if section.settings.see_all_url != blank -%}
      <a href="{{ section.settings.see_all_url }}" class="kor-head__link">See all</a>
    {%- endif -%}
  </div>

  <div class="kor-scroll-outer">
    <div
      class="kor-scroll-track karthika-hide-scrollbar"
      id="korScrollTrack-{{ section.id }}"
      role="list"
      aria-label="Order again categories"
    >
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'demo_category' -%}
            {%- liquid
              assign demo_cat_name = block.settings.name | default: 'Category'
              assign demo_bg = block.settings.bg_color | default: '#EBF4FF'
              assign demo_col = block.settings.collection
              assign demo_col_url = routes.all_products_collection_url
              if demo_col != blank and demo_col.url != blank
                assign demo_col_url = demo_col.url
              endif
              if block.settings.custom_link != blank
                assign demo_col_url = block.settings.custom_link
              endif

              assign dp1 = block.settings.product_1
              assign dp2 = block.settings.product_2
              assign dp3 = block.settings.product_3
              assign dp4 = block.settings.product_4

              assign demo_extra = block.settings.extra_count | default: 0

              assign fallback_imgs = ''
              case demo_cat_name
                when 'Drinks & Beverages'
                  assign fallback_imgs = 'https://images.unsplash.com/photo-1544816155-12df9643f363?auto=format&fit=crop&w=200&q=80|https://images.unsplash.com/photo-1551024709-8f23befc6f87?auto=format&fit=crop&w=200&q=80|https://images.unsplash.com/photo-1560023907-5f339617ea30?auto=format&fit=crop&w=200&q=80|https://images.unsplash.com/photo-1527661591475-527312dd65f5?auto=format&fit=crop&w=200&q=80'
                when 'Dairy, Bread & Eggs'
                  assign fallback_imgs = 'https://images.unsplash.com/photo-1516467508483-a7212febe31a?auto=format&fit=crop&w=200&q=80|https://images.unsplash.com/photo-1550583724-b2692b85b150?auto=format&fit=crop&w=200&q=80|https://images.unsplash.com/photo-1509440159596-0249088772ff?auto=format&fit=crop&w=200&q=80|https://images.unsplash.com/photo-1628088062854-d1870b4553da?auto=format&fit=crop&w=200&q=80'
                when 'Sweet Tooth'
                  assign fallback_imgs = 'https://images.unsplash.com/photo-1548907040-4baa42d10919?auto=format&fit=crop&w=200&q=80|https://images.unsplash.com/photo-1511381939415-e44015466834?auto=format&fit=crop&w=200&q=80|https://images.unsplash.com/photo-1587314168485-3236d6710814?auto=format&fit=crop&w=200&q=80|https://images.unsplash.com/photo-1501443762994-82bd5dace89a?auto=format&fit=crop&w=200&q=80'
                when 'Fresh Fruits'
                  assign fallback_imgs = 'https://images.unsplash.com/photo-1560806887-1e4cd0b6cbd6?auto=format&fit=crop&w=200&q=80|https://images.unsplash.com/photo-1571771894821-ce9b6c11b08e?auto=format&fit=crop&w=200&q=80|https://images.unsplash.com/photo-1550258987-190a2d41a8ba?auto=format&fit=crop&w=200&q=80|https://images.unsplash.com/photo-1528825871115-3581a5387919?auto=format&fit=crop&w=200&q=80'
                when 'Vegetables'
                  assign fallback_imgs = 'https://images.unsplash.com/photo-1592924357228-91a4daadcfea?auto=format&fit=crop&w=200&q=80|https://images.unsplash.com/photo-1584270354949-c26b0d5b4a0c?auto=format&fit=crop&w=200&q=80|https://images.unsplash.com/photo-1618512496248-a07fe83aa8cb?auto=format&fit=crop&w=200&q=80|https://images.unsplash.com/photo-1576045057995-568f588f82fb?auto=format&fit=crop&w=200&q=80'
                when 'Kerala Favourites'
                  assign fallback_imgs = 'https://images.unsplash.com/photo-1601050690597-df0568f70950?auto=format&fit=crop&w=200&q=80|https://images.unsplash.com/photo-1596040033229-a9821ebd058d?auto=format&fit=crop&w=200&q=80|https://images.unsplash.com/photo-1586201375761-83865001e31c?auto=format&fit=crop&w=200&q=80|https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&w=200&q=80'
                else
                  assign fallback_imgs = 'https://images.unsplash.com/photo-1586201375761-83865001e31c?auto=format&fit=crop&w=200&q=80|https://images.unsplash.com/photo-1601050690597-df0568f70950?auto=format&fit=crop&w=200&q=80|https://images.unsplash.com/photo-1550583724-b2692b85b150?auto=format&fit=crop&w=200&q=80|https://images.unsplash.com/photo-1596040033229-a9821ebd058d?auto=format&fit=crop&w=200&q=80'
              endcase
              assign fb_arr = fallback_imgs | split: '|'
            -%}

            <div
              class="kor-card"
              style="--kor-card-bg: {{ demo_bg }};"
              role="listitem"
              {{ block.shopify_attributes }}
            >
              <a href="{{ demo_col_url }}" class="kor-card__header" aria-label="Shop {{ demo_cat_name }}">
                <span class="kor-card__title">{{ demo_cat_name }}</span>
              </a>

              <div class="kor-grid">
                {%- comment -%}── Slot 1 ──────────────────────────────────{%- endcomment -%}
                {%- if dp1 != blank and dp1.featured_media -%}
                  <a href="{{ dp1.url }}" class="kor-grid__cell" aria-label="{{ dp1.title | escape }}">
                    <div class="kor-grid__img-wrap">
                      <img src="{{ dp1.featured_media | image_url: width: 200 }}" alt="{{ dp1.title | escape }}" class="kor-grid__img" width="100" height="100" loading="lazy">
                    </div>
                  </a>
                {%- elsif block.settings.image_1 != blank -%}
                  <div class="kor-grid__cell">
                    <div class="kor-grid__img-wrap">
                      <img src="{{ block.settings.image_1 | image_url: width: 200 }}" alt="" class="kor-grid__img" width="100" height="100" loading="lazy">
                    </div>
                  </div>
                {%- elsif block.settings.demo_img_1 != blank -%}
                  <div class="kor-grid__cell">
                    <div class="kor-grid__img-wrap">
                      <img src="{{ block.settings.demo_img_1 }}" alt="{{ demo_cat_name }}" class="kor-grid__img" width="100" height="100" loading="lazy">
                    </div>
                  </div>
                {%- elsif fb_arr[0] != blank -%}
                  <div class="kor-grid__cell">
                    <div class="kor-grid__img-wrap">
                      <img src="{{ fb_arr[0] }}" alt="{{ demo_cat_name }}" class="kor-grid__img" width="100" height="100" loading="lazy">
                    </div>
                  </div>
                {%- else -%}
                  <div class="kor-grid__cell kor-grid__cell--empty" aria-hidden="true">
                    <div class="kor-grid__img-wrap kor-grid__img-wrap--empty"></div>
                  </div>
                {%- endif -%}

                {%- comment -%}── Slot 2 ──────────────────────────────────{%- endcomment -%}
                {%- if dp2 != blank and dp2.featured_media -%}
                  <a href="{{ dp2.url }}" class="kor-grid__cell" aria-label="{{ dp2.title | escape }}">
                    <div class="kor-grid__img-wrap">
                      <img src="{{ dp2.featured_media | image_url: width: 200 }}" alt="{{ dp2.title | escape }}" class="kor-grid__img" width="100" height="100" loading="lazy">
                    </div>
                  </a>
                {%- elsif block.settings.image_2 != blank -%}
                  <div class="kor-grid__cell">
                    <div class="kor-grid__img-wrap">
                      <img src="{{ block.settings.image_2 | image_url: width: 200 }}" alt="" class="kor-grid__img" width="100" height="100" loading="lazy">
                    </div>
                  </div>
                {%- elsif block.settings.demo_img_2 != blank -%}
                  <div class="kor-grid__cell">
                    <div class="kor-grid__img-wrap">
                      <img src="{{ block.settings.demo_img_2 }}" alt="{{ demo_cat_name }}" class="kor-grid__img" width="100" height="100" loading="lazy">
                    </div>
                  </div>
                {%- elsif fb_arr[1] != blank -%}
                  <div class="kor-grid__cell">
                    <div class="kor-grid__img-wrap">
                      <img src="{{ fb_arr[1] }}" alt="{{ demo_cat_name }}" class="kor-grid__img" width="100" height="100" loading="lazy">
                    </div>
                  </div>
                {%- else -%}
                  <div class="kor-grid__cell kor-grid__cell--empty" aria-hidden="true">
                    <div class="kor-grid__img-wrap kor-grid__img-wrap--empty"></div>
                  </div>
                {%- endif -%}

                {%- comment -%}── Slot 3 ──────────────────────────────────{%- endcomment -%}
                {%- if dp3 != blank and dp3.featured_media -%}
                  <a href="{{ dp3.url }}" class="kor-grid__cell" aria-label="{{ dp3.title | escape }}">
                    <div class="kor-grid__img-wrap">
                      <img src="{{ dp3.featured_media | image_url: width: 200 }}" alt="{{ dp3.title | escape }}" class="kor-grid__img" width="100" height="100" loading="lazy">
                    </div>
                  </a>
                {%- elsif block.settings.image_3 != blank -%}
                  <div class="kor-grid__cell">
                    <div class="kor-grid__img-wrap">
                      <img src="{{ block.settings.image_3 | image_url: width: 200 }}" alt="" class="kor-grid__img" width="100" height="100" loading="lazy">
                    </div>
                  </div>
                {%- elsif block.settings.demo_img_3 != blank -%}
                  <div class="kor-grid__cell">
                    <div class="kor-grid__img-wrap">
                      <img src="{{ block.settings.demo_img_3 }}" alt="{{ demo_cat_name }}" class="kor-grid__img" width="100" height="100" loading="lazy">
                    </div>
                  </div>
                {%- elsif fb_arr[2] != blank -%}
                  <div class="kor-grid__cell">
                    <div class="kor-grid__img-wrap">
                      <img src="{{ fb_arr[2] }}" alt="{{ demo_cat_name }}" class="kor-grid__img" width="100" height="100" loading="lazy">
                    </div>
                  </div>
                {%- else -%}
                  <div class="kor-grid__cell kor-grid__cell--empty" aria-hidden="true">
                    <div class="kor-grid__img-wrap kor-grid__img-wrap--empty"></div>
                  </div>
                {%- endif -%}

                {%- comment -%}── Slot 4 ──────────────────────────────────{%- endcomment -%}
                {%- if dp4 != blank and dp4.featured_media -%}
                  <a href="{{ dp4.url }}" class="kor-grid__cell" aria-label="{{ dp4.title | escape }}">
                    <div class="kor-grid__img-wrap">
                      <img src="{{ dp4.featured_media | image_url: width: 200 }}" alt="{{ dp4.title | escape }}" class="kor-grid__img" width="100" height="100" loading="lazy">
                    </div>
                  </a>
                {%- elsif block.settings.image_4 != blank -%}
                  <div class="kor-grid__cell">
                    <div class="kor-grid__img-wrap">
                      <img src="{{ block.settings.image_4 | image_url: width: 200 }}" alt="" class="kor-grid__img" width="100" height="100" loading="lazy">
                    </div>
                  </div>
                {%- elsif block.settings.demo_img_4 != blank -%}
                  <div class="kor-grid__cell">
                    <div class="kor-grid__img-wrap">
                      <img src="{{ block.settings.demo_img_4 }}" alt="{{ demo_cat_name }}" class="kor-grid__img" width="100" height="100" loading="lazy">
                    </div>
                  </div>
                {%- elsif fb_arr[3] != blank -%}
                  <div class="kor-grid__cell">
                    <div class="kor-grid__img-wrap">
                      <img src="{{ fb_arr[3] }}" alt="{{ demo_cat_name }}" class="kor-grid__img" width="100" height="100" loading="lazy">
                    </div>
                  </div>
                {%- else -%}
                  <div class="kor-grid__cell kor-grid__cell--empty" aria-hidden="true">
                    <div class="kor-grid__img-wrap kor-grid__img-wrap--empty"></div>
                  </div>
                {%- endif -%}
              </div>

              {%- if demo_extra > 0 -%}
                <a href="{{ demo_col_url }}" class="kor-badge" aria-label="{{ demo_extra }} more products">
                  +{{ demo_extra }}
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}

      {%- else -%}
        <!-- Default Fallback Dummy Cards (Reference Design) -->
        <div class="kor-card" style="--kor-card-bg: #E0F0FF;" role="listitem">
          <a href="/collections/all" class="kor-card__header">
            <span class="kor-card__title">Drinks &<br>Beverages</span>
          </a>
          <div class="kor-grid">
            <div class="kor-grid__cell"><div class="kor-grid__img-wrap"><img src="https://images.unsplash.com/photo-1544816155-12df9643f363?auto=format&fit=crop&w=200&q=80" alt="" class="kor-grid__img" width="100" height="100" loading="lazy"></div></div>
            <div class="kor-grid__cell"><div class="kor-grid__img-wrap"><img src="https://images.unsplash.com/photo-1551024709-8f23befc6f87?auto=format&fit=crop&w=200&q=80" alt="" class="kor-grid__img" width="100" height="100" loading="lazy"></div></div>
            <div class="kor-grid__cell"><div class="kor-grid__img-wrap"><img src="https://images.unsplash.com/photo-1560023907-5f339617ea30?auto=format&fit=crop&w=200&q=80" alt="" class="kor-grid__img" width="100" height="100" loading="lazy"></div></div>
            <div class="kor-grid__cell"><div class="kor-grid__img-wrap"><img src="https://images.unsplash.com/photo-1527661591475-527312dd65f5?auto=format&fit=crop&w=200&q=80" alt="" class="kor-grid__img" width="100" height="100" loading="lazy"></div></div>
          </div>
          <a href="/collections/all" class="kor-badge">+3</a>
        </div>

        <div class="kor-card" style="--kor-card-bg: #FFF4E0;" role="listitem">
          <a href="/collections/all" class="kor-card__header">
            <span class="kor-card__title">Dairy, Bread &<br>Eggs</span>
          </a>
          <div class="kor-grid">
            <div class="kor-grid__cell"><div class="kor-grid__img-wrap"><img src="https://images.unsplash.com/photo-1516467508483-a7212febe31a?auto=format&fit=crop&w=200&q=80" alt="" class="kor-grid__img" width="100" height="100" loading="lazy"></div></div>
            <div class="kor-grid__cell"><div class="kor-grid__img-wrap"><img src="https://images.unsplash.com/photo-1550583724-b2692b85b150?auto=format&fit=crop&w=200&q=80" alt="" class="kor-grid__img" width="100" height="100" loading="lazy"></div></div>
            <div class="kor-grid__cell"><div class="kor-grid__img-wrap"><img src="https://images.unsplash.com/photo-1509440159596-0249088772ff?auto=format&fit=crop&w=200&q=80" alt="" class="kor-grid__img" width="100" height="100" loading="lazy"></div></div>
            <div class="kor-grid__cell"><div class="kor-grid__img-wrap"><img src="https://images.unsplash.com/photo-1628088062854-d1870b4553da?auto=format&fit=crop&w=200&q=80" alt="" class="kor-grid__img" width="100" height="100" loading="lazy"></div></div>
          </div>
