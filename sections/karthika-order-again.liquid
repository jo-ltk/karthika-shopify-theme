{%- comment -%}
  Karthika — Order Again
  Logged out: compact sign-in poster.
  Logged in with orders: reorder cards grouped from previous purchases.
  Logged in without orders: hide the section.
{%- endcomment -%}

{%- liquid
  assign kor_is_guest = true
  if customer
    assign kor_is_guest = false
  endif

  assign kor_favourites = 'sections.order_again.favourites' | t
  assign kor_cats = ''
  assign kor_cat_count = 0

  if customer
    for order in customer.orders
      if order.cancelled_at == blank
        for item in order.line_items
          unless item.product == blank or item.gift_card
            assign ptype = item.product.type
            if ptype == blank and item.product.collections.size > 0
              assign ptype = item.product.collections.first.title
            endif
            if ptype == blank
              assign ptype = kor_favourites
            endif
            assign cat_token = ptype | prepend: '|' | append: '|'
            unless kor_cats contains cat_token
              if kor_cat_count < 8
                assign kor_cats = kor_cats | append: cat_token
                assign kor_cat_count = kor_cat_count | plus: 1
              endif
            endunless
          endunless
        endfor
      endif
    endfor
  endif

  assign kor_has_history = false
  if kor_cat_count > 0
    assign kor_has_history = true
  endif

  assign kor_show_demo = false
  if request.design_mode and section.settings.enable_demo_mode
    assign kor_show_demo = true
  endif

  assign kor_hide = false
  if kor_is_guest == false and kor_has_history == false and kor_show_demo == false
    unless request.design_mode
      assign kor_hide = true
    endunless
  endif

  assign kor_heading = 'sections.order_again.title' | t
  if kor_has_history and customer.first_name != blank
    assign kor_heading = 'sections.order_again.heading_named' | t: name: customer.first_name
  endif

  assign kor_see_all = section.settings.see_all_url
  if kor_see_all == blank and kor_has_history
    assign kor_see_all = routes.account_url
  endif

  assign kor_guest_heading = section.settings.guest_heading
  if kor_guest_heading == blank
    assign kor_guest_heading = kor_heading
  endif
  assign kor_guest_sub = section.settings.guest_subtext
  if kor_guest_sub == blank
    assign kor_guest_sub = 'sections.order_again.guest_subtext' | t
  endif
  assign kor_guest_btn = section.settings.guest_btn_label
  if kor_guest_btn == blank
    assign kor_guest_btn = 'sections.order_again.guest_button' | t
  endif

  assign kor_palettes = '#E8F8E8|#FFF4E0|#FFE8F2|#E0F0FF|#EDFCE0|#FEF9E0|#FFF0E0|#F0ECF9' | split: '|'
-%}

{%- if kor_hide -%}
  <style>
    #shopify-section-{{ section.id }} { display: none !important; }
  </style>
{%- else -%}
  <div class="kor-section" id="kor-section-{{ section.id }}">
    {%- if kor_is_guest and kor_show_demo == false -%}
      <div class="kor-poster-wrap">
        <div class="kor-poster">
          <div class="kor-poster__art" aria-hidden="true">
            {%- if section.settings.guest_image != blank -%}
              <img
                src="{{ section.settings.guest_image | image_url: width: 240 }}"
                alt=""
                width="80"
                height="80"
                loading="lazy"
              >
            {%- else -%}
              <span class="kor-poster__art-svg">
                {{ 'karthika-order-again-art.svg' | inline_asset_content }}
              </span>
            {%- endif -%}
          </div>
          <div class="kor-poster__copy">
            <h2 class="kor-poster__title">{{ kor_guest_heading | escape }}</h2>
            <p class="kor-poster__sub">{{ kor_guest_sub | escape }}</p>
          </div>
          {%- capture kor_login_url -%}{% render 'karthika-login-home' %}{%- endcapture -%}
          <a href="{{ kor_login_url | strip }}" class="kor-poster__btn karthika-login-home-link">
            {{ kor_guest_btn | escape }}
          </a>
        </div>
      </div>
    {%- else -%}
      {%- if kor_has_history or kor_show_demo -%}
        <div class="kor-head">
          <h2 class="kor-head__title">{{ kor_heading }}</h2>
          {%- if kor_see_all != blank -%}
            <a href="{{ kor_see_all }}" class="kor-head__link">{{ 'sections.order_again.see_all' | t }}</a>
          {%- endif -%}
        </div>

        <div class="kor-scroll-outer">
          <div
            class="kor-scroll-track karthika-hide-scrollbar"
            id="korScrollTrack-{{ section.id }}"
            role="list"
            aria-label="{{ 'sections.order_again.title' | t }}"
          >
            {%- if kor_has_history -%}
              {%- assign cat_arr = kor_cats | split: '|' -%}
              {%- assign cat_index = 0 -%}
              {%- for cat in cat_arr -%}
                {%- unless cat == blank -%}
                {%- liquid
                  assign img_1 = ''
                  assign url_1 = ''
                  assign alt_1 = cat
                  assign img_2 = ''
                  assign url_2 = ''
                  assign alt_2 = cat
                  assign img_3 = ''
                  assign url_3 = ''
                  assign alt_3 = cat
                  assign img_4 = ''
                  assign url_4 = ''
                  assign alt_4 = cat
                  assign slot = 0
                  assign extra_count = 0
                  assign seen_ids = ''
                  assign cat_query = cat | url_encode
                  assign cat_url = routes.search_url | append: '?q=' | append: cat_query
                  assign pal_i = cat_index | modulo: kor_palettes.size
                  assign cat_bg = kor_palettes[pal_i]
                -%}
                {%- for order in customer.orders -%}
                  {%- if order.cancelled_at == blank -%}
                    {%- for item in order.line_items -%}
                      {%- unless item.product == blank or item.gift_card -%}
                        {%- liquid
                          assign ptype = item.product.type
                          if ptype == blank and item.product.collections.size > 0
                            assign ptype = item.product.collections.first.title
                          endif
                          if ptype == blank
                            assign ptype = kor_favourites
                          endif
                        -%}
                        {%- if ptype == cat -%}
                          {%- assign pid_token = item.product.id | prepend: '|' | append: '|' -%}
                          {%- unless seen_ids contains pid_token -%}
                            {%- liquid
                              assign seen_ids = seen_ids | append: pid_token
                              assign media = item.image
                              if item.product.featured_media
                                assign media = item.product.featured_media
                              endif
                              if item.product.collections.size > 0 and item.product.collections.first.url != blank
                                assign cat_url = item.product.collections.first.url
                              endif
                            -%}
                            {%- if media != blank -%}
                              {%- if slot < 4 -%}
                                {%- liquid
                                  assign slot = slot | plus: 1
                                  assign media_url = media | image_url: width: 200
                                  assign product_url = item.product.url | default: item.url
                                  assign product_alt = item.product.title | default: item.title
                                  case slot
                                    when 1
                                      assign img_1 = media_url
                                      assign url_1 = product_url
                                      assign alt_1 = product_alt
                                    when 2
                                      assign img_2 = media_url
                                      assign url_2 = product_url
                                      assign alt_2 = product_alt
                                    when 3
                                      assign img_3 = media_url
                                      assign url_3 = product_url
                                      assign alt_3 = product_alt
                                    when 4
                                      assign img_4 = media_url
                                      assign url_4 = product_url
                                      assign alt_4 = product_alt
                                  endcase
                                -%}
                              {%- else -%}
                                {%- assign extra_count = extra_count | plus: 1 -%}
                              {%- endif -%}
                            {%- endif -%}
                          {%- endunless -%}
                        {%- endif -%}
                      {%- endunless -%}
                    {%- endfor -%}
                  {%- endif -%}
                {%- endfor -%}

                {%- if slot > 0 -%}
                  {% render 'karthika-order-again-card',
                    title: cat,
                    bg: cat_bg,
                    url: cat_url,
                    extra: extra_count,
                    img_1: img_1,
                    url_1: url_1,
                    alt_1: alt_1,
                    img_2: img_2,
                    url_2: url_2,
                    alt_2: alt_2,
                    img_3: img_3,
                    url_3: url_3,
                    alt_3: alt_3,
                    img_4: img_4,
                    url_4: url_4,
                    alt_4: alt_4
                  %}
                  {%- assign cat_index = cat_index | plus: 1 -%}
                {%- endif -%}
                {%- endunless -%}
              {%- endfor -%}
            {%- elsif kor_show_demo -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'demo_category' -%}
                  {%- liquid
                    assign demo_cat_name = block.settings.name | default: kor_favourites
                    assign demo_bg = block.settings.bg_color | default: '#EBF4FF'
                    assign demo_col = block.settings.collection
                    assign demo_col_url = routes.all_products_collection_url
                    if demo_col != blank and demo_col.url != blank
                      assign demo_col_url = demo_col.url
                    endif
                    if block.settings.custom_link != blank
                      assign demo_col_url = block.settings.custom_link
                    endif
                    assign dp1 = block.settings.product_1
                    assign dp2 = block.settings.product_2
                    assign dp3 = block.settings.product_3
                    assign dp4 = block.settings.product_4
                    assign demo_extra = block.settings.extra_count | default: 0
                    assign d_img1 = ''
                    assign d_url1 = ''
                    assign d_alt1 = demo_cat_name
                    assign d_img2 = ''
                    assign d_url2 = ''
                    assign d_alt2 = demo_cat_name
                    assign d_img3 = ''
                    assign d_url3 = ''
                    assign d_alt3 = demo_cat_name
                    assign d_img4 = ''
                    assign d_url4 = ''
                    assign d_alt4 = demo_cat_name
                    if dp1 != blank and dp1.featured_media
                      assign d_img1 = dp1.featured_media | image_url: width: 200
                      assign d_url1 = dp1.url
                      assign d_alt1 = dp1.title
                    elsif block.settings.image_1 != blank
                      assign d_img1 = block.settings.image_1 | image_url: width: 200
                    endif
                    if dp2 != blank and dp2.featured_media
                      assign d_img2 = dp2.featured_media | image_url: width: 200
                      assign d_url2 = dp2.url
                      assign d_alt2 = dp2.title
                    elsif block.settings.image_2 != blank
                      assign d_img2 = block.settings.image_2 | image_url: width: 200
                    endif
                    if dp3 != blank and dp3.featured_media
                      assign d_img3 = dp3.featured_media | image_url: width: 200
                      assign d_url3 = dp3.url
                      assign d_alt3 = dp3.title
                    elsif block.settings.image_3 != blank
                      assign d_img3 = block.settings.image_3 | image_url: width: 200
                    endif
                    if dp4 != blank and dp4.featured_media
                      assign d_img4 = dp4.featured_media | image_url: width: 200
                      assign d_url4 = dp4.url
                      assign d_alt4 = dp4.title
                    elsif block.settings.image_4 != blank
                      assign d_img4 = block.settings.image_4 | image_url: width: 200
                    endif
                  -%}
                  <div style="display: contents" {{ block.shopify_attributes }}>
                  {% render 'karthika-order-again-card',
                    title: demo_cat_name,
                    bg: demo_bg,
                    url: demo_col_url,
                    extra: demo_extra,
                    img_1: d_img1,
                    url_1: d_url1,
                    alt_1: d_alt1,
                    img_2: d_img2,
                    url_2: d_url2,
                    alt_2: d_alt2,
                    img_3: d_img3,
                    url_3: d_url3,
                    alt_3: d_alt3,
                    img_4: d_img4,
                    url_4: d_url4,
                    alt_4: d_alt4
                  %}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>
      {%- elsif request.design_mode -%}
        <div class="kor-poster-wrap">
          <p class="kor-editor-hint">{{ 'sections.order_again.editor_hidden_hint' | t }}</p>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
{%- endif -%}

<style>
  .kor-section {
    padding: 20px 0 12px;
    font-family: var(--karthika-font-sans, 'Gilroy', sans-serif);
    color: var(--karthika-text-dark, #171717);
  }

  .kor-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 0 16px 12px;
  }

  .kor-head__title {
    margin: 0;
    font-size: 18px;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.35px;
    color: var(--karthika-text-dark, #171717);
  }

  .kor-head__link {
    flex: 0 0 auto;
    color: var(--karthika-red, #3f7d2e);
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .kor-head__link:hover {
    text-decoration: underline;
  }

  .kor-scroll-outer {
    position: relative;
  }

  .kor-scroll-track {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding: 4px 16px 8px;
  }

  .kor-card {
    position: relative;
    flex: 0 0 calc(55vw);
    max-width: 220px;
    scroll-snap-align: start;
    border-radius: var(--karthika-radius-md, 20px);
    background-color: var(--kor-card-bg, #ebf4ff);
    padding: 12px 10px 16px;
    box-sizing: border-box;
    box-shadow: var(--karthika-shadow-subtle, 0 1px 3px rgba(0, 0, 0, 0.05));
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .kor-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--karthika-shadow-hover, 0 6px 18px rgba(0, 0, 0, 0.07));
  }

  .kor-card__header {
    display: block;
    text-decoration: none;
    margin-bottom: 12px;
  }

  .kor-card__title {
    display: block;
    font-size: 13px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.2px;
    color: var(--karthika-text-dark, #171717);
    text-align: center;
  }

  .kor-card__header:hover .kor-card__title {
    color: var(--karthika-red, #3f7d2e);
  }

  .kor-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
  }

  .kor-grid__cell {
    display: block;
    text-decoration: none;
  }

  .kor-grid__img-wrap {
    aspect-ratio: 1 / 1;
    background: #ffffff;
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .kor-grid__img-wrap--empty {
    background: rgba(255, 255, 255, 0.4);
  }

  .kor-grid__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    padding: 0;
    box-sizing: border-box;
    transition: transform 0.15s ease;
  }

  .kor-grid__cell:hover .kor-grid__img {
    transform: scale(1.05);
  }

  .kor-badge {
    position: absolute;
    right: 8px;
    bottom: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    height: 20px;
    padding: 0 6px;
    border-radius: 999px;
    background: var(--karthika-red, #3f7d2e);
    color: #ffffff;
    font-family: var(--karthika-font-sans, 'Gilroy', sans-serif);
    font-size: 10px;
    font-weight: 800;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.14);
    z-index: 2;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .kor-badge:hover {
    background: var(--karthika-red-hover, #336524);
    transform: scale(1.06);
  }

  .kor-poster-wrap {
    padding: 0 16px 4px;
  }

  .kor-poster {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    overflow: hidden;
    min-height: 92px;
    padding: 14px 16px;
    border-radius: 24px;
    background:
      radial-gradient(circle at 100% 0%, rgba(63, 125, 46, 0.10), transparent 42%),
      radial-gradient(circle at 0% 100%, rgba(245, 196, 0, 0.16), transparent 38%),
      var(--karthika-bg-surface, #eff4e3);
    border: 1px solid var(--karthika-border-light, #eaf0de);
    box-shadow: var(--karthika-shadow-subtle, 0 1px 3px rgba(0, 0, 0, 0.05));
  }

  .kor-poster::after {
    position: absolute;
    right: -18px;
    bottom: -22px;
    width: 88px;
    height: 88px;
    border-radius: 50%;
    background: rgba(63, 125, 46, 0.08);
    content: '';
    pointer-events: none;
  }

  .kor-poster__art {
    position: relative;
    z-index: 1;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 20px;
    background: #e8f4dc;
    box-shadow: 0 4px 12px rgba(63, 125, 46, 0.12);
    overflow: hidden;
  }

  .kor-poster__art img,
  .kor-poster__art-svg,
  .kor-poster__art svg {
    display: block;
    width: 72px;
    height: 72px;
    object-fit: cover;
  }

  .kor-poster__copy {
    position: relative;
    z-index: 1;
    flex: 1 1 auto;
    min-width: 0;
  }

  .kor-poster__title {
    margin: 0 0 4px;
    font-family: inherit;
    font-size: 15px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.2px;
    text-transform: none;
    color: var(--karthika-text-dark, #171717);
  }

  .kor-poster__sub {
    margin: 0;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--karthika-text-muted, #5c6b52);
  }

  .kor-poster__btn {
    position: relative;
    z-index: 1;
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    padding: 8px 16px;
    border-radius: var(--karthika-radius-btn, 9999px);
    background: var(--karthika-red, #3f7d2e);
    color: #ffffff;
    font-family: var(--karthika-font-sans, 'Gilroy', sans-serif);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 4px 10px rgba(63, 125, 46, 0.22);
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .kor-poster__btn:hover {
    background: var(--karthika-red-hover, #336524);
    transform: translateY(-1px);
  }

  .kor-editor-hint {
    margin: 0;
    padding: 18px 16px;
    border-radius: 20px;
    border: 1.5px dashed var(--karthika-border, #e1e8d3);
    background: var(--karthika-bg-surface, #eff4e3);
    color: var(--karthika-text-muted, #5c6b52);
    font-size: 13px;
    line-height: 1.4;
    text-align: center;
  }

  @media screen and (max-width: 389px) {
    .kor-poster {
      flex-wrap: wrap;
      padding: 14px;
    }

    .kor-poster__btn {
      width: 100%;
    }

    .kor-poster__copy {
      flex: 1 1 calc(100% - 84px);
    }
  }

  @media screen and (min-width: 768px) {
    .kor-section {
      padding: 28px 0 16px;
    }

    .kor-head {
      padding: 0 24px 14px;
    }

    .kor-head__title {
      font-size: 22px;
      letter-spacing: -0.5px;
    }

    .kor-scroll-track {
      gap: 14px;
      padding: 6px 24px 10px;
    }

    .kor-card {
      flex: 0 0 calc(31% - 10px);
      max-width: 260px;
      padding: 16px 14px 20px;
    }

    .kor-card__title {
      font-size: 14px;
    }

    .kor-poster-wrap {
      padding: 0 24px 8px;
    }

    .kor-poster {
      gap: 16px;
      min-height: 108px;
      padding: 18px 22px;
    }

    .kor-poster__art,
    .kor-poster__art img,
    .kor-poster__art-svg,
    .kor-poster__art svg {
      width: 84px;
      height: 84px;
      border-radius: 22px;
    }

    .kor-poster__title {
      font-size: 18px;
    }

    .kor-poster__sub {
      font-size: 13px;
    }

    .kor-poster__btn {
      min-height: 40px;
      padding: 10px 20px;
      font-size: 13px;
    }
  }

  @media screen and (min-width: 990px) {
    .kor-section {
      padding: 36px 0 20px;
    }

    .kor-head {
      padding: 0 32px 18px;
    }

    .kor-head__title {
      font-size: 26px;
      letter-spacing: -0.6px;
    }

    .kor-head__link {
      font-size: 13px;
    }

    .kor-scroll-track {
      gap: 16px;
      padding: 8px 32px 12px;
    }

    .kor-card {
      flex: 0 0 calc(20% - 12px);
      max-width: 280px;
      padding: 18px 16px 22px;
    }

    .kor-card__title {
      font-size: 15px;
    }

    .kor-badge {
      right: 12px;
      bottom: 12px;
      min-width: 26px;
      height: 22px;
      font-size: 11px;
    }

    .kor-poster-wrap {
      padding: 0 32px 10px;
    }

    .kor-poster {
      gap: 20px;
      max-width: 720px;
      min-height: 116px;
      padding: 20px 26px;
    }

    .kor-poster__art,
    .kor-poster__art img,
    .kor-poster__art-svg,
    .kor-poster__art svg {
      width: 92px;
      height: 92px;
      border-radius: 24px;
    }

    .kor-poster__title {
      font-size: 20px;
    }

    .kor-poster__sub {
      font-size: 14px;
    }

    .kor-poster__btn {
      min-height: 44px;
      padding: 12px 24px;
      font-size: 14px;
    }
  }

  @media screen and (min-width: 1280px) {
    .kor-card {
      flex: 0 0 calc(18% - 12px);
    }
  }
</style>

{%- if kor_has_history or kor_show_demo -%}
  <script>
    (function () {
      'use strict';
      var trackEl = document.getElementById('korScrollTrack-{{ section.id | escape }}');
      if (!trackEl) return;

      trackEl.addEventListener('keydown', function (e) {
        var cards = trackEl.querySelectorAll('.kor-card');
        if (!cards.length) return;
        var cardW = cards[0].offsetWidth + 12;

        if (e.key === 'ArrowRight') {
          trackEl.scrollBy({ left: cardW, behavior: 'smooth' });
          e.preventDefault();
        } else if (e.key === 'ArrowLeft') {
          trackEl.scrollBy({ left: -cardW, behavior: 'smooth' });
          e.preventDefault();
        }
      });
    })();
  </script>
{%- endif -%}

