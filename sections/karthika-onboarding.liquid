{% comment %}
  Karthika Supermarket - Mobile Onboarding Screen
  Recreating reference image with high-fidelity visual matching & Karthika Red branding
{% endcomment %}

{{ 'karthika-grocery.css' | asset_url | stylesheet_tag }}

<div class="karthika-onboarding-wrapper">
  <div class="karthika-onboarding-card">
    
    <!-- Subtle Karthika Header Accent (optional toggle) -->
    {% if section.settings.show_brand_header %}
      <div class="karthika-onboarding-brand-pill">
        <span class="brand-dot"></span>
        <span class="brand-name">{{ section.settings.brand_text | default: 'Karthika Supermarket' }}</span>
      </div>
    {% endif %}

    <!-- 1. Top Grocery Bag Image (50-55% height) -->
    <div class="karthika-onboarding-hero">
      <img
        src="{{ section.settings.image_url | default: 'https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=800&q=85' }}"
        alt="Fresh Grocery Delivery"
        class="karthika-onboarding-img"
        loading="eager"
        width="800"
        height="800"
      >
    </div>

    <!-- Bottom Content Area -->
    <div class="karthika-onboarding-content">
      <div class="karthika-onboarding-text-group">
        <!-- 2. Bold Headline -->
        <h1 class="karthika-onboarding-title">
          {{ section.settings.heading | default: 'Fresh items with<br>fast delivery grocery' }}
        </h1>

        <!-- Subtitle Description -->
        <p class="karthika-onboarding-desc">
          {{ section.settings.subheading | default: 'We try our best level to make sure our customer happiness by fresh grocery item' }}
        </p>

        <!-- 3. Slider Indicators (3 pills/dots, middle active in Karthika Red) -->
        <div class="karthika-onboarding-dots" aria-label="Onboarding step indicators">
          <span class="dot dot-inactive"></span>
          <span class="dot dot-active"></span>
          <span class="dot dot-inactive"></span>
        </div>
      </div>

      <!-- 4. CTA Button -->
      <div class="karthika-onboarding-actions">
        <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="karthika-onboarding-btn">
          {{ section.settings.button_text | default: 'GET STARTED' }}
        </a>
      </div>
    </div>

  </div>
</div>

<style>
  .karthika-onboarding-wrapper {
    min-height: 100vh;
    min-height: 100dvh;
    background-color: #E2DFD8;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px 12px;
    box-sizing: border-box;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  }

  .karthika-onboarding-card {
    position: relative;
    width: 100%;
    max-width: 400px;
    height: 844px;
    max-height: 92vh;
    max-height: 92dvh;
    background-color: #F7F5F0;
    border-radius: 42px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.12);
  }

  /* Subtle brand badge on top */
  .karthika-onboarding-brand-pill {
    position: absolute;
    top: 18px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(8px);
    padding: 6px 14px;
    border-radius: 20px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  }

  .karthika-onboarding-brand-pill .brand-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #B40000;
  }

  .karthika-onboarding-brand-pill .brand-name {
    font-size: 12px;
    font-weight: 700;
    color: #111111;
    letter-spacing: 0.3px;
  }

  /* Top Image Area: occupies ~53% of screen */
  .karthika-onboarding-hero {
    width: 100%;
    height: 53%;
    flex: 0 0 53%;
    overflow: hidden;
    position: relative;
    background-color: #F7F5F0;
  }

  .karthika-onboarding-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  /* Bottom Content Area */
  .karthika-onboarding-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 24px 28px 30px 28px;
    background-color: #F7F5F0;
    box-sizing: border-box;
  }

  .karthika-onboarding-text-group {
    display: flex;
    flex-direction: column;
  }

  /* Bold Typography */
  .karthika-onboarding-title {
    font-size: 28px;
    line-height: 1.18;
    font-weight: 800;
    color: #111111;
    letter-spacing: -0.4px;
    margin: 0 0 14px 0;
    text-align: left;
  }

  .karthika-onboarding-desc {
    font-size: 14px;
    line-height: 1.45;
    color: #6B6B6B;
    margin: 0 0 24px 0;
    text-align: left;
    max-width: 95%;
    font-weight: 400;
  }

  /* Slider Indicators */
  .karthika-onboarding-dots {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
  }

  .karthika-onboarding-dots .dot {
    height: 6px;
    border-radius: 4px;
    transition: all 0.25s ease;
  }

  .karthika-onboarding-dots .dot-inactive {
    width: 12px;
    background-color: #D6D2CA;
  }

  .karthika-onboarding-dots .dot-active {
    width: 18px;
    background-color: #B40000;
  }

  /* Bottom CTA Button */
  .karthika-onboarding-actions {
    width: 100%;
    margin-top: auto;
    padding-top: 14px;
  }

  .karthika-onboarding-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 56px;
    background-color: #B40000;
    color: #ffffff !important;
    text-decoration: none;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    border-radius: 14px;
    box-sizing: border-box;
    box-shadow: 0 4px 16px rgba(180, 0, 0, 0.24);
    transition: background-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
  }

  .karthika-onboarding-btn:hover {
    background-color: #920000;
    box-shadow: 0 6px 20px rgba(180, 0, 0, 0.32);
    transform: translateY(-1px);
  }

  .karthika-onboarding-btn:active {
    transform: translateY(1px);
    box-shadow: 0 2px 8px rgba(180, 0, 0, 0.2);
  }

  /* Responsive styling for full mobile view */
  @media (max-width: 480px) {
    .karthika-onboarding-wrapper {
      padding: 0;
      background-color: #F7F5F0;
    }

    .karthika-onboarding-card {
      max-width: 100%;
      height: 100vh;
      height: 100dvh;
      max-height: 100vh;
      max-height: 100dvh;
      border-radius: 0;
      box-shadow: none;
    }

    .karthika-onboarding-content {
      padding: 20px 24px 28px 24px;
    }

    .karthika-onboarding-title {
      font-size: 26px;
      margin-bottom: 12px;
    }

    .karthika-onboarding-desc {
      font-size: 13.5px;
      margin-bottom: 20px;
    }
  }
</style>

{% schema %}
{
  "name": "Karthika Onboarding",
  "tag": "section",
  "class": "section-karthika-onboarding",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_brand_header",
      "label": "Show subtle brand header",
      "default": false
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand Text",
      "default": "Karthika Supermarket"
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Hero Image URL",
      "default": "https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=800&q=85",
      "info": "Use a direct image link or Unsplash / lorem image"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading",
      "default": "Fresh items with<br>fast delivery grocery"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "We try our best level to make sure our customer happiness by fresh grocery item"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "GET STARTED"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Karthika Onboarding"
    }
  ]
}
{% endschema %}
