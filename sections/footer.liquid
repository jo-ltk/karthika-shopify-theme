{% comment %}
  KARTHIKA — MODERN EDITORIAL FOOTER
  ------------------------------------------------------------
  Shopify-native:
  - Newsletter
  - Navigation menus
  - Social links
  - Payment methods
  - Policies
  - Store contact information
  - Shopify routes
{% endcomment %}

{%- liquid
  assign store_address = settings.store_location_address | default: section.settings.store_address
  assign helpline_phone = section.settings.helpline_phone | default: '(65) 6297 7533'
  assign contact_email = section.settings.contact_email | default: 'grocery@karthika.sg'
  assign fax_number = section.settings.fax_number | default: '(65) 62977511'
  assign gst_number = section.settings.gst_number | default: '200311912H'

  assign phone_clean = helpline_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-'

  assign has_social = false

  if settings.social_instagram_link != blank
    assign has_social = true
  elsif settings.social_facebook_link != blank
    assign has_social = true
  elsif settings.social_youtube_link != blank
    assign has_social = true
  elsif settings.social_tiktok_link != blank
    assign has_social = true
  elsif settings.social_twitter_link != blank
    assign has_social = true
  elsif settings.social_pinterest_link != blank
    assign has_social = true
  endif
-%}

<style>
  /* =========================================================
     KARTHIKA — MODERN FOOTER
     ========================================================= */

  .kf-footer {
    --kf-green: #315f2b;
    --kf-green-dark: #21451e;
    --kf-green-deep: #183719;
    --kf-lime: #d9ec78;
    --kf-yellow: #f5dc4d;
    --kf-cream: #f7f6ed;
    --kf-white: #ffffff;
    --kf-text: #f7f8f2;
    --kf-muted: rgba(247, 248, 242, .66);
    --kf-line: rgba(255, 255, 255, .13);

    position: relative;
    margin-top: 70px;
    min-height: 100vh;
    min-height: 100dvh;
    overflow: hidden;
    background: var(--kf-green-deep);
    color: var(--kf-text);
  }

  .kf-footer *,
  .kf-footer *::before,
  .kf-footer *::after {
    box-sizing: border-box;
  }

  .kf-footer a {
    color: inherit;
    text-decoration: none;
  }

  .kf-footer__container {
    width: min(1240px, calc(100% - 40px));
    margin: 0 auto;
  }

  /* =========================================================
     DECORATIVE BACKGROUND
     ========================================================= */

  .kf-footer__glow {
    position: absolute;
    top: -240px;
    right: -160px;
    width: 520px;
    height: 520px;
    border-radius: 50%;
    background: rgba(217, 236, 120, .08);
    pointer-events: none;
  }

  .kf-footer__glow--bottom {
    position: absolute;
    right: auto;
    top: auto;
    bottom: -260px;
    left: -180px;
    width: 520px;
    height: 520px;
    background: rgba(245, 220, 77, .045);
  }

  /* =========================================================
     BRAND HERO
     ========================================================= */

  .kf-footer__hero {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, .65fr);
    align-items: center;
    column-gap: 0;
    margin-top: 46px;
    padding: 44px;
    border: 1px solid var(--kf-line);
    border-radius: 28px;
    background: rgba(255, 255, 255, .035);
  }

  .kf-footer__hero-copy {
    position: relative;
    z-index: 2;
    max-width: 760px;
  }

  .kf-footer__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 20px;
    padding: 7px 12px;
    border: 1px solid rgba(217, 236, 120, .28);
    border-radius: 999px;
    background: rgba(217, 236, 120, .08);
    color: var(--kf-lime);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .kf-footer__eyebrow-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--kf-yellow);
    box-shadow: 0 0 0 4px rgba(245, 220, 77, .1);
  }

  .kf-footer__hero-title {
    max-width: 780px;
    margin: 0;
    font-size: clamp(48px, 7vw, 92px);
    font-weight: 800;
    line-height: .9;
    letter-spacing: -.065em;
  }

  .kf-footer__hero-title span {
    color: var(--kf-lime);
  }

  .kf-footer__hero-description {
    max-width: 560px;
    margin: 25px 0 0;
    color: var(--kf-muted);
    font-size: 16px;
    line-height: 1.65;
  }

  .kf-footer__hero-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .kf-footer__primary-link,
  .kf-footer__secondary-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 18px;
    border-radius: 14px;
    font-size: 13px;
    font-weight: 750;
    transition:
      transform .2s ease,
      background .2s ease,
      color .2s ease;
  }

  .kf-footer .kf-footer__primary-link {
    background: var(--kf-lime);
    color: var(--kf-green-deep);
  }

  .kf-footer__secondary-link {
    border: 1px solid var(--kf-line);
    background: rgba(255, 255, 255, .04);
    color: var(--kf-white);
  }

  .kf-footer__primary-link:hover,
  .kf-footer__secondary-link:hover {
    transform: translateY(-2px);
  }

  .kf-footer__secondary-link:hover {
    background: rgba(255, 255, 255, .09);
  }

  /* =========================================================
     VISUAL PANEL
     ========================================================= */

  .kf-footer__visual {
    position: relative;
    min-height: 165px;
    overflow: hidden;
    border-radius: 22px;
    background:
      linear-gradient(
        135deg,
        rgba(217, 236, 120, .15),
        rgba(255, 255, 255, .025)
      );
    border: 1px solid rgba(255, 255, 255, .1);
  }

  .kf-footer__visual-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .kf-footer__visual-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        transparent 25%,
        rgba(15, 35, 15, .8) 100%
      );
  }

  .kf-footer__visual-placeholder {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background:
      radial-gradient(
        circle at 25% 25%,
        rgba(217, 236, 120, .35) 0 8%,
        transparent 9%
      ),
      radial-gradient(
        circle at 72% 28%,
        rgba(245, 220, 77, .32) 0 10%,
        transparent 11%
      ),
      radial-gradient(
        circle at 48% 72%,
        rgba(255, 255, 255, .1) 0 15%,
        transparent 16%
      ),
      linear-gradient(
        135deg,
        #47763b,
        #1d411c
      );
  }

  .kf-footer__visual-placeholder::before,
  .kf-footer__visual-placeholder::after {
    content: "";
    position: absolute;
    border-radius: 999px 0 999px 999px;
    transform: rotate(-35deg);
  }

  .kf-footer__visual-placeholder::before {
    width: 150px;
    height: 85px;
    right: -15px;
    top: 45px;
    background: rgba(217, 236, 120, .18);
  }

  .kf-footer__visual-placeholder::after {
    width: 190px;
    height: 110px;
    left: -45px;
    bottom: 20px;
    background: rgba(245, 220, 77, .12);
  }

  .kf-footer__visual-content {
    position: absolute;
    z-index: 3;
    right: 12px;
    bottom: 18px;
    left: 20px;
  }

  .kf-footer__visual-label {
    display: inline-block;
    margin-bottom: 7px;
    color: var(--kf-lime);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .kf-footer__visual-title {
    margin: 0;
    color: #fff;
    font-size: 30px;
    font-weight: 750;
    line-height: 1.05;
    letter-spacing: -.035em;
  }

  /* =========================================================
     MIDDLE AREA
     ========================================================= */

  .kf-footer__middle {
    display: grid;
    grid-template-columns: 1.15fr 1fr 1fr 1fr;
    gap: 45px;
    padding: 40px 0 50px;
    border-bottom: 1px solid var(--kf-line);
  }

  .kf-footer__column {
    min-width: 0;
  }

  .kf-footer__column--contact {
    padding-right: 20px;
  }

  .kf-footer__logo {
    display: inline-flex;
    margin-bottom: 18px;
  }

  .kf-footer__logo .karthika-logo {
    display: block;
    width: 170px;
    max-width: 100%;
    height: auto;
  }

  .kf-footer__brand-copy {
    max-width: 290px;
    margin: 0;
    color: var(--kf-muted);
    font-size: 13px;
    line-height: 1.7;
  }

  .kf-footer__social {
    display: flex;
    width: 100%;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
    margin-bottom: 18px;
  }

  .kf-footer__social .list-social {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .kf-footer__social .list-social__item {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .kf-footer__social .list-social__link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border: 1px solid var(--kf-line);
    border-radius: 12px;
    background: rgba(255, 255, 255, .045);
    color: #fff;
    transition:
      background .2s ease,
      border-color .2s ease,
      transform .2s ease;
  }

  .kf-footer__social .list-social__link svg {
    width: 16px;
    height: 16px;
    margin: 0;
  }

  .kf-footer__social .list-social__link:hover {
    border-color: rgba(217, 236, 120, .5);
    background: rgba(217, 236, 120, .1);
    transform: translateY(-2px);
  }

  .kf-footer__column-title {
    margin: 3px 0 18px;
    color: #fff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .kf-footer__menu {
    display: grid;
    gap: 11px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .kf-footer__menu a {
    display: inline-flex;
    color: var(--kf-muted);
    font-size: 13px;
    line-height: 1.4;
    transition:
      color .2s ease,
      transform .2s ease;
  }

  .kf-footer__menu a:hover {
    color: var(--kf-lime);
    transform: translateX(3px);
  }

  /* =========================================================
     CONTACT
     ========================================================= */

  .kf-footer__contact {
    display: grid;
    gap: 13px;
    clear: both;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .kf-footer__contact-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: var(--kf-muted);
    font-size: 13px;
    line-height: 1.5;
  }

  .kf-footer__contact-item svg {
    flex: 0 0 17px;
    width: 17px;
    height: 17px;
    margin-top: 2px;
    color: var(--kf-lime);
  }

  .kf-footer__contact-item a:hover {
    color: var(--kf-lime);
  }

  .kf-footer__contact-address {
    font-style: normal;
  }

  .kf-footer__gst {
    margin: 18px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--kf-line);
    color: var(--kf-muted);
    font-size: 11px;
    line-height: 1.5;
  }

  .kf-footer__gst strong {
    color: rgba(255, 255, 255, .9);
  }

  /* =========================================================
     NEWSLETTER
     ========================================================= */

  .kf-footer__newsletter {
    margin-top: 35px;
    padding: 28px 0;
    border-top: 1px solid var(--kf-line);
    border-bottom: 1px solid var(--kf-line);
  }

  .kf-footer__newsletter-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 50px;
  }

  .kf-footer__newsletter-kicker {
    margin: 0 0 8px;
    color: var(--kf-lime);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .15em;
    text-transform: uppercase;
  }

  .kf-footer__newsletter-title {
    margin: 0;
    color: #fff;
    font-size: clamp(23px, 3vw, 34px);
    font-weight: 750;
    line-height: 1.05;
    letter-spacing: -.04em;
  }

  .kf-footer__newsletter-text {
    margin: 9px 0 0;
    color: var(--kf-muted);
    font-size: 13px;
    line-height: 1.5;
  }

  .kf-footer__newsletter-form {
    width: 100%;
  }

  .kf-footer__newsletter-field {
    display: flex;
    align-items: center;
    min-height: 56px;
    padding: 5px;
    border: 1px solid rgba(255, 255, 255, .16);
    border-radius: 17px;
    background: rgba(255, 255, 255, .055);
    transition:
      border-color .2s ease,
      background .2s ease;
  }

  .kf-footer__newsletter-field:focus-within {
    border-color: rgba(217, 236, 120, .65);
    background: rgba(255, 255, 255, .08);
  }

  .kf-footer__newsletter-input {
    min-width: 0;
    flex: 1;
    height: 44px;
    padding: 0 13px;
    border: 0;
    outline: 0;
    background: transparent;
    color: #fff;
    font: inherit;
    font-size: 13px;
  }

  .kf-footer__newsletter-input::placeholder {
    color: rgba(255, 255, 255, .43);
  }

  .kf-footer__newsletter-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 46px;
    width: 46px;
    height: 46px;
    border: 0;
    border-radius: 13px;
    background: var(--kf-lime);
    color: var(--kf-green-deep);
    cursor: pointer;
    transition:
      transform .2s ease,
      background .2s ease;
  }

  .kf-footer__newsletter-button:hover {
    background: #e7f697;
    transform: translateX(2px);
  }

  .kf-footer__newsletter-button svg {
    width: 18px;
    height: 18px;
  }

  .kf-footer__message {
    margin-top: 9px;
    font-size: 12px;
  }

  .kf-footer__message--error {
    color: #ffaaa8;
  }

  .kf-footer__message--success {
    color: var(--kf-lime);
  }

  /* =========================================================
     PAYMENT + BOTTOM
     ========================================================= */

  .kf-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    padding: 25px 0 30px;
  }

  .kf-footer__copyright {
    color: var(--kf-muted);
    font-size: 11px;
    line-height: 1.6;
  }

  .kf-footer__copyright a:hover {
    color: var(--kf-lime);
  }

  .kf-footer__bottom-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 22px;
  }

  .kf-footer__payments {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .kf-footer__payment-item {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    height: 27px;
    padding: 3px 6px;
    border: 1px solid rgba(255, 255, 255, .12);
    border-radius: 6px;
    background: rgba(255, 255, 255, .06);
    overflow: hidden;
  }

  .kf-footer__payment-item svg {
    width: 100%;
    max-width: 42px;
    height: 19px;
  }

  .kf-footer__policies {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .kf-footer__policies a {
    color: var(--kf-muted);
    font-size: 11px;
  }

  .kf-footer__policies a:hover {
    color: var(--kf-lime);
  }

  /* =========================================================
     MOBILE
     ========================================================= */

  @media screen and (max-width: 900px) {
    .kf-footer__hero {
      grid-template-columns: 1fr;
      row-gap: 22px;
      margin-top: 32px;
      padding: 30px;
    }

    .kf-footer__visual {
      min-height: 145px;
    }

    .kf-footer__middle {
      grid-template-columns: 1.2fr 1fr 1fr;
      padding: 30px 0 40px;
    }

    .kf-footer__column--contact {
      grid-column: 1 / -1;
    }

    .kf-footer__newsletter-inner {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .kf-footer__bottom-right {
      flex-direction: column;
      align-items: flex-end;
      gap: 12px;
    }
  }

  @media screen and (max-width: 749px) {
    .kf-footer {
      margin-top: 28px;
    }

    .kf-footer__container {
      width: min(100% - 28px, 1240px);
    }

    .kf-footer__hero {
      min-height: auto;
      margin-top: 22px;
      padding: 26px 22px;
      border-radius: 22px;
    }

    .kf-footer__hero-title {
      font-size: clamp(40px, 13vw, 64px);
    }

    .kf-footer__hero-description {
      margin-top: 16px;
      font-size: 14px;
    }

    .kf-footer__visual {
      min-height: 125px;
      border-radius: 18px;
    }

    .kf-footer__middle {
      grid-template-columns: 1fr 1fr;
      gap: 26px 24px;
      padding: 28px 0;
    }

    .kf-footer__column--contact {
      grid-column: 1 / -1;
      padding-right: 0;
    }

    .kf-footer__newsletter {
      margin-top: 0;
      padding: 22px 0;
    }

    .kf-footer__newsletter-inner {
      gap: 16px;
    }

    .kf-footer__bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 16px;
      padding: 18px 0 72px;
    }

    .kf-footer__bottom-right {
      width: 100%;
      align-items: flex-start;
    }

    .kf-footer__payments {
      justify-content: flex-start;
    }

    .kf-footer__policies {
      justify-content: flex-start;
    }
  }

  @media screen and (max-width: 430px) {
    .kf-footer__hero {
      padding: 22px 18px;
    }

    .kf-footer__hero-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .kf-footer__primary-link,
    .kf-footer__secondary-link {
      width: 100%;
      min-height: 46px;
      padding: 0 12px;
    }

    .kf-footer__middle {
      grid-template-columns: 1fr 1fr;
    }

    .kf-footer__column--contact {
      grid-column: 1 / -1;
    }

    .kf-footer__logo .karthika-logo {
      width: 145px;
    }

    .kf-footer__newsletter-title {
      font-size: 26px;
    }

    .kf-footer__newsletter-field {
      min-height: 53px;
    }

    .kf-footer__newsletter-button {
      flex-basis: 43px;
      width: 43px;
      height: 43px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kf-footer *,
    .kf-footer *::before,
    .kf-footer *::after {
      scroll-behavior: auto !important;
      transition-duration: .01ms !important;
      animation-duration: .01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>


<footer class="kf-footer">

  <span class="kf-footer__glow" aria-hidden="true"></span>
  <span class="kf-footer__glow kf-footer__glow--bottom" aria-hidden="true"></span>

  <div class="kf-footer__container">

    <!-- =====================================================
         HERO
         ===================================================== -->

    <section class="kf-footer__hero">

      <div class="kf-footer__hero-copy">

        <div class="kf-footer__eyebrow">
          <span class="kf-footer__eyebrow-dot" aria-hidden="true"></span>
          Karthika Supermarket
        </div>

        <h2 class="kf-footer__hero-title">
          Good food.
          <br>
          <span>Good mood.</span>
        </h2>

        <p class="kf-footer__hero-description">
          Everyday groceries, familiar favourites and fresh finds —
          all in one place.
        </p>

        <div class="kf-footer__hero-actions">

          <a
            class="kf-footer__primary-link"
            href="{{ routes.all_products_collection_url }}"
          >
            Shop groceries
          </a>

          <a
            class="kf-footer__secondary-link"
            href="{{ routes.account_url }}"
          >
            My account
          </a>

        </div>

      </div>


      <!-- Visual panel -->
      <div class="kf-footer__visual">

        {% if section.settings.footer_image != blank %}

          {{
            section.settings.footer_image
            | image_url: width: 900
            | image_tag:
              class: 'kf-footer__visual-image',
              loading: 'lazy',
              widths: '450, 700, 900',
              sizes: '(min-width: 900px) 420px, 100vw',
              alt: section.settings.footer_image.alt
          }}

          <span
            class="kf-footer__visual-overlay"
            aria-hidden="true"
          ></span>

        {% else %}

          <div
            class="kf-footer__visual-placeholder"
            aria-hidden="true"
          ></div>

        {% endif %}

        <div class="kf-footer__visual-content">

          <span class="kf-footer__visual-label">
            From Karthika
          </span>

          <h3 class="kf-footer__visual-title">
            Your everyday
            <br>
            grocery stop.
          </h3>

        </div>

      </div>

    </section>


    <!-- =====================================================
         MAIN FOOTER CONTENT
         ===================================================== -->

    <section class="kf-footer__middle">

      <!-- BRAND / CONTACT -->

      <div class="kf-footer__column kf-footer__column--contact">

        <a
          href="{{ routes.root_url }}"
          class="kf-footer__logo"
          aria-label="{{ shop.name }}"
        >
          {% render 'karthika-logo',
            class: 'karthika-logo--footer',
            loading: 'lazy'
          %}
        </a>

        <p class="kf-footer__brand-copy">
          Quality groceries, snacks, beverages and household
          essentials for everyday life.
        </p>


        {% if has_social %}

          <div class="kf-footer__social">
            {% render 'social-icons' %}
          </div>

        {% endif %}


        <ul class="kf-footer__contact">

          {% if store_address != blank %}

            <li class="kf-footer__contact-item">

              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"></path>
                <circle cx="12" cy="10" r="2.5"></circle>
              </svg>

              <address class="kf-footer__contact-address">
                {{ store_address | escape | newline_to_br }}
              </address>

            </li>

          {% endif %}


          {% if helpline_phone != blank %}

            <li class="kf-footer__contact-item">

              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2A19.8 19.8 0 0 1 3.1 5.18 2 2 0 0 1 5.11 3h3a2 2 0 0 1 2 1.72c.12.9.34 1.78.65 2.62a2 2 0 0 1-.45 2.11L9.04 10.7a16 16 0 0 0 4.26 4.26l1.25-1.27a2 2 0 0 1 2.11-.45c.84.31 1.72.53 2.62.65A2 2 0 0 1 21 15.9l1 .02Z"></path>
              </svg>

              <a href="tel:{{ phone_clean }}">
                {{ helpline_phone | escape }}
              </a>

            </li>

          {% endif %}


          {% if contact_email != blank %}

            <li class="kf-footer__contact-item">

              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                <path d="m3 7 9 6 9-6"></path>
              </svg>

              <a href="mailto:{{ contact_email }}">
                {{ contact_email | escape }}
              </a>

            </li>

          {% endif %}

        </ul>


        {% if gst_number != blank %}

          <p class="kf-footer__gst">
            <strong>GST</strong>
            {{ gst_number | escape }}
          </p>

        {% endif %}

      </div>


      <!-- SHOP -->

      {% assign shop_menu = linklists[section.settings.shop_menu] %}

      <div class="kf-footer__column">

        <h3 class="kf-footer__column-title">
          Shop
        </h3>

        {% if shop_menu != blank %}

          <ul class="kf-footer__menu">

            {% for link in shop_menu.links %}

              <li>
                <a href="{{ link.url }}">
                  {{ link.title | escape }}
                </a>
              </li>

            {% endfor %}

          </ul>

        {% else %}

          <ul class="kf-footer__menu">

            <li>
              <a href="{{ routes.all_products_collection_url }}">
                All products
              </a>
            </li>

            <li>
              <a href="{{ routes.collections_url }}">
                Collections
              </a>
            </li>

            <li>
              <a href="{{ routes.search_url }}">
                Search
              </a>
            </li>

            <li>
              <a href="{{ routes.cart_url }}">
                Cart
              </a>
            </li>

          </ul>

        {% endif %}

      </div>


      <!-- HELP -->

      {% assign help_menu = linklists[section.settings.help_menu] %}

      <div class="kf-footer__column">

        <h3 class="kf-footer__column-title">
          Help
        </h3>

        {% if help_menu != blank %}

          <ul class="kf-footer__menu">

            {% for link in help_menu.links %}

              <li>
                <a href="{{ link.url }}">
                  {{ link.title | escape }}
                </a>
              </li>

            {% endfor %}

          </ul>

        {% else %}

          <ul class="kf-footer__menu">

            <li>
              <a href="{{ routes.account_url }}">
                My account
              </a>
            </li>

            <li>
              <a href="{{ routes.cart_url }}">
                Cart
              </a>
            </li>

            <li>
              <a href="{{ routes.search_url }}">
                Search
              </a>
            </li>

            {% if shop.refund_policy != blank %}
              <li>
                <a href="{{ shop.refund_policy.url }}">
                  Returns & refunds
                </a>
              </li>
            {% endif %}

          </ul>

        {% endif %}

      </div>


      <!-- COMPANY -->

      {% assign company_menu = linklists[section.settings.company_menu] %}

      <div class="kf-footer__column">

        <h3 class="kf-footer__column-title">
          Company
        </h3>

        {% if company_menu != blank %}

          <ul class="kf-footer__menu">

            {% for link in company_menu.links %}

              <li>
                <a href="{{ link.url }}">
                  {{ link.title | escape }}
                </a>
              </li>

            {% endfor %}

          </ul>

        {% else %}

          <ul class="kf-footer__menu">

            {% if shop.privacy_policy != blank %}
              <li>
                <a href="{{ shop.privacy_policy.url }}">
                  Privacy
                </a>
              </li>
            {% endif %}

            {% if shop.terms_of_service != blank %}
              <li>
                <a href="{{ shop.terms_of_service.url }}">
                  Terms
                </a>
              </li>
            {% endif %}

            {% if shop.shipping_policy != blank %}
              <li>
                <a href="{{ shop.shipping_policy.url }}">
                  Shipping
                </a>
              </li>
            {% endif %}

            <li>
              <a href="{{ routes.account_url }}">
                Account
              </a>
            </li>

          </ul>

        {% endif %}

      </div>

    </section>


    <!-- =====================================================
         NEWSLETTER
         ===================================================== -->

    {% if section.settings.newsletter_enable %}

      <section class="kf-footer__newsletter">

        <div class="kf-footer__newsletter-inner">

          <div>

            <p class="kf-footer__newsletter-kicker">
              Stay fresh
            </p>

            <h2 class="kf-footer__newsletter-title">
              Fresh picks.
              <br>
              Better deals.
            </h2>

            <p class="kf-footer__newsletter-text">
              Get new product updates and offers from Karthika.
            </p>

          </div>


          {% form 'customer',
            id: 'KarthikaModernFooterNewsletter',
            class: 'kf-footer__newsletter-form'
          %}

            <input
              type="hidden"
              name="contact[tags]"
              value="newsletter"
            >

            <div class="kf-footer__newsletter-field">

              <label
                class="visually-hidden"
                for="KarthikaModernFooterEmail"
              >
                Email address
              </label>

              <input
                id="KarthikaModernFooterEmail"
                class="kf-footer__newsletter-input"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                placeholder="Your email address"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                required
                {% if form.errors %}
                  aria-invalid="true"
                  aria-describedby="KarthikaFooterNewsletterError"
                {% endif %}
              >

              <button
                type="submit"
                class="kf-footer__newsletter-button"
                aria-label="Subscribe"
              >

                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h13"></path>
                  <path d="m13 6 6 6-6 6"></path>
                </svg>

              </button>

            </div>


            {% if form.errors %}

              <div
                id="KarthikaFooterNewsletterError"
                class="kf-footer__message kf-footer__message--error"
                role="alert"
              >
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </div>

            {% endif %}


            {% if form.posted_successfully? %}

              <div
                class="kf-footer__message kf-footer__message--success"
                role="status"
              >
                Thanks for subscribing.
              </div>

            {% endif %}

          {% endform %}

        </div>

      </section>

    {% endif %}


    <!-- =====================================================
         BOTTOM
         ===================================================== -->

    <div class="kf-footer__bottom">

      <div class="kf-footer__copyright">

        © {{ 'now' | date: '%Y' }},
        <a href="{{ routes.root_url }}">
          {{ shop.name }}
        </a>
        · All rights reserved.

        {% if powered_by_link %}
          · {{ powered_by_link }}
        {% endif %}

      </div>


      <div class="kf-footer__bottom-right">

        {% if section.settings.payment_enable %}

          <div class="kf-footer__payments">

            {% if shop.enabled_payment_types.size > 0 %}

              {% for type in shop.enabled_payment_types %}

                <div class="kf-footer__payment-item">
                  {{ type | payment_type_svg_tag }}
                </div>

              {% endfor %}

            {% endif %}

          </div>

        {% endif %}


        {% if section.settings.show_policy %}

          <ul class="kf-footer__policies">

            {% if shop.privacy_policy != blank %}
              <li>
                <a href="{{ shop.privacy_policy.url }}">
                  Privacy
                </a>
              </li>
            {% endif %}

            {% if shop.terms_of_service != blank %}
              <li>
                <a href="{{ shop.terms_of_service.url }}">
                  Terms
                </a>
              </li>
            {% endif %}

            {% if shop.refund_policy != blank %}
              <li>
                <a href="{{ shop.refund_policy.url }}">
                  Refunds
                </a>
              </li>
            {% endif %}

          </ul>

        {% endif %}

      </div>

    </div>

  </div>
</footer>


{% schema %}
{
  "name": "Karthika Modern Footer",

  "settings": [
    {
      "type": "image_picker",
      "id": "footer_image",
      "label": "Footer feature image",
      "info": "Optional. If empty, the footer uses a built-in graphic background."
    },
    {
      "type": "header",
      "content": "Store information"
    },
    {
      "type": "textarea",
      "id": "store_address",
      "label": "Store address",
      "default": "34 Buffalo Road, Singapore 219796"
    },
    {
      "type": "text",
      "id": "helpline_phone",
      "label": "Helpline",
      "default": "(65) 6297 7533"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Email",
      "default": "grocery@karthika.sg"
    },
    {
      "type": "text",
      "id": "gst_number",
      "label": "GST registration number",
      "default": "200311912H"
    },
    {
      "type": "text",
      "id": "fax_number",
      "label": "Fax",
      "default": "(65) 62977511"
    },
    {
      "type": "header",
      "content": "Menus"
    },
    {
      "type": "link_list",
      "id": "shop_menu",
      "label": "Shop menu"
    },
    {
      "type": "text",
      "id": "help_menu",
      "label": "Help menu handle",
      "info": "Enter the handle of the menu to display."
    },
    {
      "type": "text",
      "id": "company_menu",
      "label": "Company menu handle",
      "info": "Enter the handle of the menu to display."
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "label": "Show newsletter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social links",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "payment_enable",
      "label": "Show payment methods",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_policy",
      "label": "Show policy links",
      "default": true
    }
  ],

  "blocks": [
    {
      "type": "@app"
    }
  ],

  "presets": [
    {
      "name": "Karthika Modern Footer"
    }
  ]
}
{% endschema %}