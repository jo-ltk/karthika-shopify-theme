{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-search.css' | asset_url | stylesheet_tag }}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

<script src="{{ 'main-search.js' | asset_url }}" defer="defer"></script>

<style>
  /* =========================================================
     SEARCH PAGE — Karthika Redesign
     Tokens from karthika-grocery.css are used throughout
     ========================================================= */

  /* --- Override generic Dawn layout on this page --- */
  .template-search .template-search__header {
    margin-bottom: 0;
    padding: 16px 16px 0;
  }

  .template-search .template-search__search {
    margin: 0 0 0;
    max-width: none;
  }

  /* --- Page heading block --- */
  .ks-page-heading {
    padding: 12px 16px 4px;
  }

  .ks-page-heading h1 {
    margin: 0 0 4px;
    font-size: 24px;
    font-weight: var(--karthika-weight-bold, 700);
    color: var(--karthika-text-dark, #171717);
    line-height: 1.2;
    letter-spacing: -0.4px;
    text-align: left;
  }

  .ks-subheading {
    margin: 0;
    font-size: 13px;
    color: var(--karthika-text-muted, #5C6B52);
  }

  .ks-subheading strong {
    color: var(--karthika-red, #3F7D2E);
    font-weight: var(--karthika-weight-semibold, 600);
  }

  /* --- Search input row --- */
  .ks-search-row {
    display: flex;
    align-items: center;
    padding: 10px 16px 12px;
  }

  .ks-search-pill {
    flex: 1;
    display: flex;
    align-items: center;
    background: #fff;
    border: 1.5px solid var(--karthika-border, #E1E8D3);
    border-radius: 9999px;
    padding: 0 5px 0 12px;
    overflow: hidden;
    box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    transition: border-color 0.15s ease;
  }
  .ks-search-pill:focus-within {
    border-color: var(--karthika-red, #3F7D2E);
  }

  .ks-search-pill-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    color: #9DB492;
    margin-right: 8px;
  }

  .ks-search-pill input[type="search"],
  .ks-search-pill input[type="text"] {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-size: 14px;
    font-weight: 500;
    color: var(--karthika-text-dark);
    padding: 11px 0;
    min-width: 0;
    font-family: inherit;
    -webkit-appearance: none;
  }
  .ks-search-pill input[type="search"]::-webkit-search-cancel-button {
    -webkit-appearance: none;
    display: none;
  }
  .ks-search-pill input[type="search"]:focus,
  .ks-search-pill input[type="search"]:focus-visible {
    outline: none;
    box-shadow: none;
  }

  .ks-pill-submit-btn {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--karthika-red, #3F7D2E);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #fff;
    padding: 0;
    margin: 3px;
    transition: background 0.15s;
  }
  .ks-pill-submit-btn:hover { background: var(--karthika-red-hover, #336524); }
  .ks-pill-submit-btn svg {
    width: 15px;
    height: 15px;
    display: block;
  }
  .ks-pill-submit-btn:focus-visible {
    outline: 2px solid var(--karthika-red, #3F7D2E);
    outline-offset: 2px;
  }

  .ks-live-search { flex: 1; display: flex; min-width: 0; }
  .ks-search-form { display: flex; width: 100%; }

  /* --- Compact filter bar (cvat) --- */
  .ks-cvat-bar {
    display: flex;
    align-items: center;
    padding: 4px 0 10px;
    border-bottom: 1px solid var(--karthika-border-light, #EAF0DE);
    /* NO overflow here — overflow clips absolute dropdowns */
  }

  /* scrollable inner track holds chips but doesn't clip dropdowns */
  .ks-cvat-scroll {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 0 16px;
    overflow-x: auto;
    -ms-overflow-style: none;
    scrollbar-width: none;
    flex: 1;
    /* overflow-x:auto creates a scroll context but NOT a stacking context,
       so position:absolute children of .ks-cvat-item still escape it */
  }
  .ks-cvat-scroll::-webkit-scrollbar { display: none; }

  /* wrapper around each chip + its dropdown */
  .ks-cvat-item {
    position: static; /* dropdown uses fixed positioning instead */
    flex-shrink: 0;
  }

  /* each pill chip */
  .ks-cvat-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 7px 12px;
    border-radius: 9999px;
    border: 1.5px solid var(--karthika-border, #E1E8D3);
    background: #fff;
    color: var(--karthika-text-dark, #171717);
    font-size: 12.5px;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition: background 0.14s, border-color 0.14s, color 0.14s;
    font-family: inherit;
    line-height: 1;
  }
  .ks-cvat-chip svg {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    transition: transform 0.18s;
  }
  .ks-cvat-chip--active,
  .ks-cvat-item.is-open .ks-cvat-chip {
    background: var(--karthika-red-subtle, #EAF4DE);
    border-color: var(--karthika-red, #3F7D2E);
    color: var(--karthika-red, #3F7D2E);
  }
  .ks-cvat-item.is-open .ks-cvat-chip svg.ks-caret { transform: rotate(180deg); }

  /* result count — right-aligned inside the bar */
  .ks-cvat-count {
    margin-left: auto;
    flex-shrink: 0;
    font-size: 12px;
    color: var(--karthika-text-muted, #5C6B52);
    white-space: nowrap;
    padding-left: 8px;
  }

  /* active filter tags row */
  .ks-cvat-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 6px 16px 4px;
  }
  .ks-cvat-tags:empty { display: none; }
  .ks-cvat-tag {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px 4px 12px;
    border-radius: 9999px;
    background: var(--karthika-red-subtle, #EAF4DE);
    color: var(--karthika-red, #3F7D2E);
    font-size: 11.5px;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid rgba(63,125,46,0.25);
  }
  .ks-cvat-tag svg { width: 11px; height: 11px; }

  /* invisible backdrop to catch outside clicks */
  .ks-cvat-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 99;
  }
  .ks-cvat-backdrop.is-open { display: block; }

  /* ── dropdown panel (fixed so it escapes overflow:auto containers) ── */
  .ks-cvat-dropdown {
    display: none;
    position: fixed;     /* JS sets top + left via style attribute */
    min-width: 220px;
    max-width: 300px;
    background: #fff;
    border: 1.5px solid var(--karthika-border, #E1E8D3);
    border-radius: 14px;
    box-shadow: 0 8px 28px rgba(0,0,0,0.12);
    z-index: 1000;
    overflow: hidden;
    animation: cvat-drop-in 0.16s ease;
  }
  .ks-cvat-item.is-open .ks-cvat-dropdown { display: block; }

  @keyframes cvat-drop-in {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .ks-cvat-dropdown-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px 10px;
    border-bottom: 1px solid var(--karthika-border-light, #EAF0DE);
  }
  .ks-cvat-dropdown-title {
    font-size: 13px;
    font-weight: 700;
    color: var(--karthika-text-dark, #171717);
    margin: 0;
  }
  .ks-cvat-dropdown-clear {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--karthika-red, #3F7D2E);
    text-decoration: none;
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
    padding: 0;
  }
  .ks-cvat-dropdown-clear:hover { text-decoration: underline; }

  .ks-cvat-dropdown-body {
    max-height: 260px;
    overflow-y: auto;
  }

  /* option rows */
  .ks-cvat-option-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ks-cvat-option-list li + li {
    border-top: 1px solid var(--karthika-border-light, #EAF0DE);
  }
  .ks-cvat-option-list label {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 14px;
    cursor: pointer;
    font-size: 13.5px;
    color: var(--karthika-text-dark);
    font-weight: 500;
  }
  .ks-cvat-option-list input[type="checkbox"] {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    accent-color: var(--karthika-red, #3F7D2E);
    flex-shrink: 0;
    cursor: pointer;
  }
  .ks-cvat-option-count {
    margin-left: auto;
    font-size: 11px;
    color: var(--karthika-text-muted);
  }
  .ks-cvat-option-disabled label { opacity: 0.38; pointer-events: none; }

  /* price range */
  .ks-cvat-price-range {
    padding: 12px 14px;
    display: flex;
    gap: 8px;
    align-items: flex-end;
  }
  .ks-cvat-price-field {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .ks-cvat-price-range > .ks-cvat-price-field > label {
    font-size: 10.5px;
    font-weight: 600;
    color: var(--karthika-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .ks-cvat-price-range input[type="text"] {
    width: 100%;
    padding: 8px 10px;
    border: 1.5px solid var(--karthika-border);
    border-radius: 8px;
    font-size: 13px;
    font-family: inherit;
    outline: none;
    box-sizing: border-box;
  }
  .ks-cvat-price-range input[type="text"]:focus {
    border-color: var(--karthika-red, #3F7D2E);
  }
  .ks-cvat-price-sep {
    font-size: 13px;
    color: var(--karthika-text-muted);
    padding-bottom: 10px;
    flex-shrink: 0;
  }

  /* sort list (radio) */
  .ks-cvat-sort-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ks-cvat-sort-list li + li {
    border-top: 1px solid var(--karthika-border-light, #EAF0DE);
  }
  .ks-cvat-sort-list label {
    display: flex;
    align-items: center;
    padding: 11px 14px;
    cursor: pointer;
    font-size: 13.5px;
    color: var(--karthika-text-dark);
    font-weight: 500;
    gap: 10px;
  }
  .ks-cvat-sort-list input[type="radio"] {
    width: 16px;
    height: 16px;
    accent-color: var(--karthika-red, #3F7D2E);
    flex-shrink: 0;
  }

  /* apply / footer row inside dropdown */
  .ks-cvat-dropdown-footer {
    display: flex;
    gap: 8px;
    padding: 10px 14px;
    border-top: 1px solid var(--karthika-border-light, #EAF0DE);
  }
  .ks-cvat-btn-clear {
    flex: 1;
    padding: 9px;
    border-radius: 9999px;
    border: 1.5px solid var(--karthika-border);
    background: #fff;
    font-size: 12.5px;
    font-weight: 700;
    color: var(--karthika-text-dark);
    cursor: pointer;
    font-family: inherit;
    text-decoration: none;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ks-cvat-btn-apply {
    flex: 1;
    padding: 9px;
    border-radius: 9999px;
    border: none;
    background: var(--karthika-red, #3F7D2E);
    color: #fff;
    font-size: 12.5px;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
  }
  .ks-cvat-btn-apply:hover { background: var(--karthika-red-hover, #336524); }

  /* --- Product Grid Container --- */
  .ks-product-grid-wrap {
    padding: 14px 12px;
    width: 100%;
    box-sizing: border-box;
  }

  /* 3-column grid */
  .ks-product-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
  }

  .ks-product-grid > .grid__item {
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  @media screen and (max-width: 479px) {
    .ks-product-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
    }
  }

  @media screen and (min-width: 900px) {
    .ks-product-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
    }
  }

  /* --- Special Offer Banner --- */
  .ks-offer-banner {
    margin: 4px 12px 12px;
    background: #E8F5E0;
    border-radius: var(--karthika-radius-lg, 24px);
    overflow: hidden;
    display: flex;
    align-items: stretch;
    min-height: 180px;
    position: relative;
  }

  .ks-offer-banner-left {
    flex: 1;
    padding: 20px 16px 20px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    z-index: 1;
  }

  .ks-offer-tag-row {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 10px;
    font-weight: var(--karthika-weight-bold, 700);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--karthika-red, #3F7D2E);
  }

  .ks-offer-tag-row svg {
    width: 14px;
    height: 14px;
  }

  .ks-offer-headline {
    margin: 0;
    font-size: 22px;
    font-weight: var(--karthika-weight-heavy, 800);
    color: var(--karthika-text-dark, #171717);
    line-height: 1.15;
    letter-spacing: -0.5px;
  }

  .ks-offer-subtext {
    margin: 0;
    font-size: 12.5px;
    color: var(--karthika-text-muted, #5C6B52);
    line-height: 1.4;
  }

  .ks-offer-subtext strong {
    color: var(--karthika-red, #3F7D2E);
    font-weight: var(--karthika-weight-bold, 700);
  }

  .ks-offer-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
    padding: 9px 18px;
    background: #264D1A;
    color: #fff;
    border-radius: var(--karthika-radius-pill, 9999px);
    font-size: 13px;
    font-weight: var(--karthika-weight-bold, 700);
    text-decoration: none;
    border: none;
    cursor: pointer;
    width: fit-content;
    transition: background 0.18s;
  }

  .ks-offer-cta:hover {
    background: #1a3811;
  }

  .ks-offer-banner-right {
    flex: 0 0 140px;
    position: relative;
    overflow: visible;
  }

  .ks-offer-product-img {
    position: absolute;
    bottom: -10px;
    right: -5px;
    width: 155px;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 8px 18px rgba(0,0,0,0.12));
  }

  /* Leaf decoration */
  .ks-offer-leaf {
    position: absolute;
    opacity: 0.7;
    pointer-events: none;
  }

  .ks-offer-leaf--1 {
    top: 12px;
    right: 130px;
    width: 22px;
    height: 22px;
    transform: rotate(-20deg);
  }

  .ks-offer-leaf--2 {
    top: 35px;
    right: 60px;
    width: 16px;
    height: 16px;
    transform: rotate(30deg);
  }

  .ks-offer-leaf--3 {
    bottom: 30px;
    right: 145px;
    width: 18px;
    height: 18px;
    transform: rotate(-40deg);
  }

  /* --- Cart Summary Bar --- */
  .ks-cart-bar {
    margin: 8px 12px 14px;
    padding: 12px 16px;
    background: #fff;
    border: 1.5px solid var(--karthika-border, #E1E8D3);
    border-radius: var(--karthika-radius-pill, 9999px);
    display: flex;
    align-items: center;
    gap: 10px;
    box-shadow: var(--karthika-shadow-card);
    text-decoration: none;
  }

  .ks-cart-bar:hover {
    border-color: var(--karthika-red, #3F7D2E);
  }

  .ks-cart-bar-left {
    display: flex;
    align-items: center;
    gap: 7px;
    flex-shrink: 0;
  }

  .ks-cart-bar-left svg {
    width: 20px;
    height: 20px;
    color: var(--karthika-red, #3F7D2E);
  }

  .ks-cart-bar-label {
    font-size: 13px;
    font-weight: var(--karthika-weight-bold, 700);
    color: var(--karthika-red, #3F7D2E);
    white-space: nowrap;
  }

  .ks-cart-bar-thumbs {
    display: flex;
    align-items: center;
    flex: 1;
    justify-content: center;
    gap: -6px;
  }

  .ks-cart-thumb {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 2px solid #fff;
    object-fit: cover;
    margin-left: -6px;
    background: var(--karthika-bg-surface);
  }

  .ks-cart-thumb:first-child {
    margin-left: 0;
  }

  .ks-cart-more {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 2px solid #fff;
    background: var(--karthika-red-subtle, #EAF4DE);
    color: var(--karthika-red, #3F7D2E);
    font-size: 10px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: -6px;
    flex-shrink: 0;
  }

  .ks-cart-bar-right {
    flex-shrink: 0;
    font-size: 13px;
    font-weight: var(--karthika-weight-semibold, 600);
    color: var(--karthika-red, #3F7D2E);
    white-space: nowrap;
  }

  /* --- Empty / no-results state --- */
  .ks-no-results {
    padding: 40px 24px;
    text-align: center;
    color: var(--karthika-text-muted);
    font-size: 14px;
  }

  /* --- Section padding override --- */
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
</style>

{%- liquid
  assign sort_by = search.sort_by | default: search.default_sort_by
  assign terms = search.terms | escape
  assign search_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
  assign has_active_filters = false
  for filter in search.filters
    if filter.active_values.size > 0
      assign has_active_filters = true
    endif
  endfor
-%}

{% paginate search.results by 24 %}
<div class="template-search{% unless search.performed and search.results_count > 0 %} template-search--empty{% endunless %} section-{{ section.id }}-padding">

  <!-- ── Page heading ──────────────────────────────────────── -->
  <div class="ks-page-heading">
    <h1>
      {%- if search.performed -%}Search results{%- else -%}Search{%- endif -%}
    </h1>
    {%- if search.performed and search.terms != blank -%}
      <p class="ks-subheading">
        Showing results for <strong>"{{ search.terms | escape }}"</strong>
      </p>
    {%- endif -%}
  </div>

  <!-- ── Search input ───────────────────────────── -->
  <div class="ks-search-row">
    {%- if settings.predictive_search_enabled -%}
      <predictive-search class="karthika-live-search ks-live-search" data-loading-text="{{ 'accessibility.loading' | t }}">
    {%- endif -%}
    <main-search class="ks-live-search">
      <form action="{{ routes.search_url }}" method="get" role="search" class="ks-search-form" id="KarthikaSearchPageForm">
        <div class="ks-search-pill">
          <svg class="ks-search-pill-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"/><line x1="16.65" y1="16.65" x2="21" y2="21"/>
          </svg>
          <label class="visually-hidden" for="Search-In-Template">{{ 'general.search.search' | t }}</label>
          <input
            class="search__input"
            id="Search-In-Template"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="Search for groceries, spices, snacks..."
            {%- if settings.predictive_search_enabled -%}
              role="combobox"
              aria-expanded="false"
              aria-owns="predictive-search-results"
              aria-controls="predictive-search-results"
              aria-haspopup="listbox"
              aria-autocomplete="list"
              autocorrect="off"
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
            {%- endif -%}
          >
          <input name="options[prefix]" type="hidden" value="last">
          <input name="type" type="hidden" value="product">
          <button type="submit" class="ks-pill-submit-btn" aria-label="{{ 'general.search.search' | t }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7"/><line x1="16.65" y1="16.65" x2="21" y2="21"/>
            </svg>
          </button>
        </div>

        {%- if settings.predictive_search_enabled -%}
          <div class="predictive-search predictive-search--search-template" tabindex="-1" data-predictive-search>
            {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
          </div>
          <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
        {%- endif -%}
      </form>
    </main-search>
    {%- if settings.predictive_search_enabled -%}
      </predictive-search>
    {%- endif -%}
  </div>

  <div id="KarthikaSearchPageError" class="karthika-search-error" hidden role="alert"></div>

  {%- if search.performed -%}

    {%- comment -%} ── Compact Filter Bar (cvat) ─────────────────────────── {%- endcomment -%}
    {%- liquid
      assign sort_by = search.sort_by | default: search.default_sort_by
      assign search_base_url = '?q=' | append: terms | append: '&type=product&options%5Bprefix%5D=last'
    -%}

    <div class="ks-cvat-bar" role="toolbar" aria-label="Filter and sort">
      <div class="ks-cvat-scroll">

      {%- comment -%} Sort chip {%- endcomment -%}
      {%- if section.settings.enable_sorting -%}
        <div class="ks-cvat-item">
          <button
            type="button"
            class="ks-cvat-chip{% if sort_by != search.default_sort_by %} ks-cvat-chip--active{% endif %}"
            aria-expanded="false"
            data-cvat-item
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M3 6h18M6 12h12M10 18h4"/>
            </svg>
            Sort
            <svg class="ks-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </button>
          <div class="ks-cvat-dropdown">
            <div class="ks-cvat-dropdown-head">
              <p class="ks-cvat-dropdown-title">Sort by</p>
            </div>
            <div class="ks-cvat-dropdown-body">
              <form id="ks-cvat-sort-form" action="{{ routes.search_url }}" method="get">
                <input type="hidden" name="q" value="{{ search.terms | escape }}">
                <input type="hidden" name="type" value="product">
                <input type="hidden" name="options[prefix]" value="last">
                {%- for filter in search.filters -%}
                  {%- for value in filter.active_values -%}
                    <input type="hidden" name="{{ value.param_name }}" value="{{ value.value | escape }}">
                  {%- endfor -%}
                  {%- if filter.type == 'price_range' -%}
                    {%- if filter.min_value.value -%}
                      <input type="hidden" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency }}">
                    {%- endif -%}
                    {%- if filter.max_value.value -%}
                      <input type="hidden" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency }}">
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
                <ul class="ks-cvat-sort-list">
                  {%- for option in search.sort_options -%}
                    <li>
                      <label>
                        <input type="radio" name="sort_by" value="{{ option.value | escape }}"
                          {% if option.value == sort_by %}checked{% endif %}
                          onchange="this.form.submit()">
                        {{ option.name | escape }}
                      </label>
                    </li>
                  {%- endfor -%}
                </ul>
              </form>
            </div>
          </div>
        </div>
      {%- endif -%}

      {%- comment -%} One chip+dropdown per filter {%- endcomment -%}
      {%- if section.settings.enable_filtering -%}
        {%- for filter in search.filters -%}
          {%- assign chip_active = false -%}
          {%- if filter.active_values.size > 0 -%}{%- assign chip_active = true -%}{%- endif -%}
          {%- if filter.type == 'price_range' -%}
            {%- if filter.min_value.value or filter.max_value.value -%}{%- assign chip_active = true -%}{%- endif -%}
          {%- endif -%}
          <div class="ks-cvat-item">
            <button
              type="button"
              class="ks-cvat-chip{% if chip_active %} ks-cvat-chip--active{% endif %}"
              aria-expanded="false"
              data-cvat-item
            >
              {{ filter.label | escape }}
              {%- if filter.active_values.size > 0 -%}
                &nbsp;<span>({{ filter.active_values.size }})</span>
              {%- endif -%}
              <svg class="ks-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </button>
            <div class="ks-cvat-dropdown">
              <div class="ks-cvat-dropdown-head">
                <p class="ks-cvat-dropdown-title">{{ filter.label | escape }}</p>
                <a href="{{ filter.url_to_remove }}" class="ks-cvat-dropdown-clear">Clear</a>
              </div>
              <div class="ks-cvat-dropdown-body">
                <form action="{{ routes.search_url }}" method="get">
                  <input type="hidden" name="q" value="{{ search.terms | escape }}">
                  <input type="hidden" name="type" value="product">
                  <input type="hidden" name="options[prefix]" value="last">
                  <input type="hidden" name="sort_by" value="{{ sort_by | escape }}">
                  {%- for other_filter in search.filters -%}
                    {%- if other_filter.param_name != filter.param_name -%}
                      {%- for value in other_filter.active_values -%}
                        <input type="hidden" name="{{ value.param_name }}" value="{{ value.value | escape }}">
                      {%- endfor -%}
                      {%- if other_filter.type == 'price_range' -%}
                        {%- if other_filter.min_value.value -%}
                          <input type="hidden" name="{{ other_filter.min_value.param_name }}" value="{{ other_filter.min_value.value | money_without_currency }}">
                        {%- endif -%}
                        {%- if other_filter.max_value.value -%}
                          <input type="hidden" name="{{ other_filter.max_value.param_name }}" value="{{ other_filter.max_value.value | money_without_currency }}">
                        {%- endif -%}
                      {%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}

                  {%- case filter.type -%}
                    {%- when 'boolean', 'list' -%}
                      <ul class="ks-cvat-option-list">
                        {%- for value in filter.values -%}
                          {%- assign is_disabled = false -%}
                          {%- if value.count == 0 and value.active == false -%}{%- assign is_disabled = true -%}{%- endif -%}
                          <li class="{% if is_disabled %}ks-cvat-option-disabled{% endif %}">
                            <label>
                              <input type="checkbox"
                                name="{{ value.param_name }}"
                                value="{{ value.value | escape }}"
                                {% if value.active %}checked{% endif %}
                                {% if is_disabled %}disabled{% endif %}
                              >
                              {{ value.label | escape }}
                              <span class="ks-cvat-option-count">({{ value.count }})</span>
                            </label>
                          </li>
                        {%- endfor -%}
                      </ul>
                      <div class="ks-cvat-dropdown-footer">
                        <button type="submit" class="ks-cvat-btn-apply">Apply</button>
                      </div>
                    {%- when 'price_range' -%}
                      <div class="ks-cvat-price-range">
                        <div class="ks-cvat-price-field">
                          <label for="cvat-price-min-{{ forloop.index }}">Min ({{ cart.currency.symbol }})</label>
                          <input type="text" id="cvat-price-min-{{ forloop.index }}"
                            name="{{ filter.min_value.param_name }}"
                            inputmode="decimal"
                            placeholder="0"
                            value="{{ filter.min_value.value | money_without_currency }}"
                          >
                        </div>
                        <span class="ks-cvat-price-sep">–</span>
                        <div class="ks-cvat-price-field">
                          <label for="cvat-price-max-{{ forloop.index }}">Max ({{ cart.currency.symbol }})</label>
                          <input type="text" id="cvat-price-max-{{ forloop.index }}"
                            name="{{ filter.max_value.param_name }}"
                            inputmode="decimal"
                            placeholder="{{ filter.range_max | money_without_currency }}"
                            value="{{ filter.max_value.value | money_without_currency }}"
                          >
                        </div>
                      </div>
                      <div class="ks-cvat-dropdown-footer">
                        <button type="submit" class="ks-cvat-btn-apply">Apply</button>
                      </div>
                  {%- endcase -%}
                </form>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}

      {%- comment -%} Result count — pushed right {%- endcomment -%}
      <span class="ks-cvat-count" role="status">
        {%- if search.results_count -%}
          {{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %}
        {%- endif -%}
      </span>
      </div>{%- comment -%} /.ks-cvat-scroll {%- endcomment -%}
    </div>

    {%- comment -%} ── Active filter tags ───────────────────────────────── {%- endcomment -%}
    {%- if section.settings.enable_filtering -%}
      <div class="ks-cvat-tags">
        {%- for filter in search.filters -%}
          {%- for value in filter.active_values -%}
            <a href="{{ value.url_to_remove }}" class="ks-cvat-tag">
              {{ value.label | escape }}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </a>
          {%- endfor -%}
          {%- if filter.type == 'price_range' -%}
            {%- assign pmin = filter.min_value.value -%}
            {%- assign pmax = filter.max_value.value -%}
            {%- if pmin != null or pmax != null -%}
              <a href="{{ filter.url_to_remove }}" class="ks-cvat-tag">
                {{ pmin | default: 0 | money }} – {{ pmax | default: filter.range_max | money }}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </a>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} ── Backdrop (catches outside-clicks) ────────────────── {%- endcomment -%}
    <div class="ks-cvat-backdrop" id="ks-cvat-backdrop" aria-hidden="true"></div>

  {%- endif -%}

  <!-- ── Product Grid ───────────────────────────────────────── -->
  {%- if search.performed -%}
    {%- if search.results_count == 0 -%}
      <div class="ks-product-grid-wrap collection" id="ProductGridContainer">
        <div class="loading-overlay gradient"></div>
        <div class="ks-no-results" id="product-grid" data-id="{{ section.id }}" role="status">
          <p>No results found{% if search.terms != blank %} for <strong>"{{ search.terms | escape }}"</strong>{% endif %}.</p>
          <p>Try a different search term{% if section.settings.enable_filtering %}, clear filters,{% endif %} or browse our categories.</p>
          {%- if has_active_filters -%}
            <p><a href="{{ search_url }}">Clear filters</a></p>
          {%- endif -%}
        </div>
      </div>
    {%- else -%}
      <div class="ks-product-grid-wrap collection" id="ProductGridContainer">
        <div class="loading-overlay gradient"></div>
        <ul
          class="ks-product-grid"
          id="product-grid"
          data-id="{{ section.id }}"
          role="list"
        >
          {%- assign skip_card_product_styles = false -%}
          {%- for item in search.results -%}
            {% assign lazy_load = false %}
            {%- if forloop.index > 4 -%}
              {%- assign lazy_load = true -%}
            {%- endif -%}

            <li class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.animations_reveal_on_scroll %}data-cascade{% endif %}
            >
              {%- case item.object_type -%}
                {%- when 'product' -%}
                  {% render 'card-product',
                    card_product: item,
                    media_aspect_ratio: section.settings.image_ratio,
                    image_shape: section.settings.image_shape,
                    show_secondary_image: section.settings.show_secondary_image,
                    show_vendor: section.settings.show_vendor,
                    show_rating: section.settings.show_rating,
                    lazy_load: lazy_load,
                    skip_styles: skip_card_product_styles,
                    product_view_context: 'search'
                  %}
                  {%- assign skip_card_product_styles = true -%}
                {%- when 'article' -%}
                  {% render 'article-card',
                    article: item,
                    show_image: true,
                    show_date: section.settings.article_show_date,
                    show_author: section.settings.article_show_author,
                    show_badge: true,
                    media_aspect_ratio: 1,
                    lazy_load: lazy_load
                  %}
                {%- when 'page' -%}
                  <div class="article-card-wrapper card-wrapper underline-links-hover">
                    <div class="card card--card card--text ratio color-{{ settings.blog_card_color_scheme }}" style="--ratio-percent: 100%;">
                      <div class="card__content">
                        <div class="card__information">
                          <h3 class="card__heading">
                            <a href="{{ item.url }}" class="full-unstyled-link">
                              {{ item.title | truncate: 50 | escape }}
                            </a>
                          </h3>
                        </div>
                      </div>
                    </div>
                  </div>
              {%- endcase -%}
            </li>
          {%- endfor -%}
        </ul>

        {%- if paginate.pages > 1 -%}
          {% render 'pagination', paginate: paginate %}
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endif -%}

    <!-- ── Cart Summary Bar ───────────────────────────────── -->
    <a
      href="{{ routes.cart_url }}"
      class="ks-cart-bar karthika-cart-trigger{% if cart.item_count == 0 %} is-empty{% endif %}"
      aria-label="View cart — {{ cart.item_count }} items"
      {% if settings.cart_type == 'drawer' %}
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="CartDrawer"
      {% endif %}
      {% if cart.item_count == 0 %}hidden{% endif %}
    >
      <div class="ks-cart-bar-left">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span class="ks-cart-bar-label">CART {{ cart.item_count }} ITEM{% if cart.item_count != 1 %}S{% endif %}</span>
      </div>

      <div class="ks-cart-bar-thumbs" aria-hidden="true">
        {%- assign shown = 0 -%}
        {%- capture cart_line_keys_newest -%}
          {%- render 'cart-items-newest-first' -%}
        {%- endcapture -%}
        {%- assign cart_line_keys_newest = cart_line_keys_newest | strip | split: '|' -%}
        {%- for cart_line_key in cart_line_keys_newest -%}
          {%- if shown >= 3 -%}
            {%- break -%}
          {%- endif -%}
          {%- for item in cart.items -%}
            {%- if item.key == cart_line_key and item.image -%}
              <img
                src="{{ item.image | image_url: width: 64 }}"
                alt=""
                class="ks-cart-thumb"
                loading="lazy"
                width="32"
                height="32"
              >
              {%- assign shown = shown | plus: 1 -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>

      <span class="ks-cart-bar-right">View cart →</span>
    </a>
</div>
{% endpaginate %}

<script>
(function() {
  var backdrop = document.getElementById('ks-cvat-backdrop');

  function positionDropdown(item) {
    var chip = item.querySelector('.ks-cvat-chip');
    var drop = item.querySelector('.ks-cvat-dropdown');
    if (!chip || !drop) return;

    var rect = chip.getBoundingClientRect();
    var dropWidth = Math.max(drop.offsetWidth, 220);
    var gap = 6;

    var top = rect.bottom + gap;
    var left = rect.left;

    // keep inside right edge of viewport
    if (left + dropWidth > window.innerWidth - 8) {
      left = window.innerWidth - dropWidth - 8;
    }
    // keep inside left edge
    if (left < 8) left = 8;

    drop.style.top  = top + 'px';
    drop.style.left = left + 'px';
  }

  function closeAll() {
    document.querySelectorAll('.ks-cvat-item.is-open').forEach(function(item) {
      item.classList.remove('is-open');
      var btn = item.querySelector('[data-cvat-item]');
      if (btn) btn.setAttribute('aria-expanded', 'false');
    });
    if (backdrop) backdrop.classList.remove('is-open');
  }

  document.querySelectorAll('[data-cvat-item]').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      var item = btn.closest('.ks-cvat-item');
      var isOpen = item.classList.contains('is-open');
      closeAll();
      if (!isOpen) {
        item.classList.add('is-open');
        btn.setAttribute('aria-expanded', 'true');
        positionDropdown(item);   // position AFTER display:block kicks in
        if (backdrop) backdrop.classList.add('is-open');
      }
    });
  });

  // reposition on scroll / resize so dropdown tracks the chip
  window.addEventListener('scroll', function() {
    var open = document.querySelector('.ks-cvat-item.is-open');
    if (open) positionDropdown(open);
  }, { passive: true });

  window.addEventListener('resize', function() {
    var open = document.querySelector('.ks-cvat-item.is-open');
    if (open) positionDropdown(open);
  });

  document.addEventListener('click', function(e) {
    if (!e.target.closest('.ks-cvat-item')) closeAll();
  });
  if (backdrop) backdrop.addEventListener('click', closeAll);
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeAll();
  });
})();
</script>

