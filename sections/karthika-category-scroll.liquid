<div id="karthika-categories-{{ section.id }}" class="karthika-category-section">
  {%- assign visible_cats = 0 -%}
  {%- for block in section.blocks -%}
    {%- assign col = block.settings.collection -%}
    {%- if col != blank and col.url != blank -%}
      {%- assign visible_cats = visible_cats | plus: 1 -%}
    {%- elsif block.settings.custom_link != blank -%}
      {%- assign visible_cats = visible_cats | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if visible_cats > 0 or request.design_mode -%}
    <div class="karthika-section-head karthika-section-head--compact" style="margin-top: 4px;">
      <h2 class="karthika-section-head-title">{{ section.settings.title | default: 'Shop by category' }}</h2>
      <a href="{{ routes.collections_url }}" class="karthika-section-head-link">
        {{ section.settings.link_text | default: 'See all' }}
      </a>
    </div>

    <div class="karthika-category-scroll-outer">
      <div class="karthika-category-scroll-wrap karthika-hide-scrollbar" id="karthikaCatScroll-{{ section.id }}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign col = block.settings.collection
            assign cat_url = blank
            assign cat_title = block.settings.title
            if col != blank and col.url != blank
              assign cat_url = col.url
              if cat_title == blank
                assign cat_title = col.title
              endif
            elsif block.settings.custom_link != blank
              assign cat_url = block.settings.custom_link
            endif
          -%}
          {%- if cat_url != blank -%}
            <a href="{{ cat_url }}" class="karthika-category-card" {{ block.shopify_attributes }}>
              <div class="karthika-category-card-img-box">
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 140 }}" alt="{{ cat_title | escape }}" class="karthika-category-card-img" width="72" height="72" loading="lazy">
                {%- elsif col != blank and col.featured_image -%}
                  <img src="{{ col.featured_image | image_url: width: 140 }}" alt="{{ cat_title | escape }}" class="karthika-category-card-img" width="72" height="72" loading="lazy">
                {%- endif -%}
              </div>
              <span class="karthika-category-card-name">{{ cat_title | default: 'Category' }}</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- if visible_cats > 0 -%}
      <div class="karthika-cat-indicator" id="karthikaCatDots-{{ section.id }}" aria-hidden="true">
        <span class="karthika-cat-dot is-active"></span>
        <span class="karthika-cat-dot"></span>
        <span class="karthika-cat-dot"></span>
      </div>
    {%- elsif request.design_mode -%}
      <p class="karthika-empty-state">Select a collection on each category card in the theme editor.</p>
    {%- endif -%}
  {%- endif -%}
</div>

{%- if visible_cats > 0 -%}
<script>
  (function() {
    var wrap = document.getElementById('karthikaCatScroll-{{ section.id }}');
    var dotsWrap = document.getElementById('karthikaCatDots-{{ section.id }}');
    if (!wrap || !dotsWrap) return;
    var dots = dotsWrap.querySelectorAll('.karthika-cat-dot');
    wrap.addEventListener('scroll', function() {
      var ratio = wrap.scrollLeft / (wrap.scrollWidth - wrap.clientWidth || 1);
      var idx = ratio < 0.33 ? 0 : ratio < 0.66 ? 1 : 2;
      dots.forEach(function(d, i) { d.classList.toggle('is-active', i === idx); });
    }, { passive: true });
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Karthika Categories",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link Text",
      "default": "See all"
    }
  ],
  "blocks": [
    {
      "type": "category_item",
      "name": "Category Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category Name"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Photography"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "url",
          "id": "custom_link",
          "label": "Custom Link",
          "info": "Used only when no collection is selected."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Karthika Categories",
      "blocks": [
        { "type": "category_item", "settings": { "title": "Rice & Grains" } },
        { "type": "category_item", "settings": { "title": "Spices" } },
        { "type": "category_item", "settings": { "title": "Snacks" } },
        { "type": "category_item", "settings": { "title": "Vegetables" } },
        { "type": "category_item", "settings": { "title": "Dairy" } }
      ]
    }
  ]
}
{% endschema %}
