{%- comment -%}
  Karthika AI Shopping Assistant & Recipe Meal Builder Section
  "Not sure what to cook? Tell Karthika what you're making and we'll find the ingredients."
{%- endcomment -%}

<div class="karthika-ai-assistant-card">
  <div class="karthika-ai-badge">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
    </svg>
    <span>Karthika AI Assistant</span>
  </div>

  <h3 class="karthika-ai-title">{{ section.settings.heading | default: "Not sure what to cook?" }}</h3>
  <p class="karthika-ai-desc">{{ section.settings.subheading | default: "Tell Karthika what you're making and we'll find the fresh ingredients." }}</p>

  <!-- AI Custom Prompt Input -->
  <form id="KarthikaAIPromptForm" class="karthika-ai-prompt-form">
    <div class="karthika-ai-input-wrap">
      <input
        type="text"
        id="KarthikaAIPromptInput"
        class="karthika-ai-input"
        placeholder="e.g. Fish Curry for 4 people, Beef Roast..."
        autocomplete="off"
      />
      <button type="submit" id="KarthikaAISubmitBtn" class="karthika-ai-submit-btn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
        </svg>
        <span>Ask AI</span>
      </button>
    </div>
  </form>

  <!-- Recipe / Dish Selection Chips -->
  <div class="karthika-ai-chips-wrap karthika-hide-scrollbar">
    <button type="button" class="karthika-ai-chip is-active karthika-ai-pill-btn" data-recipe="biryani">
      🍗 Chicken Biryani
    </button>
    <button type="button" class="karthika-ai-chip karthika-ai-pill-btn" data-recipe="kerala_breakfast">
      🥞 Kerala Breakfast
    </button>
    <button type="button" class="karthika-ai-chip karthika-ai-pill-btn" data-recipe="sambar">
      🍛 Sambar & Rasam
    </button>
    <button type="button" class="karthika-ai-chip karthika-ai-pill-btn" data-recipe="tea_snacks">
      ☕ Tea Time Snacks
    </button>
  </div>

  <!-- Interactive Basket Preview Box -->
  <div class="karthika-ai-basket-box">
    <div class="karthika-ai-basket-head">
      <div>
        <span id="KarthikaAIRecipeTitle" class="karthika-ai-basket-dish">
          Malabar Chicken Biryani Kit
        </span>
        <span class="karthika-ai-basket-matched-count" id="KarthikaAIMatchedCount">4 store items matched</span>
      </div>
      <span id="KarthikaAIRecipePrice" class="karthika-ai-basket-price">
        $24.50
      </span>
    </div>

    <!-- Visual Matched Product List with Images -->
    <div id="KarthikaAIIngredientList" class="karthika-ai-ingredients-list karthika-ai-product-items">
      <!-- Injected dynamically with actual products & images -->
    </div>

    <button
      type="button"
      id="KarthikaAIBuildBtn"
      class="karthika-ai-build-btn karthika-ai-add-all-btn"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <path d="M16 10a4 4 0 0 1-8 0"></path>
      </svg>
      <span>Build my basket & Go to Cart</span>
    </button>
  </div>

  <script type="application/json" id="KarthikaCatalogVariants">
    [
      {%- for product in collections.all.products limit: 50 -%}
        {%- assign v = product.selected_or_first_available_variant | default: product.variants.first -%}
        {%- if v and v.available -%}
          {
            "id": {{ v.id }},
            "title": {{ product.title | json }},
            "price": {{ product.price | money | json }},
            "price_raw": {{ product.price }},
            "image": {{ product.featured_media | image_url: width: 120 | json }},
            "url": {{ product.url | json }}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
    ]
  </script>
</div>

{% schema %}
{
  "name": "Karthika AI Assistant",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Not sure what to cook?"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Tell Karthika what you're making and we'll find the fresh ingredients."
    }
  ],
  "presets": [
    {
      "name": "Karthika AI Assistant"
    }
  ]
}
{% endschema %}
