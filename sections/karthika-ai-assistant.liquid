{%- comment -%}
  Karthika AI Shopping Assistant & Recipe Meal Builder Section
  Calls Remix app via Shopify App Proxy (/apps/karthika/recommend).
{%- endcomment -%}

<div
  class="karthika-ai-assistant-card"
  data-ai-endpoint="{{ section.settings.ai_endpoint | default: '/apps/karthika/recommend' }}"
>
  <div class="karthika-ai-badge">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
    </svg>
    <span>Karthika AI Assistant</span>
  </div>

  <h3 class="karthika-ai-title">{{ section.settings.heading | default: "Not sure what to cook?" }}</h3>
  <p class="karthika-ai-desc">{{ section.settings.subheading | default: "Tell Karthika what you're making and we'll find the fresh ingredients." }}</p>

  <form id="KarthikaAIPromptForm" class="karthika-ai-prompt-form">
    <div class="karthika-ai-input-wrap">
      <input
        type="text"
        id="KarthikaAIPromptInput"
        class="karthika-ai-input"
        placeholder="e.g. Fish Curry for 4 people, Beef Roast..."
        autocomplete="off"
      />
      <button type="submit" id="KarthikaAISubmitBtn" class="karthika-ai-submit-btn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
        </svg>
        <span>Ask AI</span>
      </button>
    </div>
  </form>

  <div class="karthika-ai-chips-wrap karthika-hide-scrollbar">
    <button type="button" class="karthika-ai-chip is-active karthika-ai-pill-btn" data-dish="Chicken Biryani">
      🍗 Chicken Biryani
    </button>
    <button type="button" class="karthika-ai-chip karthika-ai-pill-btn" data-dish="Kerala Breakfast">
      🥞 Kerala Breakfast
    </button>
    <button type="button" class="karthika-ai-chip karthika-ai-pill-btn" data-dish="Sambar & Rasam">
      🍛 Sambar & Rasam
    </button>
    <button type="button" class="karthika-ai-chip karthika-ai-pill-btn" data-dish="Tea Time Snacks">
      ☕ Tea Time Snacks
    </button>
  </div>

  <div id="KarthikaAIFallbackMsg" class="karthika-ai-fallback-msg" style="display: none;">
    Karthika's thinking cap isn't working right now — try one of the recipe chips instead.
  </div>

  <div class="karthika-ai-basket-box">
    <div class="karthika-ai-basket-head">
      <div>
        <span id="KarthikaAIRecipeTitle" class="karthika-ai-basket-dish">
          Select a recipe
        </span>
        <span class="karthika-ai-basket-matched-count" id="KarthikaAIMatchedCount">Choose a dish to see matched items</span>
      </div>
      <span id="KarthikaAIRecipePrice" class="karthika-ai-basket-price">
        $0.00
      </span>
    </div>

    <div id="KarthikaAIIngredientList" class="karthika-ai-ingredients-list karthika-ai-product-items"></div>

    <button
      type="button"
      id="KarthikaAIBuildBtn"
      class="karthika-ai-build-btn karthika-ai-add-all-btn"
      disabled
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <path d="M16 10a4 4 0 0 1-8 0"></path>
      </svg>
      <span>Build my basket & Go to Cart</span>
    </button>
  </div>
</div>

{% schema %}
{
  "name": "Karthika AI Assistant",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Not sure what to cook?"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Tell Karthika what you're making and we'll find the fresh ingredients."
    },
    {
      "type": "text",
      "id": "ai_endpoint",
      "label": "AI API endpoint",
      "default": "/apps/karthika/recommend",
      "info": "Shopify App Proxy path for the Karthika Remix app recommend route."
    }
  ],
  "presets": [
    {
      "name": "Karthika AI Assistant"
    }
  ]
}
{% endschema %}
