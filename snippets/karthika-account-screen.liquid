{%- comment -%}
  Karthika — Mobile Account / Login overlay.
  Guest: Shopify login. Signed-in: account, addresses, logout.
{%- endcomment -%}

{%- capture login_url -%}
  {% render 'karthika-login-home', destination: 'account' %}
{%- endcapture -%}
{%- liquid
  assign login_url = login_url | strip
  assign account_url = routes.account_url
  assign target_url = login_url
  if customer
    assign target_url = account_url
  endif
  assign contact_url = pages.contact.url | default: '/pages/contact'
  assign offers_url = routes.all_products_collection_url
  if pages['offers'] != blank
    assign offers_url = pages['offers'].url
  elsif collections['offers'] != blank
    assign offers_url = collections['offers'].url
  endif
-%}

<div
  id="karthika-account-screen"
  class="karthika-account-screen"
  role="dialog"
  aria-modal="true"
  aria-labelledby="kas-dialog-title"
  hidden
>

  <div class="kas-hero">
    <button type="button" class="kas-back-btn" id="kas-back-btn" aria-label="Close account menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <div class="kas-deco" aria-hidden="true">
      <span class="kas-deco__item kas-deco__tomato">🍅</span>
      <span class="kas-deco__item kas-deco__lemon">🍋</span>
      <span class="kas-deco__item kas-deco__pepper">🫑</span>
      <span class="kas-deco__item kas-deco__apple">🍎</span>
      <span class="kas-deco__item kas-deco__milk">🥛</span>
      <span class="kas-deco__item kas-deco__egg">🥚</span>
      <span class="kas-deco__item kas-deco__orange">🍊</span>
    </div>

    <div class="kas-brand">
      {% render 'karthika-logo', class: 'kas-brand__logo-img', loading: 'eager' %}
      <h2 id="kas-dialog-title" class="visually-hidden">{{ shop.name | escape }} account</h2>
    </div>
  </div>

  <div class="kas-panel">
    <a href="{{ target_url }}" class="kas-login-btn" id="kas-login-btn">
      {%- if customer -%}{{ 'customer.account.title' | t }}{%- else -%}{{ 'customer.log_in' | t }}{%- endif -%}
    </a>

    {%- unless customer -%}
      {%- if shop.customer_accounts_enabled -%}
        <a class="kas-register-link" href="{{ routes.account_register_url }}">{{ 'customer.login_page.create_account' | t }}</a>
      {%- endif -%}
      <p class="kas-terms">
        By tapping, I accept the
        <a href="{{ shop.terms_of_service.url | default: '/policies/terms-of-service' }}" class="kas-terms__link">terms of service</a>
        &amp;
        <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}" class="kas-terms__link">privacy policy</a>
      </p>
    {%- endunless -%}

    <div class="kas-options-card" role="list">
      {%- if customer -%}
        <a href="{{ routes.account_url }}#orders" class="kas-option-row" role="listitem">
          <span class="kas-option-row__label">{{ 'karthika.account.orders' | t }}</span>
          <span class="kas-option-row__chevron" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </span>
        </a>
        <div class="kas-divider" role="separator" aria-hidden="true"></div>
        <a href="{{ routes.account_addresses_url }}" class="kas-option-row" role="listitem">
          <span class="kas-option-row__label">{{ 'customer.addresses.title' | t }}</span>
          <span class="kas-option-row__chevron" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </span>
        </a>
        <div class="kas-divider" role="separator" aria-hidden="true"></div>
      {%- endif -%}

      <a href="{{ offers_url }}" class="kas-option-row" role="listitem">
        <span class="kas-option-row__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
        </span>
        <span class="kas-option-row__label">Offers</span>
        <span class="kas-option-row__chevron" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </span>
      </a>

      <div class="kas-divider" role="separator" aria-hidden="true"></div>

      <a href="{{ contact_url }}" class="kas-option-row" role="listitem">
        <span class="kas-option-row__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
        </span>
        <span class="kas-option-row__label">Help &amp; Support</span>
        <span class="kas-option-row__chevron" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </span>
      </a>

      {%- if customer -%}
        <div class="kas-divider" role="separator" aria-hidden="true"></div>
        <a href="{{ routes.account_logout_url }}" class="kas-option-row" role="listitem">
          <span class="kas-option-row__label">{{ 'customer.log_out' | t }}</span>
          <span class="kas-option-row__chevron" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </span>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>
