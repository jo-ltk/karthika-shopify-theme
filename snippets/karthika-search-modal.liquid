{%- comment -%}
  Karthika search overlay. Recent searches are client-stored.
  Popular shortcuts and category cards come from theme settings.
  Recommended products use a configured collection or the catalog.
{%- endcomment -%}

{%- liquid
  assign search_placeholder = 'Search for groceries, spices, snacks...'
  assign recommend_source = settings.search_recommend_collection
  if recommend_source == blank
    assign recommend_source = collections.all
  endif
  assign search_offers_url = blank
  if collections['offers'] != blank
    assign search_offers_url = collections['offers'].url
  elsif pages['offers'] != blank
    assign search_offers_url = pages['offers'].url
  endif
-%}

<div
  id="KarthikaSearchModal"
  class="karthika-search-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="KarthikaSearchModalTitle"
  aria-hidden="true"
>
  <div class="karthika-search-modal-content">
    <h2 id="KarthikaSearchModalTitle" class="visually-hidden">Search</h2>

    <div class="karthika-search-modal-header">
      <button type="button" class="karthika-search-modal-back" aria-label="Close search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      {%- if settings.predictive_search_enabled -%}
        <predictive-search class="karthika-live-search" data-loading-text="{{ 'accessibility.loading' | t }}">
      {%- endif -%}

      <form action="{{ routes.search_url }}" method="get" role="search" class="karthika-search-modal-form" id="KarthikaSearchModalForm">
        <input type="hidden" name="type" value="product">
        <div class="karthika-search-modal-input-shell">
          <label class="visually-hidden" for="KarthikaSearchModalInput">{{ search_placeholder }}</label>
          <input
            id="KarthikaSearchModalInput"
            type="search"
            name="q"
            class="karthika-search-modal-input"
            value="{{ search.terms | escape }}"
            placeholder="{{ search_placeholder }}"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
            {%- if settings.predictive_search_enabled -%}
              role="combobox"
              aria-expanded="false"
              aria-controls="predictive-search-results"
              aria-haspopup="listbox"
              aria-autocomplete="list"
            {%- endif -%}
          >
          <button type="reset" class="karthika-search-modal-reset" aria-label="Clear search">&times;</button>
          <button type="submit" class="karthika-search-modal-submit" aria-label="Search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <line x1="16.65" y1="16.65" x2="21" y2="21"></line>
            </svg>
          </button>
        </div>
        <input type="hidden" name="options[prefix]" value="last">

        {%- if settings.predictive_search_enabled -%}
          <div class="predictive-search predictive-search--header karthika-predictive-search" tabindex="-1" data-predictive-search>
            {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
          </div>
          <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
        {%- endif -%}
      </form>

      {%- if settings.predictive_search_enabled -%}
        </predictive-search>
      {%- endif -%}
    </div>

    <div id="KarthikaSearchModalError" class="karthika-search-error" hidden role="alert"></div>

    <div class="karthika-search-modal-body">
      <div class="karthika-search-empty-state">

        <div class="karthika-search-group karthika-search-group--recent" id="karthikaRecentSearchesGroup" hidden>
          <div class="karthika-search-section-header">
            <h2 class="karthika-search-section-title">Recent searches</h2>
            <button type="button" class="karthika-search-clear-btn" id="karthikaClearRecentBtn">Clear all</button>
          </div>
          <div class="karthika-recent-cards-row" id="karthikaRecentCardsRow"></div>
        </div>

        {%- liquid
          assign has_shortcuts = false
          if settings.search_shortcut_1 != blank or settings.search_shortcut_2 != blank or settings.search_shortcut_3 != blank or settings.search_shortcut_4 != blank or settings.search_shortcut_5 != blank or settings.search_shortcut_6 != blank
            assign has_shortcuts = true
          endif
        -%}
        {%- if has_shortcuts -%}
          <div class="karthika-search-group">
            <div class="karthika-search-section-header">
              <h2 class="karthika-search-section-title">Popular searches</h2>
            </div>
            <p class="karthika-search-section-note">Store shortcuts you can edit in theme settings.</p>
            <div class="karthika-popular-icons-row">
              {%- if settings.search_shortcut_1 != blank -%}
                <button type="button" class="karthika-popular-icon-btn" data-query="{{ settings.search_shortcut_1 | escape }}">
                  <span class="karthika-popular-icon-circle">{{ settings.search_shortcut_1 | slice: 0 | upcase | escape }}</span>
                  <span class="karthika-popular-icon-label">{{ settings.search_shortcut_1 | escape }}</span>
                </button>
              {%- endif -%}
              {%- if settings.search_shortcut_2 != blank -%}
                <button type="button" class="karthika-popular-icon-btn" data-query="{{ settings.search_shortcut_2 | escape }}">
                  <span class="karthika-popular-icon-circle">{{ settings.search_shortcut_2 | slice: 0 | upcase | escape }}</span>
                  <span class="karthika-popular-icon-label">{{ settings.search_shortcut_2 | escape }}</span>
                </button>
              {%- endif -%}
              {%- if settings.search_shortcut_3 != blank -%}
                <button type="button" class="karthika-popular-icon-btn" data-query="{{ settings.search_shortcut_3 | escape }}">
                  <span class="karthika-popular-icon-circle">{{ settings.search_shortcut_3 | slice: 0 | upcase | escape }}</span>
                  <span class="karthika-popular-icon-label">{{ settings.search_shortcut_3 | escape }}</span>
                </button>
              {%- endif -%}
              {%- if settings.search_shortcut_4 != blank -%}
                <button type="button" class="karthika-popular-icon-btn" data-query="{{ settings.search_shortcut_4 | escape }}">
                  <span class="karthika-popular-icon-circle">{{ settings.search_shortcut_4 | slice: 0 | upcase | escape }}</span>
                  <span class="karthika-popular-icon-label">{{ settings.search_shortcut_4 | escape }}</span>
                </button>
              {%- endif -%}
              {%- if settings.search_shortcut_5 != blank -%}
                <button type="button" class="karthika-popular-icon-btn" data-query="{{ settings.search_shortcut_5 | escape }}">
                  <span class="karthika-popular-icon-circle">{{ settings.search_shortcut_5 | slice: 0 | upcase | escape }}</span>
                  <span class="karthika-popular-icon-label">{{ settings.search_shortcut_5 | escape }}</span>
                </button>
              {%- endif -%}
              {%- if settings.search_shortcut_6 != blank -%}
                <button type="button" class="karthika-popular-icon-btn" data-query="{{ settings.search_shortcut_6 | escape }}">
                  <span class="karthika-popular-icon-circle">{{ settings.search_shortcut_6 | slice: 0 | upcase | escape }}</span>
                  <span class="karthika-popular-icon-label">{{ settings.search_shortcut_6 | escape }}</span>
                </button>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        {%- liquid
          assign has_search_cats = false
          if settings.search_category_1 != blank or settings.search_category_2 != blank or settings.search_category_3 != blank or settings.search_category_4 != blank or settings.search_category_5 != blank or settings.search_category_6 != blank
            assign has_search_cats = true
          endif
        -%}
        {%- if has_search_cats -%}
          <div class="karthika-search-group">
            <div class="karthika-search-section-header">
              <h2 class="karthika-search-section-title">Shop by category</h2>
            </div>
            <div class="karthika-search-cat-grid">
              {%- if settings.search_category_1 != blank -%}
                {%- assign search_cat = settings.search_category_1 -%}
                <a href="{{ search_cat.url }}" class="karthika-cat-card">
                  <span class="karthika-cat-card-name">{{ search_cat.title | escape }}</span>
                  <div class="karthika-cat-card-img-wrap">
                    {%- if search_cat.featured_image -%}
                      <img src="{{ search_cat.featured_image | image_url: width: 260 }}" alt="{{ search_cat.title | escape }}" loading="lazy" width="80" height="80">
                    {%- endif -%}
                  </div>
                  <span class="karthika-cat-card-arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                  </span>
                </a>
              {%- endif -%}
              {%- if settings.search_category_2 != blank -%}
                {%- assign search_cat = settings.search_category_2 -%}
                <a href="{{ search_cat.url }}" class="karthika-cat-card">
                  <span class="karthika-cat-card-name">{{ search_cat.title | escape }}</span>
                  <div class="karthika-cat-card-img-wrap">
                    {%- if search_cat.featured_image -%}
                      <img src="{{ search_cat.featured_image | image_url: width: 260 }}" alt="{{ search_cat.title | escape }}" loading="lazy" width="80" height="80">
                    {%- endif -%}
                  </div>
                  <span class="karthika-cat-card-arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                  </span>
                </a>
              {%- endif -%}
              {%- if settings.search_category_3 != blank -%}
                {%- assign search_cat = settings.search_category_3 -%}
                <a href="{{ search_cat.url }}" class="karthika-cat-card">
                  <span class="karthika-cat-card-name">{{ search_cat.title | escape }}</span>
                  <div class="karthika-cat-card-img-wrap">
                    {%- if search_cat.featured_image -%}
                      <img src="{{ search_cat.featured_image | image_url: width: 260 }}" alt="{{ search_cat.title | escape }}" loading="lazy" width="80" height="80">
                    {%- endif -%}
                  </div>
                  <span class="karthika-cat-card-arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                  </span>
                </a>
              {%- endif -%}
              {%- if settings.search_category_4 != blank -%}
                {%- assign search_cat = settings.search_category_4 -%}
                <a href="{{ search_cat.url }}" class="karthika-cat-card">
                  <span class="karthika-cat-card-name">{{ search_cat.title | escape }}</span>
                  <div class="karthika-cat-card-img-wrap">
                    {%- if search_cat.featured_image -%}
                      <img src="{{ search_cat.featured_image | image_url: width: 260 }}" alt="{{ search_cat.title | escape }}" loading="lazy" width="80" height="80">
                    {%- endif -%}
                  </div>
                  <span class="karthika-cat-card-arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                  </span>
                </a>
              {%- endif -%}
              {%- if settings.search_category_5 != blank -%}
                {%- assign search_cat = settings.search_category_5 -%}
                <a href="{{ search_cat.url }}" class="karthika-cat-card">
                  <span class="karthika-cat-card-name">{{ search_cat.title | escape }}</span>
                  <div class="karthika-cat-card-img-wrap">
                    {%- if search_cat.featured_image -%}
                      <img src="{{ search_cat.featured_image | image_url: width: 260 }}" alt="{{ search_cat.title | escape }}" loading="lazy" width="80" height="80">
                    {%- endif -%}
                  </div>
                  <span class="karthika-cat-card-arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                  </span>
                </a>
              {%- endif -%}
              {%- if settings.search_category_6 != blank -%}
                {%- assign search_cat = settings.search_category_6 -%}
                <a href="{{ search_cat.url }}" class="karthika-cat-card">
                  <span class="karthika-cat-card-name">{{ search_cat.title | escape }}</span>
                  <div class="karthika-cat-card-img-wrap">
                    {%- if search_cat.featured_image -%}
                      <img src="{{ search_cat.featured_image | image_url: width: 260 }}" alt="{{ search_cat.title | escape }}" loading="lazy" width="80" height="80">
                    {%- endif -%}
                  </div>
                  <span class="karthika-cat-card-arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                  </span>
                </a>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        {%- if search_offers_url != blank -%}
          <div class="karthika-search-group">
            <a class="karthika-search-offer-banner" href="{{ search_offers_url }}">
              <div class="karthika-offer-content">
                <div class="karthika-offer-tag">
                  <span>Offers</span>
                </div>
                <h3 class="karthika-offer-title">Shop current grocery offers</h3>
                <span class="karthika-offer-btn">
                  <span>Shop offers</span>
                </span>
              </div>
            </a>
          </div>
        {%- endif -%}

        <div class="karthika-search-group">
          <div class="karthika-search-section-header">
            <h2 class="karthika-search-section-title">You might need</h2>
          </div>
          {%- if recommend_source != blank and recommend_source.products_count > 0 -%}
            {%- assign recommend_shown = 0 -%}
            <div class="karthika-need-cards-scroll karthika-hide-scrollbar">
              {%- for product in recommend_source.products -%}
                {%- if recommend_shown >= 8 -%}
                  {%- break -%}
                {%- endif -%}
                {%- unless product.available -%}
                  {%- continue -%}
                {%- endunless -%}
                {%- assign recommend_shown = recommend_shown | plus: 1 -%}
                {%- assign current_variant = product.selected_or_first_available_variant | default: product.variants.first -%}
                <div class="karthika-need-card">
                  <a href="{{ product.url }}" class="karthika-need-card-media">
                    {%- if product.featured_media -%}
                      <img
                        src="{{ product.featured_media | image_url: width: 220 }}"
                        alt="{{ product.featured_media.alt | default: product.title | escape }}"
                        loading="lazy"
                        width="110"
                        height="110"
                      >
                    {%- else -%}
                      <span class="karthika-need-card-placeholder">{{ product.title | truncate: 24 | escape }}</span>
                    {%- endif -%}
                  </a>
                  <div class="karthika-need-card-info">
                    <h3 class="karthika-need-card-title">
                      <a href="{{ product.url }}">{{ product.title | escape }}</a>
                    </h3>
                    <div class="karthika-need-card-footer">
                      <span class="karthika-need-card-price">
                        {%- if settings.currency_code_enabled -%}
                          {{ product.price | money_with_currency }}
                        {%- else -%}
                          {{ product.price | money }}
                        {%- endif -%}
                      </span>
                      {%- if product.available and current_variant -%}
                        <button
                          type="button"
                          class="karthika-need-card-add-btn"
                          data-variant-id="{{ current_variant.id }}"
                          aria-label="Add {{ product.title | escape }} to cart"
                        >
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" aria-hidden="true">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                          </svg>
                        </button>
                      {%- else -%}
                        <span class="karthika-need-card-soldout">Sold out</span>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              {%- endfor -%}
            </div>
            {%- if recommend_shown == 0 -%}
              <p class="karthika-search-empty-copy">No in-stock products to recommend right now.</p>
            {%- endif -%}
          {%- else -%}
            <p class="karthika-search-empty-copy">No product recommendations yet. Add products to your catalog or choose a collection in theme settings.</p>
          {%- endif -%}
        </div>

      </div>
    </div>

    <nav class="karthika-bottom-nav karthika-search-bottom-nav" aria-label="Search screen navigation">
      <a href="{{ routes.root_url }}" class="karthika-nav-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5z"></path></svg>
        <span>Home</span>
      </a>

      <a href="{{ routes.collections_url }}" class="karthika-nav-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
          <rect x="3" y="3" width="7" height="7" rx="2"></rect>
          <rect x="14" y="3" width="7" height="7" rx="2"></rect>
          <rect x="14" y="14" width="7" height="7" rx="2"></rect>
          <rect x="3" y="14" width="7" height="7" rx="2"></rect>
        </svg>
        <span>Categories</span>
      </a>

      <button type="button" class="karthika-nav-item is-active karthika-nav-reset" aria-current="page">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <span>Search</span>
      </button>

      <a
        href="{{ routes.cart_url }}"
        class="karthika-nav-item karthika-cart-trigger"
        aria-label="Cart ({{ cart.item_count }} items)"
        {% if settings.cart_type == 'drawer' %}
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="CartDrawer"
        {% endif %}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><circle cx="9" cy="20" r="1.5"></circle><circle cx="18" cy="20" r="1.5"></circle><path d="M2 3h3l2.5 13h12l3-9H6"></path></svg>
        <span>Cart</span>
        <span class="karthika-nav-badge"{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
      </a>

      <a href="{% if customer %}{{ routes.account_url }}{% else %}#karthika-account-screen{% endif %}" class="karthika-nav-item karthika-account-trigger" data-account-href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{% render 'karthika-login-home' %}{%- endif -%}" data-customer-state="{% if customer %}signed-in{% else %}guest{% endif %}" aria-label="Account">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        <span>Account</span>
      </a>
    </nav>
  </div>
</div>
