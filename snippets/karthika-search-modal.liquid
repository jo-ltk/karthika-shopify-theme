{% doc %}
  Renders the Karthika mobile search screen using Shopify predictive search and the real search route.
{% enddoc %}

<div id="KarthikaSearchModal" class="karthika-search-modal" role="dialog" aria-modal="true" aria-labelledby="KarthikaSearchModalInput">
  <div class="karthika-search-modal-content">
    <div class="karthika-search-modal-header">
      <button type="button" class="karthika-search-modal-back" aria-label="Back to previous screen">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 18l-6-6 6-6"></path>
        </svg>
      </button>

      {%- if settings.predictive_search_enabled -%}
        <predictive-search class="karthika-live-search" data-loading-text="{{ 'accessibility.loading' | t }}">
      {%- endif -%}

      <form action="{{ routes.search_url }}" method="get" role="search" class="karthika-search-modal-form">
        <input type="hidden" name="type" value="product">
        <div class="karthika-search-modal-input-shell">
          <svg class="karthika-search-modal-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="16.65" y1="16.65" x2="21" y2="21"></line>
          </svg>
          <input
            id="KarthikaSearchModalInput"
            type="search"
            name="q"
            class="karthika-search-modal-input"
            value="{{ search.terms | escape }}"
            placeholder="Search groceries, spices, Kerala snacks..."
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
            aria-label="Search groceries"
          >
          <button type="reset" class="karthika-search-modal-reset" aria-label="Clear search">&times;</button>
          <button type="submit" class="karthika-search-modal-submit" aria-label="Search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <line x1="16.65" y1="16.65" x2="21" y2="21"></line>
            </svg>
          </button>
        </div>
        <input type="hidden" name="options[prefix]" value="last">

        {%- if settings.predictive_search_enabled -%}
          <div class="predictive-search predictive-search--header karthika-predictive-search" tabindex="-1" data-predictive-search>
            {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
          </div>
          <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
        {%- endif -%}
      </form>

      {%- if settings.predictive_search_enabled -%}
        </predictive-search>
      {%- endif -%}
    </div>

    <div class="karthika-search-modal-body">
      <div class="karthika-search-empty-state">
        <div class="karthika-search-group">
          <div class="karthika-search-group-title">Recent Searches</div>
          <div class="karthika-search-tag-chips">
            <button type="button" class="karthika-search-chip" data-query="Basmati Rice">Basmati Rice</button>
            <button type="button" class="karthika-search-chip" data-query="Banana Chips">Banana Chips</button>
            <button type="button" class="karthika-search-chip" data-query="Coconut Oil">Coconut Oil</button>
            <button type="button" class="karthika-search-chip" data-query="Filter Coffee">Filter Coffee</button>
          </div>
        </div>

        <div class="karthika-search-group">
          <div class="karthika-search-group-title">Popular Searches</div>
          <div class="karthika-search-tag-chips">
            <button type="button" class="karthika-search-chip" data-query="Rice">Rice</button>
            <button type="button" class="karthika-search-chip" data-query="Spices">Spices</button>
            <button type="button" class="karthika-search-chip" data-query="Snacks">Snacks</button>
            <button type="button" class="karthika-search-chip" data-query="Kerala Products">Kerala Products</button>
            <button type="button" class="karthika-search-chip" data-query="Vegetables">Vegetables</button>
            <button type="button" class="karthika-search-chip" data-query="Dairy">Dairy</button>
          </div>
        </div>

        <div class="karthika-search-group">
          <div class="karthika-search-group-title">Popular Categories</div>
          <div class="karthika-search-category-grid">
            <button type="button" class="karthika-search-category" data-query="Rice & Grains">
              <span>Rice</span>
            </button>
            <button type="button" class="karthika-search-category" data-query="Spices & Masalas">
              <span>Spices</span>
            </button>
            <button type="button" class="karthika-search-category" data-query="Snacks">
              <span>Snacks</span>
            </button>
            <button type="button" class="karthika-search-category" data-query="Kerala Specials">
              <span>Kerala</span>
            </button>
            <button type="button" class="karthika-search-category" data-query="Vegetables">
              <span>Veg</span>
            </button>
            <button type="button" class="karthika-search-category" data-query="Dairy & Milk">
              <span>Dairy</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
