{% doc %}
  Renders a green outline icon for the account profile page.

  @param {string} icon - One of: pencil, bag, pin, heart, gear, home, shield, chevron, tag, chat, lock, card, star, logout
  @example
  {% render 'karthika-account-icon', icon: 'bag' %}
{% enddoc %}

<svg class="kap-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true" focusable="false">
  {%- case icon -%}
    {%- when 'pencil' -%}
      <path d="M4 20h4l10-10-4-4L4 16v4z"></path>
      <path d="M14 6l4 4"></path>
    {%- when 'bag' -%}
      <path d="M5 8h14l-1 12H6L5 8z"></path>
      <path d="M9 8V6a3 3 0 0 1 6 0v2"></path>
    {%- when 'pin' -%}
      <path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11z"></path>
      <circle cx="12" cy="10" r="2.5"></circle>
    {%- when 'heart' -%}
      <path d="M12 20s-7-4.3-7-9a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 4.7-7 9-7 9z"></path>
    {%- when 'gear' -%}
      <circle cx="12" cy="12" r="3"></circle>
      <path d="M19.1 14.6a1.6 1.6 0 0 0 .32 1.77l.06.06a1.94 1.94 0 1 1-2.75 2.75l-.06-.06a1.6 1.6 0 0 0-1.77-.32 1.6 1.6 0 0 0-.97 1.47v.17a1.94 1.94 0 1 1-3.88 0v-.09a1.6 1.6 0 0 0-1.05-1.46 1.6 1.6 0 0 0-1.77.32l-.06.06a1.94 1.94 0 1 1-2.75-2.75l.06-.06a1.6 1.6 0 0 0 .32-1.77 1.6 1.6 0 0 0-1.47-.97H3.1a1.94 1.94 0 1 1 0-3.88h.09a1.6 1.6 0 0 0 1.46-1.05 1.6 1.6 0 0 0-.32-1.77l-.06-.06a1.94 1.94 0 1 1 2.75-2.75l.06.06a1.6 1.6 0 0 0 1.77.32h.08a1.6 1.6 0 0 0 .97-1.47V3.1a1.94 1.94 0 1 1 3.88 0v.09a1.6 1.6 0 0 0 .97 1.47 1.6 1.6 0 0 0 1.77-.32l.06-.06a1.94 1.94 0 1 1 2.75 2.75l-.06.06a1.6 1.6 0 0 0-.32 1.77v.08a1.6 1.6 0 0 0 1.47.97h.17a1.94 1.94 0 1 1 0 3.88h-.09a1.6 1.6 0 0 0-1.47.97z"></path>
    {%- when 'home' -%}
      <path d="M4 10.5L12 4l8 6.5V20a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1v-9.5z"></path>
    {%- when 'shield' -%}
      <path d="M12 3l7 3v5.5c0 4.4-3 7.9-7 9.5-4-1.6-7-5.1-7-9.5V6l7-3z"></path>
      <polyline points="9 12 11.2 14.2 15.2 10.2"></polyline>
    {%- when 'chevron' -%}
      <polyline points="9 6 15 12 9 18"></polyline>
    {%- when 'tag' -%}
      <path d="M12.5 3H20a1 1 0 0 1 1 1v7.5L11 21.5 2.5 13 12.5 3z"></path>
      <circle cx="16.8" cy="7.2" r="1.3"></circle>
    {%- when 'chat' -%}
      <path d="M4 5h16a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H9l-5 4V6a1 1 0 0 1 1-1z"></path>
    {%- when 'lock' -%}
      <rect x="5" y="10.5" width="14" height="10" rx="2"></rect>
      <path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5"></path>
    {%- when 'card' -%}
      <rect x="3" y="6" width="18" height="12" rx="2"></rect>
      <path d="M3 10.5h18"></path>
    {%- when 'star' -%}
      <path d="M12 4l2.5 5.2 5.5.7-4 3.9 1 5.5-5-2.8-5 2.8 1-5.5-4-3.9 5.5-.7L12 4z"></path>
    {%- when 'logout' -%}
      <path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3"></path>
      <polyline points="10 8 6 12 10 16"></polyline>
      <path d="M6 12h9"></path>
    {%- else -%}
      <circle cx="12" cy="12" r="8"></circle>
  {%- endcase -%}
</svg>
