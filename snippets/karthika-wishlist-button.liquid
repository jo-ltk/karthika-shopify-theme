{% doc %}
  Wishlist toggle for a Shopify product. State is applied by WishlistManager.
  @param {product} product - Product to save or remove
  @param {string} [button_class] - Extra CSS classes
{% enddoc %}

{%- if product and product.handle != blank -%}
  <button
    type="button"
    class="karthika-wishlist-btn{% if button_class != blank %} {{ button_class }}{% endif %}"
    aria-label="{{ 'general.wishlist.add' | t: product: product.title }}"
    aria-pressed="false"
    data-product-handle="{{ product.handle | escape }}"
    data-product-id="{{ product.id }}"
    data-product-title="{{ product.title | escape }}"
    data-label-add="{{ 'general.wishlist.add' | t: product: product.title | escape }}"
    data-label-remove="{{ 'general.wishlist.remove' | t: product: product.title | escape }}"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
    </svg>
  </button>
{%- endif -%}
