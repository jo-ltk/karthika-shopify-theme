{%- comment -%}
  Karthika Supermarket — Redesigned Mobile Header
  Layout: Single horizontal row — Logo (left) | Search (center, flexible) | Cart (right)
  Below header: compact delivery location strip
{%- endcomment -%}

{%- liquid
  assign cart_count = cart.item_count
  assign home_url = routes.root_url
  assign categories_url = routes.all_products_collection_url
  assign search_url = routes.search_url
  assign offers_url = routes.all_products_collection_url
  assign about_url = routes.root_url

  if pages['offers'] != blank
    assign offers_url = pages['offers'].url
  elsif collections['offers'] != blank
    assign offers_url = collections['offers'].url
  endif

  if pages['about-us'] != blank
    assign about_url = pages['about-us'].url
  elsif pages['about_us'] != blank
    assign about_url = pages['about_us'].url
  endif

  assign is_home = false
  assign is_categories = false
  assign is_search = false
  assign is_offers = false
  assign is_about = false

  if template.name == 'index' or request.path == '/' or request.path == home_url
    assign is_home = true
  endif

  if template.name == 'collection' or template.name == 'list-collections' or request.path contains '/collections'
    assign is_categories = true
  endif

  if template.name == 'search' or request.path == search_url
    assign is_search = true
  endif

  if template.name == 'collection' and collection.handle == 'offers'
    assign is_offers = true
  elsif request.path == offers_url or request.path contains '/collections/all'
    assign is_offers = true
  endif

  if template.name == 'page' and page.handle == 'about-us'
    assign is_about = true
  elsif request.path contains '/pages/about-us' or request.path contains '/pages/about_us'
    assign is_about = true
  endif
-%}

{%- unless template.name == 'list-collections' or request.path == '/collections' -%}
<div class="karthika-desktop-header" role="banner">
  {%- liquid
    assign store_location_city = settings.store_location_city | strip
    assign store_location_region = settings.store_location_region | strip
    assign store_location_label = ''
    if store_location_region != blank and store_location_city != blank
      assign store_location_label = store_location_region | append: ', ' | append: store_location_city
    elsif store_location_city != blank
      assign store_location_label = store_location_city
    elsif settings.store_location_name != blank
      assign store_location_label = settings.store_location_name | strip
    elsif settings.store_location_address != blank
      assign store_location_label = settings.store_location_address | strip
    endif
  -%}
  <div class="karthika-desktop-header__utility">
    <div class="karthika-desktop-header__utility-inner">
      {%- if settings.delivery_promo_text != blank -%}
        <span class="karthika-desktop-header__utility-item"><span aria-hidden="true">&#128666;</span> {{ settings.delivery_promo_text | escape }}</span>
      {%- endif -%}
      <button
        type="button"
        class="karthika-desktop-header__utility-item karthika-desktop-header__location karthika-change-location-btn"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="KarthikaDeliveryModal"
        aria-label="{{ 'general.location.change_location' | t }}"
      >
        <span aria-hidden="true">&#9906;</span>
        {{ 'general.location.delivering_to' | t }}
        <strong class="karthika-delivery-address">{% if store_location_label != blank %}{{ store_location_label | escape }}{% else %}{{ 'general.location.unconfigured' | t }}{% endif %}</strong>
      </button>
      <span class="karthika-desktop-header__utility-item karthika-desktop-header__utility-item--static" title="Mobile app is not available yet">
        <span aria-hidden="true">&#128241;</span> App coming soon
      </span>
      {%- if customer -%}
        {%- assign track_order_url = routes.account_url | append: '#orders' -%}
      {%- else -%}
        {%- capture track_order_url -%}
          {% render 'karthika-login-home', destination: 'orders' %}
        {%- endcapture -%}
        {%- assign track_order_url = track_order_url | strip -%}
      {%- endif -%}
      <a
        class="karthika-desktop-header__utility-item"
        href="{{ track_order_url }}"
      >
        <span aria-hidden="true">&#9716;</span> {{ 'karthika.checkout.track_order' | t }}
      </a>
    </div>
  </div>
  <div class="karthika-desktop-header__main">
    <a href="{{ home_url }}" class="karthika-desktop-header__brand" aria-label="{{ shop.name }}">
      {% render 'karthika-logo', class: 'karthika-logo--nav-desktop', loading: 'eager' %}
    </a>
    <nav class="karthika-desktop-header__nav" aria-label="Main navigation">
      <a href="{{ home_url }}"{% if is_home %} class="is-active" aria-current="page"{% endif %}>Home</a>
      <a href="{{ categories_url }}"{% if is_categories %} class="is-active" aria-current="page"{% endif %}>Categories</a>
      <a href="{{ search_url }}"{% if is_search %} class="is-active" aria-current="page"{% endif %}>Search</a>
      <a href="{{ offers_url }}"{% if is_offers %} class="is-active" aria-current="page"{% endif %}>Offers</a>
      <a href="{{ about_url }}"{% if is_about %} class="is-active" aria-current="page"{% endif %}>About Us</a>
    </nav>
    <div class="karthika-desktop-header__actions">
      <button
        type="button"
        class="karthika-desktop-header__search karthika-search-bar-trigger karthika-search-placeholder-host{% if is_search %} is-active{% endif %}"
        aria-label="Search products"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="KarthikaSearchModal"
        data-search-terms="Search for milk…|Search for bananas…|Search for basmati rice…|Search for vegetables…|Search for coconut oil…|Search for spices…|Search for snacks…|Search for dal…|Search for rice flour…|Search for Kerala snacks…"
      >
        <svg class="karthika-desktop-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span id="KarthikaDesktopSearchPlaceholder" class="karthika-search-placeholder-text karthika-search-placeholder-target">Search for milk…</span>
      </button>
      <a
        class="karthika-desktop-header__order karthika-cart-trigger"
        href="{{ routes.cart_url }}"
        {% if settings.cart_type == 'drawer' %}
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="CartDrawer"
        {% endif %}
      >
        {{ 'karthika.checkout.order_now' | t }}
      </a>
      <a
        class="karthika-desktop-header__cart karthika-cart-trigger"
        href="{{ routes.cart_url }}"
        aria-label="Cart ({{ cart_count }} items)"
        {% if settings.cart_type == 'drawer' %}
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="CartDrawer"
        {% endif %}
      >
        <span aria-hidden="true">&#128722;</span><b class="karthika-cart-badge"{% if cart_count == 0 %} hidden{% endif %}>{{ cart_count }}</b>
      </a>
      <a class="karthika-desktop-header__account" href="{% if customer %}{{ routes.account_url }}{% else %}{% render 'karthika-login-home', destination: 'account' %}{% endif %}"><span aria-hidden="true">&#128100;</span> Account</a>
    </div>
  </div>
</div>

<header class="karthika-mobile-header" role="banner">
  <div class="karthika-header-row">
    <a href="{{ home_url }}" class="karthika-mobile-header__logo" aria-label="{{ shop.name }}">
      {% render 'karthika-logo', class: 'karthika-logo--nav-mobile', loading: 'eager' %}
    </a>

    <div class="karthika-header-icons">
      <button
        type="button"
        class="karthika-header-notification"
        disabled
        aria-disabled="true"
        aria-label="Notifications are not available"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
        </svg>
        <span class="karthika-header-badge karthika-notification-badge" style="display: none;">1</span>
      </button>

      <a
        href="{{ routes.cart_url }}"
        class="karthika-header-cart-icon karthika-cart-trigger"
        aria-label="Cart ({{ cart.item_count }} items)"
        {% if settings.cart_type == 'drawer' %}
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="CartDrawer"
        {% endif %}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
        <span class="karthika-header-badge karthika-cart-badge" {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </a>

      {% if customer %}
      <a class="karthika-header-account karthika-account-trigger" href="{{ routes.account_url }}" data-account-href="{{ routes.account_url }}" data-customer-state="signed-in" aria-label="Account">
        {% if customer %}
          <span class="karthika-customer-avatar" aria-hidden="true">{{ customer.first_name | default: customer.email | slice: 0 }}</span>
        {% endif %}
      </a>
      {% else %}
      <a class="karthika-header-account karthika-account-trigger" href="#karthika-account-screen" data-account-href="{% render 'karthika-login-home', destination: 'account' %}" data-customer-state="guest" aria-label="Account" aria-haspopup="dialog">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="8" r="4"></circle>
          <path d="M4 21a8 8 0 0 1 16 0"></path>
        </svg>
      </a>
      {% endif %}
    </div>
  </div>

  <button
    type="button"
    class="karthika-delivery-strip karthika-change-location-btn"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="KarthikaDeliveryModal"
    aria-label="{{ 'general.location.change_location' | t }}"
  >
    <svg class="karthika-delivery-pin" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
    </svg>
    <span class="karthika-delivery-copy">
      <span class="karthika-delivery-label">{{ 'general.location.delivering_to' | t }}</span>
      <span class="karthika-delivery-address">{% if store_location_label != blank %}{{ store_location_label | escape }}{% else %}{{ 'general.location.unconfigured' | t }}{% endif %}</span>
    </span>
    <svg class="karthika-delivery-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>

  {%- liquid
    if template.name == 'collection' and collection.handle == 'all'
      assign header_search_terms = 'Search for categories or products...'
      assign header_search_placeholder = 'Search for categories or products...'
    else
      assign header_search_terms = 'Search for milk…|Search for bananas…|Search for basmati rice…|Search for vegetables…|Search for coconut oil…|Search for spices…|Search for snacks…|Search for dal…|Search for rice flour…|Search for Kerala snacks…'
      assign header_search_placeholder = 'Search for milk…'
    endif
  -%}
  <button
    type="button"
    class="karthika-header-search karthika-search-bar-trigger karthika-search-placeholder-host"
    aria-label="Search groceries"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="KarthikaSearchModal"
    data-search-terms="{{ header_search_terms }}"
  >
    <svg class="karthika-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <span id="KarthikaMobileSearchPlaceholder" class="karthika-search-placeholder karthika-search-placeholder-target">{{ header_search_placeholder }}</span>
  </button>
</header>
{%- endunless -%}
