<div class="karthika-address-fields">
  <label for="AddressFirstName_{{ form_id }}">{{ 'customer.addresses.first_name' | t }}</label>
  <input id="AddressFirstName_{{ form_id }}" type="text" name="address[first_name]" value="{{ address.first_name | escape }}" autocomplete="given-name">

  <label for="AddressLastName_{{ form_id }}">{{ 'customer.addresses.last_name' | t }}</label>
  <input id="AddressLastName_{{ form_id }}" type="text" name="address[last_name]" value="{{ address.last_name | escape }}" autocomplete="family-name">

  <label for="AddressCompany_{{ form_id }}">{{ 'customer.addresses.company' | t }}</label>
  <input id="AddressCompany_{{ form_id }}" type="text" name="address[company]" value="{{ address.company | escape }}" autocomplete="organization">

  <label for="AddressAddress1_{{ form_id }}">{{ 'customer.addresses.address1' | t }}</label>
  <input id="AddressAddress1_{{ form_id }}" type="text" name="address[address1]" value="{{ address.address1 | escape }}" autocomplete="address-line1" required>

  <label for="AddressAddress2_{{ form_id }}">{{ 'customer.addresses.address2' | t }}</label>
  <input id="AddressAddress2_{{ form_id }}" type="text" name="address[address2]" value="{{ address.address2 | escape }}" autocomplete="address-line2">

  <label for="AddressCity_{{ form_id }}">{{ 'customer.addresses.city' | t }}</label>
  <input id="AddressCity_{{ form_id }}" type="text" name="address[city]" value="{{ address.city | escape }}" autocomplete="address-level2" required>

  <label for="AddressCountry_{{ form_id }}">{{ 'customer.addresses.country' | t }}</label>
  <select
    id="AddressCountry_{{ form_id }}"
    name="address[country]"
    data-address-country-select
    data-default="{{ address.country }}"
    data-form-id="{{ form_id }}"
    autocomplete="country"
  >
    {{ all_country_option_tags }}
  </select>

  <div id="AddressProvinceContainer_{{ form_id }}">
    <label for="AddressProvince_{{ form_id }}">{{ 'customer.addresses.province' | t }}</label>
    <select id="AddressProvince_{{ form_id }}" name="address[province]" data-default="{{ address.province }}" autocomplete="address-level1"></select>
  </div>

  <label for="AddressZip_{{ form_id }}">{{ 'customer.addresses.zip' | t }}</label>
  <input id="AddressZip_{{ form_id }}" type="text" name="address[zip]" value="{{ address.zip | escape }}" autocomplete="postal-code" required>

  <label for="AddressPhone_{{ form_id }}">{{ 'customer.addresses.phone' | t }}</label>
  <input id="AddressPhone_{{ form_id }}" type="tel" name="address[phone]" value="{{ address.phone | escape }}" autocomplete="tel">

  <label class="karthika-address-default" for="AddressDefault_{{ form_id }}">
    <input
      id="AddressDefault_{{ form_id }}"
      type="checkbox"
      name="address[default]"
      value="1"
      {% if address == customer.default_address %}checked{% endif %}
    >
    {{ 'customer.addresses.set_default' | t }}
  </label>
</div>
